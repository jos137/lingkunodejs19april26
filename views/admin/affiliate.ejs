<style>
    .affiliate-panel { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; padding: 28px; box-shadow: 0 4px 15px rgba(0,0,0,0.02); }
    .settings-title { font-size: 18px; font-weight: 900; color: #111827; margin-bottom: 6px; }
    .settings-desc { font-size: 13px; color: #64748b; margin-bottom: 24px; border-bottom: 1.5px solid #f8fafc; padding-bottom: 16px; }
    
    .s-group { margin-bottom: 24px; }
    .s-label { font-size: 12px; font-weight: 700; color: #374151; margin-bottom: 8px; display: block; }
    .s-input { width: 100%; padding: 12px 16px; border: 1.5px solid #e5e7eb; border-radius: 12px; font-family: inherit; font-size: 14px; color: #111827; outline: none; transition: 0.2s; }
    .s-input:focus { border-color: #10b981; box-shadow: 0 0 0 4px rgba(16,185,129,0.05); }

    .aff-card-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 32px; }
    .aff-stat-card { padding: 20px; border: 1.5px solid #f1f5f9; border-radius: 16px; transition: 0.2s; }
    .aff-stat-card:hover { border-color: #e2e8f0; background: #fbfcfd; }
    .aff-stat-label { font-size: 11px; font-weight: 800; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; }
    .aff-stat-value { font-size: 20px; font-weight: 900; color: #111827; }

    .btn-copy { padding: 12px 24px; border: none; border-radius: 12px; background: #111827; color: #fff; font-size: 13px; font-weight: 700; cursor: pointer; transition: 0.2s; display: flex; align-items: center; justify-content: center; gap: 8px; flex-shrink: 0; }
    .btn-copy:hover { background: #000; transform: translateY(-1px); }

    .aff-link-container { display: flex; gap: 12px; }

    @media (max-width: 768px) {
        .aff-card-grid { grid-template-columns: 1fr; gap: 12px; }
        .aff-link-container { flex-direction: column; }
        .btn-copy { width: 100%; padding: 14px; }
        .affiliate-panel { padding: 20px; }
        .settings-title { font-size: 16px; }
        .settings-desc { font-size: 12px; }
        .aff-stat-card { padding: 16px; }
    }
</style>

<div class="affiliate-panel">
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 12px;">
        <div style="flex: 1;">
            <div class="settings-title">Program Affiliate Lingku.xyz</div>
            <div class="settings-desc" style="border:none; margin:0; padding:0;">Ajak temanmu bergabung dan dapatkan komisi Rp 50.000 dari setiap transaksi Pro mereka!</div>
        </div>
        <div style="width: 50px; height: 50px; background: #f0fdf4; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: #10b981; font-size: 20px; flex-shrink: 0;">
            <i class="fas fa-handshake"></i>
        </div>
    </div>

    <hr style="border: none; border-top: 1.5px solid #f8fafc; margin: 24px 0;">

    <div class="s-group">
        <label class="s-label">Link Referal Kamu</label>
        <div class="aff-link-container">
            <input type="text" class="s-input" value="<%= affiliateLink %>" id="affLink" readonly style="background: #f9fafb; font-family: monospace; font-weight: 600; text-overflow: ellipsis;">
            <button class="btn-copy" onclick="copyAffLink()">
                <i class="fas fa-copy"></i> Salin Link
            </button>
        </div>
        <div style="font-size: 12px; color: #94a3b8; margin-top: 10px;">* Bagikan link ini di sosial media atau grup WA kamu.</div>
    </div>

    <hr style="border: none; border-top: 1.5px solid #f8fafc; margin: 32px 0;">

    <div class="settings-title" style="font-size: 15px;">Statistik Performa</div>
    <div class="aff-card-grid">
        <div class="aff-stat-card">
            <div class="aff-stat-label">Total Klik</div>
            <div class="aff-stat-value">1,284</div>
        </div>
        <div class="aff-stat-card">
            <div class="aff-stat-label">Member Baru</div>
            <div class="aff-stat-value">56 User</div>
        </div>
        <div class="aff-stat-card" style="background: #f0fdf4; border-color: #dcfce7;">
            <div class="aff-stat-label" style="color: #10b981;">Total Komisi</div>
            <div class="aff-stat-value" style="color: #15803d;">Rp 250.000</div>
        </div>
    </div>

    <div style="margin-top: 40px; padding: 20px; background: #fffcf0; border: 1.5px solid #fef3c7; border-radius: 16px; display: flex; gap: 16px; align-items: center;">
        <i class="fas fa-info-circle" style="color: #d97706; font-size: 20px; flex-shrink: 0;"></i>
        <div style="font-size: 12px; color: #92400e; font-weight: 600; line-height: 1.5;">
            Komisi akan dicairkan otomatis ke Saldo Utama kamu setiap tanggal 1 setiap bulannya jika akun yang kamu ajak melakukan pembayaran sukses.
        </div>
    </div>
</div>

<script>
    function copyAffLink() {
        const copyText = document.getElementById("affLink");
        copyText.select();
        copyText.setSelectionRange(0, 99999);
        navigator.clipboard.writeText(copyText.value);
        
        const btn = document.querySelector('.btn-copy');
        const originalText = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-check"></i> Tersalin!';
        btn.style.background = '#10b981';
        
        setTimeout(() => {
            btn.innerHTML = originalText;
            btn.style.background = '#111827';
        }, 2000);
    }
</script>
