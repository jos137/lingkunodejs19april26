<style>
.settings-grid { display: grid; grid-template-columns: 260px 1fr; gap: 24px; }
.settings-nav { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; padding: 12px; height: fit-content; }
.settings-nav-item { padding: 12px 16px; border-radius: 10px; font-size: 13px; font-weight: 600; color: #64748b; cursor: pointer; display: flex; align-items: center; gap: 10px; transition: 0.1s; margin-bottom: 4px; }
.settings-nav-item:hover { background: #f9fafb; color: #111827; }
.settings-nav-item.active { background: #f0fdf4; color: #10b981; font-weight: 700; }
.settings-nav-item i { width: 18px; text-align: center; }

.settings-panel { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; padding: 28px; box-shadow: 0 4px 15px rgba(0,0,0,0.02); }
.settings-title { font-size: 18px; font-weight: 900; color: #111827; margin-bottom: 6px; }
.settings-desc { font-size: 13px; color: #64748b; margin-bottom: 24px; border-bottom: 1.5px solid #f8fafc; padding-bottom: 16px; }

.s-group { margin-bottom: 20px; }
.s-label { font-size: 12px; font-weight: 700; color: #374151; margin-bottom: 8px; display: block; }
.s-input { width: 100%; padding: 12px 16px; border: 1.5px solid #e5e7eb; border-radius: 12px; font-family: inherit; font-size: 14px; color: #111827; outline: none; transition: 0.2s; }
.s-input:focus { border-color: #3b82f6; box-shadow: 0 0 0 4px rgba(59,130,246,0.05); }
.s-select { appearance: auto; background: #fff; }
.s-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.s-divider { border: none; border-top: 1px solid #f1f5f9; margin: 28px 0; }
.s-save { padding: 12px 36px; border: none; border-radius: 12px; background: linear-gradient(135deg, #10b981, #059669); color: #fff; font-size: 14px; font-weight: 800; cursor: pointer; transition: 0.2s; display: inline-flex; align-items: center; gap: 8px; }
.s-save:hover { transform: translateY(-1px); box-shadow: 0 8px 20px rgba(16,185,129,0.3); }

.s-section { display: none; }
.s-section.active { display: block; animation: slideUp 0.3s ease-out; }
@keyframes slideUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

/* Custom Checkbox */
.s-check { display: flex; align-items: center; gap: 12px; cursor: pointer; margin-bottom: 14px; }
.s-check input { width: 18px; height: 18px; cursor: pointer; }
.s-check-label { font-size: 14px; font-weight: 600; color: #374151; }

@media (max-width: 900px) { .settings-grid { grid-template-columns: 1fr; } }
</style>

<div class="settings-grid">
    <div class="settings-nav">
        <div class="settings-nav-item active" onclick="showSection('profil', this)"><i class="fas fa-user-circle"></i> Profil Akun</div>
        <div class="settings-nav-item" onclick="showSection('toko', this)"><i class="fas fa-store"></i> Tampilan Toko</div>
        <div class="settings-nav-item" onclick="showSection('pembayarann', this)"><i class="fas fa-wallet"></i> Pembayaran</div>
        <div class="settings-nav-item" onclick="showSection('notifikasi', this)"><i class="fas fa-bell"></i> Notifikasi</div>
        <div class="settings-nav-item" onclick="showSection('keamanan', this)"><i class="fas fa-shield-alt"></i> Keamanan</div>
        
        <div class="settings-nav-item" onclick="showSection('dasbor', this)" style="color:#8b5cf6;"><i class="fas fa-paint-roller"></i> Tema Dasbor</div>
        <% if (user.role === 'admin') { %>
            <div class="settings-nav-item" onclick="showSection('ipaymu', this)" style="color:#2563eb;"><i class="fas fa-credit-card"></i> iPaymu Gateway</div>
            <div class="settings-nav-item" onclick="showSection('smtp', this)" style="color:#ec4899;"><i class="fas fa-server"></i> SMTP Server</div>
            <div class="settings-nav-item" onclick="showSection('pengumuman', this)" style="color:#f43f5e;"><i class="fas fa-bullhorn"></i> Pengumuman Global</div>
        <% } %>

        <div class="settings-nav-item" onclick="showSection('affiliate', this)" style="color:#f59e0b;"><i class="fas fa-handshake"></i> Pengaturan Affiliate</div>
    </div>

    <div>
        <!-- PROFIL -->
        <div class="settings-panel s-section active" id="sec-profil">
            <div class="settings-title">Profil Akun</div>
            <div class="settings-desc">Informasi dasar akun dan identitas publik Anda.</div>
            
            <form action="/admin/settings/update-profile" method="POST" enctype="multipart/form-data">
                <div class="s-group" style="margin-bottom:32px;">
                    <label class="s-label">Foto Profil</label>
                    <div style="display:flex; align-items:center; gap:24px;">
                        <div id="photoPreview" style="width:90px;height:90px;border-radius:20px;overflow:hidden;background:#f1f5f9;display:flex;align-items:center;justify-content:center;border:2.5px solid #fff;box-shadow: 0 8px 20px rgba(0,0,0,0.06);flex-shrink:0;">
                            <% if (user.profile_photo) { %>
                                <img src="<%= user.profile_photo %>" style="width:100%;height:100%;object-fit:cover;" id="previewImg">
                            <% } else { %>
                                <span style="font-size:32px;font-weight:900;color:#94a3b8;" id="previewInitial"><%= user.name ? user.name.charAt(0).toUpperCase() : 'A' %></span>
                                <img src="" style="width:100%;height:100%;object-fit:cover;display:none;" id="previewImg">
                            <% } %>
                        </div>
                        <div>
                            <input type="file" name="profile_photo" id="photoInput" accept="image/*" style="display:none" onchange="previewPhoto(this)">
                            <button type="button" onclick="document.getElementById('photoInput').click()" style="padding:10px 22px;border:1.5px solid #e5e7eb;border-radius:12px;background:#fff;font-size:13px;font-weight:700;cursor:pointer;color:#374151;display:flex;align-items:center;gap:8px;margin-bottom:8px;transition:0.2s;">
                                <i class="fas fa-cloud-upload-alt" style="color:#10b981;"></i> Ganti Foto
                            </button>
                            <div style="font-size:11px;color:#94a3b8;">PNG, JPG atau GIF. Maksimal 2MB.</div>
                        </div>
                    </div>
                </div>

                <div class="s-row">
                    <div class="s-group">
                        <label class="s-label">Nama Lengkap</label>
                        <input class="s-input" type="text" name="name" value="<%= user.name || '' %>" placeholder="Nama Anda">
                    </div>
                    <div class="s-group">
                        <label class="s-label">Email</label>
                        <input class="s-input" type="email" value="<%= user.email || '' %>" disabled style="background:#f9fafb; cursor:not-allowed; opacity:0.8;">
                    </div>
                </div>
                <div class="s-group">
                    <label class="s-label">Bio Singkat</label>
                    <textarea class="s-input" name="bio" rows="3" placeholder="Tuliskan sedikit tentang diri Anda..."><%= user.bio || '' %></textarea>
                </div>
                <div class="s-group">
                    <label class="s-label">WhatsApp</label>
                    <input class="s-input" type="text" name="phone" value="<%= user.phone || '' %>" placeholder="e.g. 08123456789">
                </div>
                <hr class="s-divider">
                <button type="submit" class="s-save">Simpan Perubahan</button>
            </form>
        </div>

        <!-- TOKO -->
        <div class="settings-panel s-section" id="sec-toko">
            <div class="settings-title">Tampilan Toko</div>
            <div class="settings-desc">Atur warna tema dan gaya tampilan halaman landing page Anda.</div>
            <form action="/admin/settings/update-store" method="POST">
                <div class="s-row">
                    <div class="s-group">
                        <label class="s-label">Warna Utama (Button, Ikons)</label>
                        <div style="display:flex; gap:10px;">
                            <input class="s-input" type="color" name="theme_color" value="<%= user.theme_color || '#10b981' %>" style="width:60px; padding:2px; height:46px;">
                            <input class="s-input" type="text" value="<%= user.theme_color || '#10b981' %>" disabled>
                        </div>
                    </div>
                </div>

                <div class="s-divider"></div>
                <div class="settings-title" style="font-size:15px;">Header Profil</div>
                <div class="settings-desc" style="margin-bottom:20px;">Sesuaikan tampilan box profil di bagian atas halaman Anda.</div>

                <div class="s-group">
                    <div class="s-check">
                        <input type="checkbox" name="show_header" id="show_header" <%= user.show_header != 0 ? 'checked' : '' %>>
                        <label class="s-check-label" for="show_header">Tampilkan Box Profil (Header)</label>
                    </div>
                </div>

                <div class="s-row" id="header_custom_options" style="<%= user.show_header == 0 ? 'display:none;' : '' %>">
                    <div class="s-group">
                        <label class="s-label">Warna Box Profil</label>
                        <div style="display:flex; gap:10px;">
                            <input class="s-input" type="color" name="profile_box_color" value="<%= user.profile_box_color || '#ffffff' %>" style="width:60px; padding:2px; height:46px;">
                            <input class="s-input" type="text" value="<%= user.profile_box_color || '#ffffff' %>" disabled>
                        </div>
                    </div>
                    <div class="s-group">
                        <label class="s-label">Warna Teks Profil</label>
                        <div style="display:flex; gap:10px;">
                            <input class="s-input" type="color" name="profile_text_color" value="<%= user.profile_text_color || '#111827' %>" style="width:60px; padding:2px; height:46px;">
                            <input class="s-input" type="text" value="<%= user.profile_text_color || '#111827' %>" disabled>
                        </div>
                    </div>
                </div>

                <div class="s-row" id="font_custom_options" style="<%= user.show_header == 0 ? 'display:none;' : '' %>">
                    <div class="s-group">
                        <label class="s-label">Bentuk Box (Shape)</label>
                        <select class="s-input s-select" name="header_type">
                            <option value="box" <%= user.header_type === 'box' ? 'selected' : '' %>>Standard (Box)</option>
                            <option value="rounded" <%= user.header_type === 'rounded' || !user.header_type ? 'selected' : '' %>>Curvy (Rounded)</option>
                            <option value="sketch" <%= user.header_type === 'sketch' ? 'selected' : '' %>>Artist (Sketch)</option>
                        </select>
                    </div>
                    <div class="s-group">
                        <label class="s-label">Ukuran Font (Nama / Bio)</label>
                        <div style="display:flex; gap:10px; align-items:center;">
                            <input class="s-input" type="number" name="name_font_size" value="<%= user.name_font_size || 18 %>" style="width:80px;" placeholder="Nama">
                            <span style="font-weight:700; color:#cbd5e1;">/</span>
                            <input class="s-input" type="number" name="bio_font_size" value="<%= user.bio_font_size || 12 %>" style="width:80px;" placeholder="Bio">
                            <span style="font-size:11px; font-weight:700; color:#94a3b8;">PX</span>
                        </div>
                    </div>
                </div>

                <script>
                    document.getElementById('show_header').addEventListener('change', function() {
                        const display = this.checked ? 'grid' : 'none';
                        document.getElementById('header_custom_options').style.display = display;
                        document.getElementById('font_custom_options').style.display = display;
                    });
                </script>
                <hr class="s-divider">
                <button type="submit" class="s-save">Terapkan Tema</button>
            </form>
        </div>

        <!-- PEMBAYARAN -->
        <div class="settings-panel s-section" id="sec-pembayarann">
            <div class="settings-title">Rekening Pembayaran</div>
            <div class="settings-desc">Informasi rekening untuk menerima hasil penjualan (Payout).</div>
            <div class="s-group">
                <label class="s-label">Nama Bank</label>
                <select class="s-input s-select">
                    <option value="BCA">BCA</option>
                    <option value="BNI">BNI</option>
                    <option value="Mandiri">Mandiri</option>
                    <option value="BRI">BRI</option>
                    <option value="Other">Lainnya...</option>
                </select>
            </div>
            <div class="s-row">
                <div class="s-group">
                    <label class="s-label">Nomor Rekening</label>
                    <input class="s-input" type="text" placeholder="e.g. 1234567890">
                </div>
                <div class="s-group">
                    <label class="s-label">Nama Pemilik Rekening</label>
                    <input class="s-input" type="text" placeholder="Sesuai buku tabungan">
                </div>
            </div>
            <hr class="s-divider">
            <button class="s-save" onclick="alert('Berhasil menyimpan data rekening!')">Simpan Rekening</button>
        </div>

        <!-- NOTIFIKASI -->
        <div class="settings-panel s-section" id="sec-notifikasi">
            <div class="settings-title">Preferensi Notifikasi</div>
            <div class="settings-desc">Atur bagaimana Anda ingin menerima pemberitahuan dari sistem.</div>
            <div class="s-check"><input type="checkbox" id="n_wa" checked><label class="s-check-label" for="n_wa">Notifikasi Order via WhatsApp</label></div>
            <div class="s-check"><input type="checkbox" id="n_email" checked><label class="s-check-label" for="n_email">Notifikasi Order via Email</label></div>
            <div class="s-check"><input type="checkbox" id="n_wd"><label class="s-check-label" for="n_wd">Kabari saya jika pencairan dana berhasil</label></div>
            <hr class="s-divider">
            <button class="s-save" onclick="alert('Preferensi notifikasi disimpan!')">Simpan Preferensi</button>
        </div>

        <!-- KEAMANAN -->
        <div class="settings-panel s-section" id="sec-keamanan">
            <div class="settings-title">Keamanan Akun</div>
            <div class="settings-desc">Ganti password Anda secara berkala untuk menjaga keamanan akun.</div>
            <div class="s-group"><label class="s-label">Password Lama</label><input class="s-input" type="password" placeholder="••••••••"></div>
            <div class="s-row">
                <div class="s-group"><label class="s-label">Password Baru</label><input class="s-input" type="password" placeholder="Min 8 karakter"></div>
                <div class="s-group"><label class="s-label">Konfirmasi Password Baru</label><input class="s-input" type="password" placeholder="Ulangi password baru"></div>
            </div>
            <hr class="s-divider">
            <button class="s-save">Ubah Password</button>
        </div>
        
        <% if (user.role === 'admin') { %>
        <!-- IPAYMU -->
        <div class="settings-panel s-section" id="sec-ipaymu">
            <div class="settings-title">Integrasi Pembayaran iPaymu</div>
            <div class="settings-desc">Pilih mode gateway pembayaran yang aktif untuk seluruh transaksi Anda.</div>
            
            <% if (locals.success && locals.tab === 'ipaymu') { %>
                <div style="padding:14px; background:#eff6ff; border:1px solid #3b82f6; border-radius:12px; color:#1e40af; font-size:13px; font-weight:700; margin-bottom:24px; display:flex; align-items:center; gap:10px;">
                    <i class="fas fa-check-circle"></i> Mode iPaymu berhasil diperbarui
                </div>
            <% } %>

            <form action="/admin/settings/update-ipaymu" method="POST">
                <div class="s-group" style="display: flex; align-items: center; justify-content: space-between; gap: 20px;">
                    <label class="s-label" style="margin: 0;">Gateway Mode</label>
                    <select class="s-input s-select" name="ipaymu_sandbox" style="max-width:350px;">
                        <option value="1" <%= user.ipaymu_sandbox == 1 ? 'selected' : '' %>>Sandbox (Mode Testing)</option>
                        <option value="0" <%= user.ipaymu_sandbox == 0 ? 'selected' : '' %>>Live (Mode Produksi)</option>
                    </select>
                </div>

                <div class="s-group" style="display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 15px;">
                    <label class="s-label" style="margin: 0;">Batas Waktu Pembayaran</label>
                    <div style="display:flex; align-items:center; gap:10px; flex:1; max-width:350px;">
                        <input class="s-input" type="number" name="ipaymu_expiry" value="<%= user.ipaymu_expiry || 60 %>" placeholder="60" style="width: 80px;">
                        <span style="font-size:12px; font-weight:700; color:#94a3b8;">MENIT</span>
                    </div>
                </div>

                <div style="margin: 30px 0; background: #f0f7ff; border-left: 4px solid #3b82f6; padding: 20px; border-radius: 4px 12px 12px 4px;">
                    <div style="font-size: 11px; font-weight: 900; color: #64748b; text-transform: uppercase; margin-bottom: 12px; letter-spacing: 0.5px;">DATA AKTIF (DIAMBIL DARI DB / ENV):</div>
                    <div style="font-family: 'Monaco', 'Menlo', monospace; font-size: 13px; line-height: 1.8; color: #1e293b;">
                        <% 
                            let activeVa = user.ipaymu_sandbox == 1 ? '0000001316083605' : '1179001316083605';
                            let activeKey = user.ipaymu_sandbox == 1 ? 'SANDBOX2AAD372E-B1FE-4DB1-B006-0C7F7C7B8552' : '5452ECBF-72B0-4A6D-9C40-F86678F2FA6D';
                            let activeUrl = user.ipaymu_sandbox == 1 ? 'https://sandbox.ipaymu.com/api/v2/payment/direct' : 'https://my.ipaymu.com/api/v2/payment/direct';
                        %>
                        <strong>VA Number:</strong> <%= activeVa %><br>
                        <strong>API Key:</strong> <%= activeKey.substring(0, 10) %>********************<br>
                        <strong>Endpoint:</strong> <%= activeUrl %>
                    </div>
                </div>

                <div style="font-size: 12px; color: #94a3b8; font-style: italic; margin-bottom: 30px;">
                    * Pengaturan VA & API Key dilakukan manual via Database (phpMyAdmin) agar lebih aman.
                </div>

                <hr class="s-divider">
                <button type="submit" class="s-save" style="background:linear-gradient(135deg, #1e293b, #0f172a);">Perbarui Mode Gateway</button>
            </form>
        </div>
        <% } %>


        <% if (user.role === 'admin') { %>
        <!-- PENGUMUMAN GLOBAL -->
        <div class="settings-panel s-section" id="sec-pengumuman">
            <div class="settings-title">Pengumuman Global</div>
            <div class="settings-desc">Atur teks dan warna spanduk pengumuman yang muncul di bagian atas dashboard untuk semua pengguna.</div>
            
            <% if (locals.success && locals.success.includes('Pengumuman')) { %>
                <div style="padding:14px; background:#f0fdf4; border:1px solid #10b981; border-radius:12px; color:#065f46; font-size:13px; font-weight:700; margin-bottom:24px; display:flex; align-items:center; gap:10px;">
                    <i class="fas fa-check-circle"></i> Berhasil memperbarui pengumuman
                </div>
            <% } %>

            <form action="/admin/settings/update-announcement" method="POST">
                <div class="s-group">
                    <label class="s-label">Teks Pengumuman</label>
                    <textarea class="s-input" name="text_value" rows="3" placeholder="Tulis pengumuman di sini..."><%= locals.announcementData ? announcementData.text : '' %></textarea>
                </div>
                <div class="s-group">
                    <label class="s-label">Warna Spanduk</label>
                    <select class="s-input s-select" name="color_value" style="font-weight:bold;">
                        <option value="blue" <%= (locals.announcementData && announcementData.color === 'blue') ? 'selected' : '' %>>🔵 Biru (Informasi)</option>
                        <option value="red" <%= (locals.announcementData && announcementData.color === 'red') ? 'selected' : '' %>>🔴 Merah (Peringatan/Penting)</option>
                        <option value="yellow" <%= (locals.announcementData && announcementData.color === 'yellow') ? 'selected' : '' %>>🟡 Kuning (Perhatian/Promo)</option>
                        <option value="green" <%= (locals.announcementData && announcementData.color === 'green') ? 'selected' : '' %>>🟢 Hijau (Sukses/Berita Baik)</option>
                    </select>
                </div>
                <div style="font-size: 12px; color: #94a3b8; font-style: italic; margin-bottom: 30px;">
                    * Pastikan fitur "enable_announcement" dalam posisi ON di menu Kontrol Fitur agar spanduk ini terlihat.
                </div>
                <hr class="s-divider">
                <button type="submit" class="s-save" style="background:linear-gradient(135deg, #f43f5e, #e11d48);">Simpan Pengumuman</button>
            </form>
        </div>
        <% } %>

        <!-- TEMA DASBOR -->
        <div class="settings-panel s-section" id="sec-dasbor">
            <div class="settings-title">Tema Dasbor</div>
            <div class="settings-desc">Ubah gaya tampilan dan warna menu sidebar.</div>
            
            <% if (locals.success && locals.success.includes('Tema Dasbor')) { %>
                <div style="padding:14px; background:#f0fdf4; border:1px solid #10b981; border-radius:12px; color:#065f46; font-size:13px; font-weight:700; margin-bottom:24px; display:flex; align-items:center; gap:10px;">
                    <i class="fas fa-check-circle"></i> Berhasil memperbarui tema dasbor
                </div>
            <% } %>

            <form action="/admin/settings/update-admin-theme" method="POST">
                <div class="s-group">
                    <label class="s-label">Pilih Tema Sidebar</label>
                    <div style="display:grid; gap:12px; margin-top:10px;">
                        <label style="display:flex; align-items:center; gap:12px; padding:16px; border:1.5px solid <%= (!user.sidebar_theme || user.sidebar_theme === 'default') ? '#3b82f6' : '#e2e8f0' %>; border-radius:12px; cursor:pointer; background:<%= (!user.sidebar_theme || user.sidebar_theme === 'default') ? '#eff6ff' : '#fff' %>; transition:0.2s;">
                            <input type="radio" name="sidebar_theme" value="default" <%= (!user.sidebar_theme || user.sidebar_theme === 'default') ? 'checked' : '' %>>
                            <div>
                                <div style="font-weight:700; color:#0f172a; margin-bottom:4px;">Klasik (Biru Dongker)</div>
                                <div style="font-size:12px; color:#64748b;">Tema bawaan Lingku dengan nuansa profesional biru gelap.</div>
                            </div>
                        </label>

                        <label style="display:flex; align-items:center; gap:12px; padding:16px; border:1.5px solid <%= user.sidebar_theme === 'dark_green' ? '#10b981' : '#e2e8f0' %>; border-radius:12px; cursor:pointer; background:<%= user.sidebar_theme === 'dark_green' ? '#f0fdf4' : '#fff' %>; transition:0.2s;">
                            <input type="radio" name="sidebar_theme" value="dark_green" <%= user.sidebar_theme === 'dark_green' ? 'checked' : '' %>>
                            <div>
                                <div style="font-weight:700; color:#0f172a; margin-bottom:4px;">Modern Gelap (Neon Green)</div>
                                <div style="font-size:12px; color:#64748b;">Background hitam pekat dengan sorotan ikon hijau neon yang futuristik.</div>
                            </div>
                        </label>

                        <label style="display:flex; align-items:center; gap:12px; padding:16px; border:1.5px solid <%= user.sidebar_theme === 'light_glass' ? '#8b5cf6' : '#e2e8f0' %>; border-radius:12px; cursor:pointer; background:<%= user.sidebar_theme === 'light_glass' ? '#f5f3ff' : '#fff' %>; transition:0.2s;">
                            <input type="radio" name="sidebar_theme" value="light_glass" <%= user.sidebar_theme === 'light_glass' ? 'checked' : '' %>>
                            <div>
                                <div style="font-weight:700; color:#0f172a; margin-bottom:4px;">Kaca Terang (Light Glass)</div>
                                <div style="font-size:12px; color:#64748b;">Tampilan putih bersih ala macOS/iOS dengan efek bayangan lembut.</div>
                            </div>
                        </label>
                    </div>
                </div>
                <hr class="s-divider">
                <button type="submit" class="s-save" style="background:linear-gradient(135deg, #8b5cf6, #6d28d9);">Simpan Tema</button>
            </form>
        </div>

        <% if (user.role === 'admin') { %>
        <!-- SMTP -->
        <div class="settings-panel s-section" id="sec-smtp">
            <div class="settings-title">Konfigurasi SMTP Server</div>
            <div class="settings-desc">Gunakan server SMTP khusus untuk pengiriman email transaksi Anda.</div>
            
            <% if (locals.success && locals.tab === 'smtp') { %>
                <div style="padding:14px; background:#f0fdf4; border:1px solid #10b981; border-radius:12px; color:#065f46; font-size:13px; font-weight:700; margin-bottom:24px; display:flex; align-items:center; gap:10px;">
                    <i class="fas fa-check-circle"></i> Berhasil menyimpan pengaturan SMTP
                </div>
            <% } %>

            <form action="/admin/settings/update-smtp" method="POST">
                <div class="s-group">
                    <label class="s-label">SMTP Host</label>
                    <input class="s-input" type="text" name="smtp_host" value="<%= locals.smtp ? (smtp.smtp_host || '') : '' %>" placeholder="e.g. smtp.gmail.com">
                </div>
                <div class="s-row">
                    <div class="s-group">
                        <label class="s-label">SMTP Port</label>
                        <input class="s-input" type="number" name="smtp_port" value="<%= locals.smtp ? (smtp.smtp_port || '') : '' %>" placeholder="e.g. 587">
                    </div>
                    <div class="s-group">
                        <label class="s-label">SMTP User</label>
                        <input class="s-input" type="text" name="smtp_user" value="<%= locals.smtp ? (smtp.smtp_user || '') : '' %>" placeholder="Email / Username">
                    </div>
                </div>
                <div class="s-group">
                    <label class="s-label">SMTP Password</label>
                    <input class="s-input" type="password" name="smtp_pass" value="<%= locals.smtp ? (smtp.smtp_pass || '') : '' %>" placeholder="Password aplikasi / SMTP">
                </div>
                <hr class="s-divider">
                <button type="submit" class="s-save" style="background:linear-gradient(135deg, #ec4899, #db2777);">Simpan SMTP</button>
            </form>
        </div>
        <% } %>


        <!-- AFFILIATE -->
        <div class="settings-panel s-section" id="sec-affiliate">
            <div class="settings-title">Pengaturan Program Affiliate</div>
            <div class="settings-desc">Atur skema komisi dan durasi pelacakan kuki (cookie) affiliate Anda.</div>
            
            <% if (locals.success && locals.tab === 'affiliate') { %>
                <div style="padding:14px; background:#fff7ed; border:1px solid #f59e0b; border-radius:12px; color:#9a3412; font-size:13px; font-weight:700; margin-bottom:24px; display:flex; align-items:center; gap:10px;">
                    <i class="fas fa-check-circle"></i> Berhasil menyimpan pengaturan Affiliate
                </div>
            <% } %>

            <form action="/admin/settings/update-affiliate" method="POST">
                <div class="s-group">
                    <label class="s-label">Persentase Komisi Affiliate</label>
                    <div style="display:flex; align-items:center; gap:10px;">
                        <input class="s-input" type="number" name="aff_commission_percent" value="<%= locals.affiliate ? (affiliate.aff_commission_percent || '20') : '20' %>" placeholder="20" style="width: 100px;">
                        <span style="font-size:14px; font-weight:700; color:#94a3b8;">% DARI TOTAL PENJUALAN</span>
                    </div>
                </div>
                <div class="s-group">
                    <label class="s-label">Durasi Cookie (Tracking)</label>
                    <div style="display:flex; align-items:center; gap:10px;">
                        <input class="s-input" type="number" name="aff_cookie_duration" value="<%= locals.affiliate ? (affiliate.aff_cookie_duration || '30') : '30' %>" placeholder="30" style="width: 100px;">
                        <span style="font-size:14px; font-weight:700; color:#94a3b8;">HARI</span>
                    </div>
                    <div style="font-size:11px; color:#94a3b8; margin-top:8px;">* Selama cookie aktif, pembeli yang mendaftar akan otomatis menjadi referal dari affiliate terkait.</div>
                </div>
                <hr class="s-divider">
                <button type="submit" class="s-save" style="background:linear-gradient(135deg, #f59e0b, #d97706);">Simpan Pengaturan Affiliate</button>
            </form>
        </div>
    </div>
</div>

<script>
function showSection(id, el) {
    document.querySelectorAll('.s-section').forEach(s => s.classList.remove('active'));
    document.querySelectorAll('.settings-nav-item').forEach(n => n.classList.remove('active'));
    const target = document.getElementById('sec-' + id);
    if (target) {
        target.classList.add('active');
        if (el) el.classList.add('active');
    }
}

function previewPhoto(input) {
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
            const previewImg = document.getElementById('previewImg');
            const previewInitial = document.getElementById('previewInitial');
            if (previewImg) {
                previewImg.src = e.target.result;
                previewImg.style.display = 'block';
                if (previewInitial) previewInitial.style.display = 'none';
            }
        }
        reader.readAsDataURL(input.files[0]);
    }
}

window.onload = function() {
    const urlParams = new URLSearchParams(window.location.search);
    const tab = urlParams.get('tab');
    if (tab) {
        const navItem = document.querySelector(`[onclick*="'${tab}'"]`);
        if (navItem) showSection(tab, navItem);
    }
    
    // Auto active tab check for success messages
    if (urlParams.get('success')) {
        const activeTab = urlParams.get('tab') || 'profil';
        const navItem = document.querySelector(`[onclick*="'${activeTab}'"]`);
        if (navItem) showSection(activeTab, navItem);
    }
};
</script>
