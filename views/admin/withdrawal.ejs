<style>
/* Modern Minimalist & Premium UI for Tarik Dana */
.wd-top-card {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    gap: 16px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 24px;
    margin-bottom: 24px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px -1px rgba(0, 0, 0, 0.01);
}

.metric-card {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
}

@media (min-width: 1025px) {
    .wd-top-card > div:not(:last-child) {
        border-right: 1px solid #f1f5f9;
        padding-right: 16px;
    }
}

.metric-icon-box {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
}

.metric-icon-box.balance { background: #e6f7ed; color: #10b981; }
.metric-icon-box.affiliate { background: #f3e8ff; color: #8b5cf6; }
.metric-icon-box.cair { background: #e6f7ed; color: #10b981; }
.metric-icon-box.pending { background: #fff7ed; color: #f97316; }
.metric-icon-box.ditolak { background: #fef2f2; color: #ef4444; }

.metric-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
}

.wd-metric-label {
    font-size: 11px;
    font-weight: 700;
    color: #64748b;
}

.wd-metric-value {
    font-size: 18px;
    font-weight: 600;
    color: #0f172a;
    letter-spacing: -0.5px;
    margin-top: 2px;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
}

.wd-metric-value.large {
    font-size: clamp(18px, 1.8vw, 24px);
    font-weight: 700;
    letter-spacing: -0.8px;
    white-space: nowrap;
}

.text-green { color: #10b981 !important; }
.text-orange { color: #f97316 !important; }
.text-red { color: #ef4444 !important; }

.badge-plan {
    font-size: 8.5px;
    font-weight: 850;
    padding: 1px 6px;
    border-radius: 100px;
    letter-spacing: 0.3px;
}
.badge-plan.pro { background: #d1fae5; color: #065f46; }
.badge-plan.free { background: #eff6ff; color: #1d4ed8; }

.metric-status-text {
    font-size: 10px;
    color: #64748b;
    margin-top: 4px;
    display: flex;
    align-items: center;
    gap: 4px;
    font-weight: 600;
}
.metric-status-text.plain {
    color: #94a3b8;
}

.status-dot {
    width: 6px;
    height: 6px;
    background: #10b981;
    border-radius: 50%;
    display: inline-block;
}

@media (max-width: 1024px) {
    .wd-top-card {
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }
    .wd-top-card > div:first-child {
        grid-column: span 2;
        border-bottom: 1px solid #f1f5f9;
        padding-bottom: 16px;
    }
}

@media (max-width: 640px) {
    .wd-top-card {
        grid-template-columns: 1fr;
        gap: 0;
    }
    .wd-top-card > div:first-child {
        grid-column: span 1;
    }
    .wd-top-card > div:not(:last-child) {
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 16px;
        margin-bottom: 16px;
    }
}

/* Content Grid */
.wd-content {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 24px;
    align-items: start;
}

.wd-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 28px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px -1px rgba(0, 0, 0, 0.01);
}

.card-header-sleek {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
}
.header-icon-box {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: #e6f7ed;
    color: #10b981;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
}
.header-title {
    font-size: 14px;
    font-weight: 800;
    color: #1e293b;
    margin: 0;
}
.header-subtitle {
    font-size: 11px;
    color: #64748b;
    margin: 2px 0 0;
    font-weight: 500;
}

.wd-input-group {
    margin-bottom: 18px;
}

.wd-label {
    font-size: 11px;
    font-weight: 700;
    color: #475569;
    margin-bottom: 8px;
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.wd-input {
    width: 100%;
    padding: 12px 14px;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    font-family: inherit;
    font-size: 14px;
    color: #1e293b;
    outline: none;
    background: #fff;
    transition: all 0.2s ease;
}

.wd-input::placeholder {
    color: #94a3b8;
}

.wd-input:focus {
    border-color: #10b981;
    box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.08);
}

.wd-select {
    appearance: none;
    background: #fff url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e") no-repeat right 12px center/18px;
    padding-right: 40px;
}

/* Breakdown list */
.breakdown-list {
    background: #f8fafc;
    border-radius: 12px;
    padding: 6px 14px;
    margin-bottom: 20px;
    border: 1px solid #f1f5f9;
}
.breakdown-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
}
.breakdown-row:not(:last-child) {
    border-bottom: 1px solid #f1f5f9;
}
.row-left {
    display: flex;
    align-items: center;
    gap: 10px;
}
.row-icon-box {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #e6f7ed;
    color: #10b981;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
}
.row-text {
    font-size: 12px;
    font-weight: 700;
    color: #64748b;
}
.row-val {
    font-size: 13px;
    font-weight: 800;
}
.row-val.red { color: #ef4444; }
.row-val.green { color: #10b981; }

/* PRO Promo Card */
.pro-promo-card {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fff7ed;
    border: 1px solid #ffedd5;
    border-radius: 12px;
    padding: 14px;
    margin-bottom: 20px;
    text-decoration: none;
    transition: background 0.15s;
}
.pro-promo-card:hover {
    background: #ffedd5;
}
.promo-icon-box {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #f97316;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    flex-shrink: 0;
}
.promo-info {
    flex: 1;
}
.promo-title {
    font-size: 11.5px;
    font-weight: 800;
    color: #c2410c;
}
.promo-subtitle {
    font-size: 10px;
    color: #9a3412;
    margin-top: 2px;
    font-weight: 600;
}
.promo-arrow {
    margin-left: auto;
    font-size: 12px;
    color: #ea580c;
}

.wd-submit {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 10px;
    background: #10b981;
    color: #fff;
    font-size: 13.5px;
    font-weight: 800;
    cursor: pointer;
    transition: background 0.15s;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

.wd-submit:hover {
    background: #059669;
}

/* History Card */
.btn-lihat-semua {
    font-size: 11px;
    font-weight: 800;
    color: #6366f1;
    text-decoration: none;
    border: 1.5px solid #e2e8f0;
    padding: 6px 12px;
    border-radius: 8px;
    transition: all 0.15s;
    display: flex;
    align-items: center;
    gap: 4px;
}
.btn-lihat-semua:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
}

.wd-table-container {
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 0 16px;
    background: #fff;
}

.wd-table {
    width: 100%;
    border-collapse: collapse;
}

.wd-table th {
    text-align: left;
    font-size: 10px;
    font-weight: 700;
    color: #64748b;
    padding: 14px 4px;
    border-bottom: 1.5px solid #f1f5f9;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}

.wd-table td {
    font-size: 13px;
    color: #334155;
    padding: 16px 4px;
    border-bottom: 1px solid #f1f5f9;
    font-weight: 600;
}

.wd-table td .date-cell {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #334155;
}
.wd-table td .date-cell i {
    color: #94a3b8;
    font-size: 14px;
}

.wd-table .badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: 100px;
    font-size: 9px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.wd-table .badge.completed {
    background: #d1fae5;
    color: #065f46;
}

.wd-table .badge.pending {
    background: #fef3c7;
    color: #92400e;
}

.wd-table .badge.rejected {
    background: #fee2e2;
    color: #991b1b;
}

/* Pagination Footer */
.table-footer-pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 20px;
    padding: 0 4px;
}
.footer-data-info {
    font-size: 11px;
    font-weight: 750;
    color: #94a3b8;
}
.pagination-controls {
    display: flex;
    gap: 6px;
}
.pag-btn {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    border: 1px solid #e2e8f0;
    background: #fff;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.15s;
}
.pag-btn:hover:not(:disabled) {
    background: #f8fafc;
    border-color: #cbd5e1;
}
.pag-btn.active {
    background: #fff;
    color: #10b981;
    border-color: #10b981;
}
.pag-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.wd-empty {
    text-align: center;
    padding: 48px;
    color: #94a3b8;
    font-size: 13px;
    font-weight: 600;
}

@media (max-width: 768px) {
    .wd-content {
        grid-template-columns: 1fr;
    }
}

/* Success Modal */
.wd-modal-overlay {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(15, 23, 42, 0.3); backdrop-filter: blur(8px);
    display: flex; align-items: center; justify-content: center;
    z-index: 9999; opacity: 0; pointer-events: none; transition: all 0.3s ease;
}
.wd-modal-overlay.active { opacity: 1; pointer-events: auto; }
.wd-modal {
    background: #fff; width: 90%; max-width: 400px;
    border-radius: 20px; padding: 36px 24px; text-align: center;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05);
    transform: translateY(15px) scale(0.97); transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid #e2e8f0;
}
.wd-modal-overlay.active .wd-modal { transform: translateY(0) scale(1); }
.wd-modal-icon {
    width: 64px; height: 64px; background: #dcfce7; color: #10b981;
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-size: 28px; margin: 0 auto 20px;
}
.wd-modal-title { font-size: 20px; font-weight: 800; color: #0f172a; margin-bottom: 8px; letter-spacing: -0.5px; }
.wd-modal-amount { font-size: 28px; font-weight: 900; color: #10b981; margin-bottom: 12px; letter-spacing: -0.8px; }
.wd-modal-desc { font-size: 13.5px; color: #64748b; line-height: 1.6; margin-bottom: 24px; }
.wd-modal-btn {
    background: #0f172a; color: #fff; border: none; width: 100%;
    padding: 14px; border-radius: 10px; font-size: 13.5px; font-weight: 700;
    cursor: pointer; transition: all 0.2s ease;
    text-transform: uppercase; letter-spacing: 0.5px;
}
.wd-modal-btn:hover { background: #1e293b; }
</style>

<%
const fmt = (n) => 'Rp\u00A0' + (parseFloat(n || 0)).toLocaleString('id-ID');
const bal = parseFloat(balance || 0);
const totalCair = withdrawals.filter(w => w.status === 'completed').reduce((s, w) => s + parseFloat(w.amount || 0), 0);
const totalPending = withdrawals.filter(w => w.status === 'pending').reduce((s, w) => s + parseFloat(w.amount || 0), 0);
const totalDitolak = withdrawals.filter(w => w.status === 'rejected').reduce((s, w) => s + parseFloat(w.amount || 0), 0);

const isPro = (user.plan || 'free') === 'pro';
const feePct = isPro ? 2 : 3;
const minAmount = isPro ? 0 : 100000;
%>

<!-- Metric Row with Left Alignment & Icon Boxes -->
<div class="wd-top-card">
    <!-- Saldo Tersedia -->
    <div class="metric-card">
        <div class="metric-icon-box balance">
            <i class="fas fa-wallet"></i>
        </div>
        <div class="metric-info">
            <div style="display:flex; align-items:center; gap: 6px;">
                <span class="wd-metric-label">Saldo Tersedia</span>
                <% if(isPro) { %>
                    <span class="badge-plan pro"><i class="fas fa-crown" style="font-size:7px;"></i> PRO</span>
                <% } else { %>
                    <span class="badge-plan free">FREE</span>
                <% } %>
            </div>
            <div class="wd-metric-value large" title="<%= fmt(bal) %>"><%= fmt(bal) %></div>
            <div class="metric-status-text">
                <span class="status-dot"></span> Dana siap ditarik
            </div>
        </div>
    </div>
    
    <!-- Telah Cair -->
    <div class="metric-card">
        <div class="metric-icon-box cair">
            <i class="fas fa-arrow-trend-up"></i>
        </div>
        <div class="metric-info">
            <span class="wd-metric-label">Telah Cair</span>
            <div class="wd-metric-value text-green" title="<%= fmt(totalCair) %>"><%= fmt(totalCair) %></div>
            <div class="metric-status-text plain">Dana sukses dicairkan</div>
        </div>
    </div>

    <!-- Pending -->
    <div class="metric-card">
        <div class="metric-icon-box pending">
            <i class="fas fa-clock"></i>
        </div>
        <div class="metric-info">
            <span class="wd-metric-label">Pending</span>
            <div class="wd-metric-value text-orange" title="<%= fmt(totalPending) %>"><%= fmt(totalPending) %></div>
            <div class="metric-status-text plain">Pencairan diproses</div>
        </div>
    </div>

    <!-- Ditolak -->
    <div class="metric-card">
        <div class="metric-icon-box ditolak">
            <i class="fas fa-circle-xmark"></i>
        </div>
        <div class="metric-info">
            <span class="wd-metric-label">Ditolak</span>
            <div class="wd-metric-value text-red" title="<%= fmt(totalDitolak) %>"><%= fmt(totalDitolak) %></div>
            <div class="metric-status-text plain">Pengajuan ditolak</div>
        </div>
    </div>
</div>

<div class="wd-content">
    <!-- Form Tarik Dana -->
    <div class="wd-card">
        <div class="card-header-sleek">
            <div class="header-icon-box">
                <i class="fas fa-wallet"></i>
            </div>
            <div>
                <h3 class="header-title">Form Penarikan</h3>
                <p class="header-subtitle">Ajukan penarikan dana Anda</p>
            </div>
        </div>
        
        <form action="/admin/withdrawal/request" method="POST" id="wdForm">
            <div class="wd-input-group">
                <label class="wd-label">Jumlah Penarikan (Rp)</label>
                <div style="position: relative; display: flex; align-items: center;">
                    <input type="number" name="amount" class="wd-input" id="wdAmount" value="0" min="<%= minAmount %>" oninput="calcFee()" style="padding-right: 40px;" required>
                    <span style="position: absolute; right: 14px; font-size: 12px; font-weight: 800; color: #94a3b8; pointer-events: none;">Rp</span>
                </div>
            </div>
            
            <!-- Sleek Calculation Breakdown List -->
            <div class="breakdown-list">
                <div class="breakdown-row">
                    <div class="row-left">
                        <div class="row-icon-box">
                            <i class="fas fa-percent"></i>
                        </div>
                        <span class="row-text">Biaya Admin (<%= feePct %>%)</span>
                    </div>
                    <span class="row-val red" id="feeDisplay">- Rp 0</span>
                </div>
                
                <div class="breakdown-row">
                    <div class="row-left">
                        <div class="row-icon-box">
                            <i class="fas fa-calculator"></i>
                        </div>
                        <span class="row-text">Estimasi Diterima</span>
                    </div>
                    <span class="row-val green" id="estDisplay">Rp 0</span>
                </div>
            </div>
            
            <% if(!isPro) { %>
                <a href="/admin/upgrade" class="pro-promo-card">
                    <div class="promo-icon-box">
                        <i class="fas fa-crown"></i>
                    </div>
                    <div class="promo-info">
                        <div class="promo-title">Upgrade ke PRO untuk fee hanya 2%</div>
                        <div class="promo-subtitle">Tarik dana bebas tanpa minimal dan biaya lebih rendah.</div>
                    </div>
                    <i class="fas fa-chevron-right promo-arrow"></i>
                </a>
            <% } %>

            <div class="wd-input-group" style="margin-top:16px;">
                <label class="wd-label">Metode Pembayaran</label>
                <div style="position: relative; display: flex; align-items: center;">
                    <i class="fas fa-building-columns" style="position: absolute; left: 14px; color: #94a3b8; font-size: 14px;"></i>
                    <select name="bank_name" class="wd-input wd-select" style="padding-left: 38px;">
                        <option>BCA</option><option>BNI</option><option>BRI</option><option>Mandiri</option>
                        <option>DANA</option><option>OVO</option><option>GoPay</option><option>ShopeePay</option>
                    </select>
                </div>
            </div>
            <div class="wd-input-group">
                <label class="wd-label">Nama Pemilik Rekening</label>
                <div style="position: relative; display: flex; align-items: center;">
                    <i class="far fa-user" style="position: absolute; left: 14px; color: #94a3b8; font-size: 14px;"></i>
                    <input type="text" name="account_name" class="wd-input" placeholder="Nama sesuai rekening" required style="padding-left: 38px;">
                </div>
            </div>
            <div class="wd-input-group">
                <label class="wd-label">Nomor Rekening / No HP</label>
                <div style="position: relative; display: flex; align-items: center;">
                    <i class="fas fa-barcode" style="position: absolute; left: 14px; color: #94a3b8; font-size: 14px;"></i>
                    <input type="text" name="account_number" class="wd-input" placeholder="Nomor rekening atau nomor e-wallet" required style="padding-left: 38px;">
                </div>
            </div>
            
            <button type="submit" class="wd-submit" style="margin-top: 8px;">
                <i class="fas fa-paper-plane"></i> Ajukan Penarikan
            </button>
        </form>
    </div>

    <!-- Riwayat Penarikan -->
    <div>
        <div class="wd-card">
            <div class="card-header-sleek" style="justify-content: space-between; margin-bottom: 24px;">
                <div style="display: flex; align-items: center; gap: 14px;">
                    <div class="header-icon-box" style="background: #e6f7ed; color: #10b981;">
                        <i class="fas fa-history"></i>
                    </div>
                    <div>
                        <h3 class="header-title">Riwayat Penarikan</h3>
                        <p class="header-subtitle">Riwayat semua pengajuan dan status penarikan</p>
                    </div>
                </div>
                <a href="/admin/withdrawal" class="btn-lihat-semua">
                    Lihat semua <i class="fas fa-arrow-up-right-from-square" style="font-size: 9px; margin-left: 2px;"></i>
                </a>
            </div>

            <% if (withdrawals.length > 0) { %>
                <div class="wd-table-container">
                    <table class="wd-table">
                        <thead>
                            <tr>
                                <th>Tanggal</th>
                                <th>Nominal</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                        <% withdrawals.slice(0, 5).forEach(w => { %>
                            <tr>
                                <td>
                                    <div class="date-cell">
                                        <i class="far fa-calendar"></i>
                                        <%= w.created_at ? new Date(w.created_at).toLocaleDateString('id-ID', {day:'numeric',month:'short',year:'numeric'}) : '-' %>
                                    </div>
                                </td>
                                <td><strong><%= fmt(w.amount) %></strong></td>
                                <td>
                                    <% if (w.status === 'completed') { %>
                                        <span class="badge completed"><i class="far fa-check-circle"></i> COMPLETED</span>
                                    <% } else if (w.status === 'pending') { %>
                                        <span class="badge pending"><i class="far fa-clock"></i> PENDING</span>
                                    <% } else { %>
                                        <span class="badge rejected"><i class="far fa-times-circle"></i> REJECTED</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                        </tbody>
                    </table>
                </div>

                <div class="table-footer-pagination">
                    <span class="footer-data-info">Menampilkan <%= Math.min(5, withdrawals.length) %> dari <%= withdrawals.length %> data</span>
                    <div class="pagination-controls">
                        <button class="pag-btn" disabled><i class="fas fa-chevron-left"></i></button>
                        <button class="pag-btn active">1</button>
                        <button class="pag-btn" disabled><i class="fas fa-chevron-right"></i></button>
                    </div>
                </div>
            <% } else { %>
                <div class="wd-empty">Belum ada riwayat penarikan.</div>
            <% } %>
        </div>
    </div>
</div>

<!-- Success Modal HTML -->
<div class="wd-modal-overlay" id="successModal">
    <div class="wd-modal">
        <div class="wd-modal-icon">
            <i class="fas fa-check"></i>
        </div>
        <div class="wd-modal-title">Penarikan Berhasil!</div>
        <div class="wd-modal-amount" id="modalAmount">Rp 0</div>
        <div class="wd-modal-desc">
            Permintaan penarikan dana Anda telah kami terima dan akan segera diproses dalam waktu maksimal <strong>1x24 jam</strong>.
        </div>
        <button class="wd-modal-btn" onclick="closeModal()">Selesai & Tutup</button>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
<script>
function calcFee() {
    const amount = parseInt(document.getElementById('wdAmount').value) || 0;
    const isPro = <%= isPro %>;
    const feePct = isPro ? 0.02 : 0.03;
    const fee = Math.round(amount * feePct);
    const est = amount - fee;
    document.getElementById('feeDisplay').textContent = '- Rp ' + fee.toLocaleString('id-ID');
    document.getElementById('estDisplay').textContent = 'Rp ' + est.toLocaleString('id-ID');
}

function closeModal() {
    document.getElementById('successModal').classList.remove('active');
    const url = new URL(window.location);
    url.searchParams.delete('success');
    url.searchParams.delete('amount');
    window.history.replaceState({}, document.title, url);
}

document.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('success') === 'true') {
        const amount = urlParams.get('amount') || 0;
        document.getElementById('modalAmount').textContent = 'Rp ' + parseFloat(amount).toLocaleString('id-ID');
        
        setTimeout(() => {
            confetti({
                particleCount: 120,
                spread: 60,
                origin: { y: 0.65 },
                colors: ['#10b981', '#3b82f6', '#f59e0b'],
                zIndex: 10000
            });
            document.getElementById('successModal').classList.add('active');
        }, 300);
    }
});
</script>
