<style>
    .help-grid {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-top: 20px;
        flex-wrap: wrap;
    }
    .help-card {
        background: #fff;
        border: 1.5px solid #f1f5f9;
        border-radius: 14px;
        padding: 15px 25px;
        text-align: center;
        transition: all 0.2s ease;
        text-decoration: none;
        color: inherit;
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 200px;
    }
    .help-card:hover {
        transform: translateY(-3px);
        border-color: #3b82f6;
        background: #f8fafc;
        box-shadow: 0 10px 20px rgba(0,0,0,0.05);
    }
    .help-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }
    .help-card h3 {
        font-size: 14px;
        font-weight: 800;
        margin: 0;
        color: #1e293b;
        white-space: nowrap;
    }
    .help-card p {
        display: none; /* Hide description for chicklet style */
    }
</style>

<div style="max-width: 900px; margin: 0 auto;">
    <div style="text-align: center; margin-bottom: 40px;">
        <h2 style="font-size: 28px; font-weight: 900; color: #1e293b; margin-bottom: 10px;">Bagaimana kami bisa membantu?</h2>
        <p style="color: #64748b; font-weight: 500;">Pilih kategori masalah yang ingin Anda laporkan</p>
    </div>

    <% if (locals.query && query.success) { %>
        <div style="background: #f0fdf4; border: 1px solid #10b981; color: #16a34a; padding: 20px; border-radius: 16px; margin-bottom: 30px; text-align: center; font-weight: 700;">
            <i class="fas fa-check-circle" style="margin-right: 8px;"></i> Laporan Anda berhasil dikirim! Kami akan segera meninjaunya.
        </div>
    <% } %>

    <% if (locals.query && query.error) { %>
        <div style="background: #fef2f2; border: 1px solid #ef4444; color: #dc2626; padding: 20px; border-radius: 16px; margin-bottom: 30px; text-align: center; font-weight: 700;">
            <i class="fas fa-exclamation-circle" style="margin-right: 8px;"></i> <%= query.error %>
        </div>
    <% } %>

    <div class="help-grid">
        <a href="/admin/help/report?type=bug" class="help-card">
            <div class="help-icon" style="background: #fef2f2; color: #ef4444;">
                <i class="fas fa-bug"></i>
            </div>
            <h3>Lapor Bug / Error</h3>
            <p>Sampaikan jika Anda menemukan fitur yang tidak berfungsi, tampilan berantakan, atau error sistem.</p>
        </a>

        <a href="/admin/help/report?type=withdrawal" class="help-card">
            <div class="help-icon" style="background: #fff7ed; color: #f59e0b;">
                <i class="fas fa-money-bill-transfer"></i>
            </div>
            <h3>Masalah Tarik Dana</h3>
            <p>Laporkan jika penarikan saldo Anda belum sampai, gagal, atau ada kendala pada pengaturan rekening.</p>
        </a>
    </div>

    <div style="margin-top: 50px; text-align: center; padding: 30px; background: #f8fafc; border-radius: 24px; border: 1px dashed #e2e8f0;">
        <p style="font-size: 13px; color: #94a3b8; font-weight: 600; margin-bottom: 15px;">Butuh bantuan mendesak?</p>
        <a href="https://wa.me/628123456789" target="_blank" style="display: inline-flex; align-items: center; gap: 10px; background: #25d366; color: white; text-decoration: none; padding: 12px 24px; border-radius: 12px; font-weight: 800; font-size: 14px;">
            <i class="fab fa-whatsapp" style="font-size: 18px;"></i> Chat WhatsApp Admin
        </a>
    </div>

    <% if (locals.myTickets && myTickets.length > 0) { %>
        <div style="margin-top: 50px;">
            <h3 style="font-size: 18px; font-weight: 900; color: #1e293b; margin-bottom: 20px;">Riwayat Laporan Saya</h3>
            <div style="background: #fff; border: 1px solid #e5e7eb; border-radius: 20px; overflow-x: auto; box-shadow: 0 4px 15px rgba(0,0,0,0.02);">
                <table style="width: 100%; border-collapse: collapse; min-width: 600px;">
                    <thead>
                        <tr>
                            <th style="background: #f9fafb; padding: 15px 20px; text-align: left; font-size: 11px; font-weight: 900; color: #64748b; border-bottom: 1px solid #e5e7eb; text-transform: uppercase;">Subjek</th>
                            <th style="background: #f9fafb; padding: 15px 20px; text-align: left; font-size: 11px; font-weight: 900; color: #64748b; border-bottom: 1px solid #e5e7eb; text-transform: uppercase;">Tipe</th>
                            <th style="background: #f9fafb; padding: 15px 20px; text-align: left; font-size: 11px; font-weight: 900; color: #64748b; border-bottom: 1px solid #e5e7eb; text-transform: uppercase;">Tanggal</th>
                            <th style="background: #f9fafb; padding: 15px 20px; text-align: left; font-size: 11px; font-weight: 900; color: #64748b; border-bottom: 1px solid #e5e7eb; text-transform: uppercase;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% myTickets.forEach(t => { %>
                            <tr>
                                <td style="padding: 15px 20px; font-size: 14px; border-bottom: 1px solid #f3f4f6;">
                                    <div style="font-weight: 700; color: #1e293b;"><%= t.subject %></div>
                                    <div style="margin-top: 8px;">
                                        <a href="/admin/help/ticket/<%= t.id %>" style="text-decoration: none; color: #3b82f6; font-size: 11px; font-weight: 800; display: flex; align-items: center; gap: 5px;">
                                            <i class="fas fa-comments"></i> Lihat Chat Percakapan
                                        </a>
                                    </div>
                                </td>
                                <td style="padding: 15px 20px; font-size: 14px; border-bottom: 1px solid #f3f4f6;">
                                    <span style="padding: 4px 10px; border-radius: 8px; font-size: 10px; font-weight: 850; text-transform: uppercase; background: <%= t.type === 'bug' ? '#fef2f2' : '#fff7ed' %>; color: <%= t.type === 'bug' ? '#ef4444' : '#f59e0b' %>;">
                                        <%= t.type %>
                                    </span>
                                </td>
                                <td style="padding: 15px 20px; font-size: 13px; color: #64748b; border-bottom: 1px solid #f3f4f6;">
                                    <%= new Date(t.created_at).toLocaleDateString('id-ID') %>
                                </td>
                                <td style="padding: 15px 20px; border-bottom: 1px solid #f3f4f6;">
                                    <% if (t.status === 'resolved') { %>
                                        <span style="background: #f0fdf4; color: #10b981; padding: 4px 10px; border-radius: 8px; font-size: 10px; font-weight: 850;">RESOLVED</span>
                                    <% } else { %>
                                        <span style="background: #eff6ff; color: #3b82f6; padding: 4px 10px; border-radius: 8px; font-size: 10px; font-weight: 850;">OPEN</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>
</div>
