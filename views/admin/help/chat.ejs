<style>
    .chat-container {
        max-width: 800px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        height: calc(100vh - 150px);
        background: #fff;
        border-radius: 24px;
        border: 1px solid #e5e7eb;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    }

    /* Header */
    .chat-header {
        padding: 20px 25px;
        background: #fff;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .chat-header h2 { margin: 0; font-size: 18px; font-weight: 900; color: #1e293b; }
    .status-tag { padding: 4px 12px; border-radius: 20px; font-size: 10px; font-weight: 800; text-transform: uppercase; }

    /* Messages Area */
    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 25px;
        background: #f8fafc;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .msg-bubble {
        max-width: 75%;
        padding: 12px 18px;
        border-radius: 18px;
        font-size: 14px;
        line-height: 1.5;
        position: relative;
        word-wrap: break-word;
    }

    /* Admin Bubble (Right) - If current user is Admin, or sender is Admin */
    /* Wait, let's logic: if is_admin=1, it's always from admin side */
    .msg-admin {
        align-self: flex-end;
        background: #111827;
        color: #fff;
        border-bottom-right-radius: 4px;
    }

    /* User Bubble (Left) */
    .msg-user {
        align-self: flex-start;
        background: #fff;
        color: #1e293b;
        border-bottom-left-radius: 4px;
        border: 1px solid #e2e8f0;
    }

    .msg-time {
        font-size: 9px;
        margin-top: 5px;
        display: block;
        opacity: 0.7;
        text-align: right;
    }

    .msg-attachment {
        margin-bottom: 10px;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.05);
    }
    .msg-attachment img { width: 100%; display: block; max-height: 300px; object-fit: cover; }

    /* Input Area */
    .chat-input-area {
        padding: 20px 25px;
        background: #fff;
        border-top: 1px solid #f1f5f9;
    }
    .chat-form { display: flex; gap: 12px; align-items: flex-end; }
    .chat-input {
        flex: 1;
        padding: 12px 18px;
        border: 1.5px solid #f1f5f9;
        border-radius: 14px;
        font-size: 14px;
        outline: none;
        background: #f8fafc;
        transition: 0.2s;
        resize: none;
    }
    .chat-input:focus { border-color: #3b82f6; background: #fff; }

    .btn-send {
        background: #3b82f6;
        color: white;
        border: none;
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.2s;
    }
    .btn-send:hover { background: #2563eb; transform: scale(1.05); }
    
    .btn-file {
        background: #f1f5f9;
        color: #64748b;
        border: none;
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    @media (max-width: 600px) {
        .chat-container { height: calc(100vh - 100px); border-radius: 0; border: none; }
        .msg-bubble { max-width: 85%; }
    }
</style>

<div style="margin-bottom: 20px;">
    <a href="<%= isAdmin ? '/admin/reports' : '/admin/help' %>" style="text-decoration: none; color: #64748b; font-weight: 700; font-size: 13px; display: flex; align-items: center; gap: 8px;">
        <i class="fas fa-arrow-left"></i> Kembali ke Daftar
    </a>
</div>

<div class="chat-container">
    <div class="chat-header">
        <div>
            <h2><%= ticket.subject %></h2>
            <div style="font-size: 11px; color: #94a3b8; margin-top: 2px;">
                <% if (isAdmin) { %>
                    Chat dengan <strong><%= ticket.fullname %></strong> (<%= ticket.email %>)
                <% } else { %>
                    Bantuan Teknis Lingku
                <% } %>
            </div>
        </div>
        <span class="status-tag" style="background: <%= ticket.status === 'resolved' ? '#f0fdf4' : '#eff6ff' %>; color: <%= ticket.status === 'resolved' ? '#10b981' : '#3b82f6' %>;">
            <%= ticket.status %>
        </span>
    </div>

    <div class="chat-messages" id="chatMessages">
        <% messages.forEach(m => { 
            // My bubble on right, others on left
            const isMyMessage = (isAdmin && m.is_admin) || (!isAdmin && !m.is_admin);
        %>
            <div class="msg-bubble <%= isMyMessage ? 'msg-admin' : 'msg-user' %>">
                <% if (m.attachment) { %>
                    <div class="msg-attachment">
                        <a href="<%= m.attachment %>" target="_blank">
                            <img src="<%= m.attachment %>" alt="Attachment">
                        </a>
                    </div>
                <% } %>
                <div><%= m.message %></div>
                <span class="msg-time"><%= new Date(m.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
            </div>
        <% }) %>
    </div>

    <% if (ticket.status === 'open') { %>
        <div class="chat-input-area">
            <form action="/admin/help/ticket/<%= ticket.id %>/message" method="POST" enctype="multipart/form-data" class="chat-form">
                <button type="button" class="btn-file" onclick="document.getElementById('scInput').click()">
                    <i class="fas fa-paperclip"></i>
                </button>
                <input type="file" id="scInput" name="screenshot" style="display: none;" accept="image/*" onchange="previewFile()">
                
                <textarea name="message" class="chat-input" placeholder="Tulis pesan..." rows="1" required></textarea>
                
                <button type="submit" class="btn-send">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </form>
            <div id="filePreview" style="display: none; font-size: 10px; color: #3b82f6; font-weight: 800; margin-top: 8px;">
                <i class="fas fa-image"></i> <span id="fileName"></span> (Siap dikirim)
            </div>
        </div>
    <% } else { %>
        <div style="padding: 20px; text-align: center; background: #fff; border-top: 1px solid #f1f5f9; color: #94a3b8; font-size: 13px; font-weight: 700;">
            Percakapan ini telah selesai (Resolved).
        </div>
    <% } %>
</div>

<script>
    // Scroll to bottom
    const chatMsgs = document.getElementById('chatMessages');
    chatMsgs.scrollTop = chatMsgs.scrollHeight;

    function previewFile() {
        const input = document.getElementById('scInput');
        const preview = document.getElementById('filePreview');
        const name = document.getElementById('fileName');
        if (input.files && input.files[0]) {
            preview.style.display = 'block';
            name.innerText = input.files[0].name;
        }
    }
</script>
