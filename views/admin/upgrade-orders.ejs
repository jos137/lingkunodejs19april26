<style>
.uo-wrap { background: #fff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 28px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px -1px rgba(0, 0, 0, 0.01); }
.uo-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; }
.uo-title { font-size: 18px; font-weight: 800; color: #111827; display: flex; align-items: center; gap: 12px; margin: 0; }
.uo-title-icon { width: 38px; height: 38px; border-radius: 12px; background: linear-gradient(135deg, #8b5cf6, #6d28d9); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 15px; flex-shrink: 0; }

/* Stats Card — horizontal hero strip */
.stats-card {
    background: #fff;
    padding: 18px 20px;
    border-radius: 16px;
    color: #1e293b;
    display: flex;
    align-items: center;
    gap: 18px;
    text-align: left;
    border: 1px solid #e2e8f0;
    box-shadow: none;
    margin-bottom: 0;
    min-width: 0;
}
.stats-icon { width: 52px; height: 52px; background: linear-gradient(135deg, #8b5cf6, #6d28d9); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 20px; color: #fff; flex-shrink: 0; box-shadow: 0 8px 16px -4px rgba(139, 92, 246, 0.4); margin-top: 0; }
.stats-icon.green { background: linear-gradient(135deg, #10b981, #059669); box-shadow: 0 8px 16px -4px rgba(16, 185, 129, 0.4); }
.stats-icon.slate { background: linear-gradient(135deg, #64748b, #475569); box-shadow: 0 8px 16px -4px rgba(100, 116, 139, 0.4); }
.stats-info { flex: 1; min-width: 0; }
.stats-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.2px; color: #64748b; margin-bottom: 4px; }
.stats-value { font-size: 24px; font-weight: 600; color: #1e293b; white-space: nowrap; font-variant-numeric: tabular-nums; max-width: 100%; overflow: hidden; text-overflow: ellipsis; letter-spacing: -0.5px; }
.stats-sub { font-size: 11px; margin-top: 4px; color: #64748b; font-weight: 600; display: flex; align-items: center; gap: 6px; }

/* Filter Box */
.filter-box {
    display: flex;
    gap: 8px;
    align-items: center;
    background: #fff;
    padding: 8px 12px;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
}

.top-section {
    margin-bottom: 24px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 20px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px -1px rgba(0, 0, 0, 0.01);
}
.top-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
}
.top-filter { display: flex; align-items: center; }

@media (max-width: 768px) {
    .top-cards { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .filter-box { justify-content: flex-start; }
    .stats-value { font-size: 20px; }
    .uo-header { flex-wrap: wrap; gap: 12px; }
    .uo-wrap { padding: 20px; }
}
.filter-input {
    padding: 8px 12px;
    border: 1.5px solid #f1f5f9;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 600;
    color: #374151;
    outline: none;
    background: #f8fafc;
}
.filter-btn {
    padding: 8px 20px;
    background: #8b5cf6;
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: 0.2s;
}
.filter-btn:hover { background: #7c3aed; }

.uo-table { width: 100%; border-collapse: collapse; }
.uo-table th { text-align: left; padding: 16px; border-bottom: 1.5px solid #f1f5f9; font-size: 11px; font-weight: 800; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; }
.uo-table td { padding: 18px 16px; border-bottom: 1px solid #f1f5f9; font-size: 13.5px; color: #374151; vertical-align: middle; }

.uo-user { display: flex; align-items: center; gap: 12px; }
.uo-avatar { width: 36px; height: 36px; border-radius: 10px; background: #8b5cf6; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 14px; }
.uo-name { font-weight: 800; color: #111827; margin-bottom: 2px; }
.uo-email { font-size: 11px; color: #94a3b8; }

.uo-status { font-size: 12px; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase; }
.uo-status.completed { color: #059669; }
.uo-status.pending { color: #d97706; }
.uo-status.expired, .uo-status.rejected, .uo-status.failed { color: #374151; }

.uo-price { font-weight: 700; color: #111827; white-space: nowrap; font-variant-numeric: tabular-nums; }
.uo-date { color: #64748b; font-size: 12px; }

/* Pagination */
.uo-pagination { display: flex; justify-content: center; gap: 10px; margin-top: 30px; }
.uo-page { padding: 8px 14px; border: 1px solid #e5e7eb; border-radius: 8px; color: #374151; text-decoration: none; font-size: 13px; font-weight: 700; transition: 0.2s; }
.uo-page:hover { border-color: #3b82f6; color: #3b82f6; }
.uo-page.active { background: #111827; color: #fff; border-color: #111827; }
</style>

<div class="top-section">
<div class="top-cards">
    <div class="stats-card">
        <div class="stats-icon">
            <i class="fas fa-crown"></i>
        </div>
        <div class="stats-info">
            <div class="stats-label">Platform Revenue</div>
            <div class="stats-value" title="Rp <%= parseFloat(stats.total_revenue || 0).toLocaleString('id-ID') %>">Rp <%= parseFloat(stats.total_revenue || 0).toLocaleString('id-ID') %></div>
            <div class="stats-sub">
                <i class="fas fa-check-circle" style="color: #10b981;"></i> <%= stats.total_count %> Transaksi
            </div>
        </div>
    </div>
    <div class="stats-card">
        <div class="stats-icon green">
            <i class="fas fa-bolt"></i>
        </div>
        <div class="stats-info">
            <div class="stats-label">PRO Aktif</div>
            <div class="stats-value"><%= stats.active_pro || 0 %> <span style="font-size:12px; font-weight:700; color:#64748b;">Users</span></div>
            <div class="stats-sub">
                <i class="fas fa-check-circle" style="color: #10b981;"></i> Masih berlangganan
            </div>
        </div>
    </div>
    <div class="stats-card">
        <div class="stats-icon slate">
            <i class="fas fa-calendar-xmark"></i>
        </div>
        <div class="stats-info">
            <div class="stats-label">Expired</div>
            <div class="stats-value"><%= stats.expired_pro || 0 %> <span style="font-size:12px; font-weight:700; color:#64748b;">Users</span></div>
            <div class="stats-sub">
                <i class="fas fa-circle-exclamation" style="color: #64748b;"></i> Langganan berakhir
            </div>
        </div>
    </div>
</div>
</div>

<div class="uo-wrap">
    <div class="uo-header">
        <h2 class="uo-title"><span class="uo-title-icon"><i class="fas fa-crown"></i></span> Penjualan Platform</h2>
        <form action="" method="GET" style="display: flex; gap: 8px; align-items: center;">
            <div class="filter-box">
                <i class="fas fa-calendar-day" style="color: #94a3b8; font-size: 14px;"></i>
                <input type="date" name="date" class="filter-input" value="<%= locals.filters ? filters.date : '' %>" style="border:none; background:transparent; padding:0; width:140px;">
            </div>
            <button type="submit" class="filter-btn" style="height: 40px; width: 40px; padding: 0; display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-search"></i>
            </button>
            <% if (locals.filters && filters.date) { %>
                <a href="/admin/upgrade-orders" class="filter-btn" style="background: #f1f5f9; color: #64748b; height: 40px; width: 40px; padding: 0; display: flex; align-items: center; justify-content: center; text-decoration: none;">
                    <i class="fas fa-times"></i>
                </a>
            <% } %>
        </form>
    </div>

    <div style="overflow-x: auto;">
        <table class="uo-table">
            <thead>
                <tr>
                    <th>Pelanggan</th>
                    <th>Reference ID</th>
                    <th>Nominal</th>
                    <th>Metode</th>
                    <th>Status</th>
                    <th>Tanggal</th>
                </tr>
            </thead>
            <tbody>
                <% if (orders.length > 0) { %>
                    <% orders.forEach(o => { %>
                        <tr>
                            <td>
                                <div class="uo-user">
                                    <div class="uo-avatar"><%= (o.customer_name || 'U').charAt(0).toUpperCase() %></div>
                                    <div>
                                        <div class="uo-name"><%= o.customer_name || o.buyer_name || 'User' %></div>
                                        <div class="uo-email"><%= o.buyer_email %></div>
                                    </div>
                                </div>
                            </td>
                            <td style="font-family: monospace; font-weight: 700; color: #64748b;">#<%= o.reference_id %></td>
                            <td class="uo-price">Rp <%= parseFloat(o.total_price || 0).toLocaleString('id-ID') %></td>
                            <td style="font-weight: 700; color: #3b82f6; text-transform: uppercase; font-size: 12px;"><%= o.payment_channel || 'QRIS' %></td>
                            <td>
                                <span class="uo-status <%= o.status %>"><%= o.status.toUpperCase() %></span>
                            </td>
                            <td class="uo-date">
                                <%= new Date(o.created_at).toLocaleDateString('id-ID', { day:'numeric', month:'short', year:'numeric' }) %><br>
                                <span style="font-size:10px; opacity:0.6;"><%= new Date(o.created_at).toLocaleTimeString('id-ID', { hour:'2-digit', minute:'2-digit' }) %> WIB</span>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 50px; color: #94a3b8; font-weight: 600;">
                            <i class="fas fa-receipt" style="font-size: 40px; margin-bottom: 10px; display: block; opacity: 0.3;"></i>
                            Belum ada pesanan upgrade yang tercatat.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <% if (totalPages > 1) { %>
        <div class="uo-pagination">
            <% for(let i = 1; i <= totalPages; i++) { %>
                <a href="?page=<%= i %>" class="uo-page <%= i === currentPage ? 'active' : '' %>"><%= i %></a>
            <% } %>
        </div>
    <% } %>
</div>
