<style>
.detail-header-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 24px; padding: 35px; margin-bottom: 25px; display: flex; align-items: center; gap: 25px; box-shadow: 0 4px 15px rgba(0,0,0,0.02); }
.user-info-avatar { width: 70px; height: 70px; border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 30px; font-weight: 1000; color: white; flex-shrink: 0; }
.user-info-text h1 { margin: 0; font-size: 22px; font-weight: 1000; color: #111827; letter-spacing: -0.5px; }
.user-info-text p { margin: 6px 0 0; color: #64748b; font-size: 14px; font-weight: 600; }

.stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 25px; }
.stat-box { background: #fff; border: 1px solid #e5e7eb; border-radius: 20px; padding: 25px; text-align: center; box-shadow: 0 4px 10px rgba(0,0,0,0.02); }
.stat-label { font-size: 11px; font-weight: 900; color: #94a3b8; text-transform: uppercase; margin-bottom: 10px; letter-spacing: 1.2px; }
.stat-value { font-size: 22px; font-weight: 1000; color: #111827; }

/* Filter Tabs */
.t-filters { display: flex; gap: 10px; margin-bottom: 15px; background: #fff; padding: 12px; border-radius: 16px; border: 1px solid #e5e7eb; width: fit-content; }
.t-btn { padding: 8px 16px; border-radius: 10px; font-size: 12.5px; font-weight: 800; color: #64748b; text-decoration: none; transition: 0.2s; border: none; background: none; cursor: pointer; }
.t-btn.active { background: #111827; color: white; }
.t-btn:not(.active):hover { background: #f1f5f9; color: #111827; }

.buyer-table-scroll { width: 100%; overflow-x: auto; background: #fff; border: 1px solid #e5e7eb; border-radius: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.02); }
.buyer-table { width: 100%; border-collapse: collapse; min-width: 800px; }
.buyer-table thead th { background: #f9fafb; padding: 18px 25px; text-align: left; font-size: 11px; font-weight: 900; color: #64748b; border-bottom: 1px solid #e5e7eb; text-transform: uppercase; letter-spacing: 1px; }
.buyer-table tbody td { padding: 18px 25px; font-size: 14px; border-bottom: 1px solid #f3f4f6; color: #475569; }
.buyer-table tbody tr:hover { background: #f8fafc; }

.status-tag { padding: 5px 12px; border-radius: 100px; font-size: 10px; font-weight: 850; text-transform: uppercase; letter-spacing: 0.5px; }
.status-tag.completed { background: #f0fdf4; color: #16a34a; border: 1px solid rgba(22,163,74,0.1); }
.status-tag.pending { background: #fffbeb; color: #d97706; border: 1px solid rgba(217,119,6,0.1); }
.status-tag.expired { background: #fef2f2; color: #dc2626; border: 1px solid rgba(220,38,38,0.1); }

/* Pagination */
.pagination { display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 30px; margin-bottom: 50px; }
.p-btn { width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; border-radius: 12px; background: #fff; border: 1px solid #e5e7eb; color: #64748b; text-decoration: none; font-weight: 800; font-size: 13px; transition: 0.2s; }
.p-btn:hover { border-color: #3b82f6; color: #3b82f6; }
.p-btn.active { background: #111827; color: white; border-color: #111827; }
.p-btn.disabled { opacity: 0.3; pointer-events: none; }

.btn-back { display: inline-flex; align-items: center; gap: 10px; color: #64748b; text-decoration: none; font-size: 14px; font-weight: 700; margin-bottom: 25px; transition: 0.2s; }
.btn-back:hover { color: #111827; transform: translateX(-5px); }

@media (max-width: 768px) {
    .detail-header-card { flex-direction: column; text-align: center; padding: 30px 20px; gap: 15px; }
    .stats-grid { grid-template-columns: 1fr; gap: 15px; }
}
</style>

<a href="/admin/users" class="btn-back"><i class="fas fa-arrow-left"></i> Kembali ke Manajemen User</a>

<div class="detail-header-card">
    <% 
        const colors = ['#6366f1','#10b981','#f59e0b','#ec4899','#3b82f6','#8b5cf6','#ef4444'];
        const color = colors[targetUser.id % colors.length];
        const displayName = targetUser.name || targetUser.username || targetUser.email || 'User';
        
        let finalPhoto = targetUser.profile_photo || '';
        if (finalPhoto && !finalPhoto.startsWith('http') && !finalPhoto.startsWith('/')) {
            finalPhoto = '/uploads/profiles/' + finalPhoto;
        }
    %>
    
    <% if (finalPhoto) { %>
        <img src="<%= finalPhoto %>" alt="AV" style="width:70px; height:70px; border-radius:20px; object-fit:cover;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'">
        <div class="user-info-avatar" style="background: <%= color %>; display:none;">
            <%= displayName.charAt(0).toUpperCase() %>
        </div>
    <% } else { %>
        <div class="user-info-avatar" style="background: <%= color %>">
            <%= displayName.charAt(0).toUpperCase() %>
        </div>
    <% } %>

    <div class="user-info-text">
        <h1 style="color: #111827; font-weight: 1000;">Daftar Pembeli: <%= displayName %></h1>
        <p><%= targetUser.email %> • Member sejak <%= new Date(targetUser.created_at).toLocaleDateString('id-ID', {month:'long', year:'numeric'}) %></p>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-box">
        <div class="stat-label">Total Pesanan (<%= currentStatus %>)</div>
        <div class="stat-value"><%= totalItems %></div>
    </div>
    <div class="stat-box">
        <div class="stat-label">Member Role</div>
        <div class="stat-value"><%= (targetUser.role || 'USER').toUpperCase() %></div>
    </div>
    <div class="stat-box">
        <div class="stat-label">Plan User</div>
        <div class="stat-value"><%= (targetUser.plan || 'FREE').toUpperCase() %></div>
    </div>
</div>

<div class="t-filters">
    <a href="/admin/users/detail/<%= targetUser.id %>?status=all" class="t-btn <%= currentStatus === 'all' ? 'active' : '' %>">Semua</a>
    <a href="/admin/users/detail/<%= targetUser.id %>?status=completed" class="t-btn <%= currentStatus === 'completed' ? 'active' : '' %>">Completed ✅</a>
    <a href="/admin/users/detail/<%= targetUser.id %>?status=pending" class="t-btn <%= currentStatus === 'pending' ? 'active' : '' %>">Pending ⏳</a>
</div>

<div class="buyer-table-scroll">
    <table class="buyer-table">
        <thead>
            <tr>
                <th>Tanggal</th>
                <th>Pembeli</th>
                <th>Produk</th>
                <th>Harga</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <% if (orders.length > 0) { %>
                <% orders.forEach(o => { %>
                    <tr>
                        <td style="font-weight:700; color:#64748b;">
                            <%= new Date(o.created_at).toLocaleDateString('id-ID', {day:'numeric', month:'short', hour:'2-digit', minute:'2-digit', timeZone: 'Asia/Jakarta'}) %>
                        </td>
                        <td>
                            <div style="font-weight:800; color:#111827; margin-bottom: 2px;"><%= o.customer_name %></div>
                            <div style="font-size:11.5px; color:#94a3b8; font-weight:600;"><i class="far fa-envelope"></i> <%= o.customer_email %></div>
                        </td>
                        <td><strong style="color:#3b82f6;"><%= o.product_name %></strong></td>
                        <td style="font-weight:1000; color: #111827;">Rp <%= parseFloat(o.total_price).toLocaleString('id-ID') %></td>
                        <td><span class="status-tag <%= o.status %>"><%= o.status %></span></td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr><td colspan="5" style="text-align:center; padding:80px; color:#94a3b8; font-weight:700;">Belum ada riwayat pesanan untuk status ini.</td></tr>
            <% } %>
        </tbody>
    </table>
</div>

<% if (totalPages > 1) { %>
    <div class="pagination">
        <a href="/admin/users/detail/<%= targetUser.id %>?page=<%= currentPage - 1 %>&status=<%= currentStatus %>" class="p-btn <%= currentPage === 1 ? 'disabled' : '' %>">
            <i class="fas fa-chevron-left"></i>
        </a>
        
        <% 
            let startPage = Math.max(1, currentPage - 2);
            let endPage = Math.min(totalPages, startPage + 4);
            if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);
        %>

        <% for(let i = startPage; i <= endPage; i++) { %>
            <a href="/admin/users/detail/<%= targetUser.id %>?page=<%= i %>&status=<%= currentStatus %>" class="p-btn <%= currentPage === i ? 'active' : '' %>">
                <%= i %>
            </a>
        <% } %>

        <a href="/admin/users/detail/<%= targetUser.id %>?page=<%= currentPage + 1 %>&status=<%= currentStatus %>" class="p-btn <%= currentPage === totalPages ? 'disabled' : '' %>">
            <i class="fas fa-chevron-right"></i>
        </a>
    </div>
<% } %>
