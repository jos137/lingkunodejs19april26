<style>
.detail-header-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 24px; padding: 35px; margin-bottom: 25px; display: flex; align-items: center; gap: 25px; box-shadow: 0 4px 15px rgba(0,0,0,0.02); position: relative; }
.user-info-avatar { width: 70px; height: 70px; border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 30px; font-weight: 1000; color: white; flex-shrink: 0; }
.user-info-text h1 { margin: 0; font-size: 22px; font-weight: 1000; color: #111827; letter-spacing: -0.5px; }
.user-info-text p { margin: 6px 0 0; color: #64748b; font-size: 14px; font-weight: 600; }

.stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; margin-bottom: 25px; }
.stat-box { background: #fff; border: 1px solid #e5e7eb; border-radius: 20px; padding: 20px; text-align: center; box-shadow: 0 4px 10px rgba(0,0,0,0.02); }
.stat-label { font-size: 10px; font-weight: 900; color: #94a3b8; text-transform: uppercase; margin-bottom: 8px; letter-spacing: 1.2px; }
.stat-value { font-size: 18px; font-weight: 1000; color: #111827; }

/* Plan Badges */
.plan-badge { padding: 4px 12px; border-radius: 100px; font-size: 11px; font-weight: 850; }
.plan-free { background: #f1f5f9; color: #64748b; border: 1px solid #e2e8f0; }
.plan-pro { background: linear-gradient(135deg, #f59e0b, #fbbf24); color: #fff; border: 1px solid #d97706; box-shadow: 0 4px 10px rgba(245, 158, 11, 0.2); }

.suspend-btn { position: absolute; right: 35px; top: 45px; padding: 6px 14px; background: #fff; color: #dc2626; border: 1px solid #fecaca; border-radius: 10px; font-weight: 800; font-size: 11px; text-decoration: none; transition: 0.2s; display: flex; align-items: center; gap: 6px; }
.suspend-btn:hover { background: #fee2e2; transform: translateY(-1px); }
.suspend-btn i { font-size: 10px; }

/* Filter Tabs */
.t-filters { display: flex; gap: 8px; margin-bottom: 20px; background: #f8fafc; padding: 6px; border-radius: 12px; border: 1px solid #e5e7eb; width: fit-content; }
.t-btn { padding: 6px 14px; border-radius: 8px; font-size: 12px; font-weight: 800; color: #64748b; text-decoration: none; transition: 0.2s; border: none; background: none; cursor: pointer; }
.t-btn.active { background: #fff; color: #3b82f6; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
.t-btn:not(.active):hover { color: #111827; }

.section-title { font-size: 18px; font-weight: 1000; color: #111827; margin: 35px 0 20px; display: flex; align-items: center; gap: 10px; }
.section-title i { color: #3b82f6; }

.buyer-table-scroll { width: 100%; overflow-x: auto; background: #fff; border: 1px solid #e5e7eb; border-radius: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.02); margin-bottom: 30px; }
.buyer-table { width: 100%; border-collapse: collapse; min-width: 800px; }
.buyer-table thead th { background: #f9fafb; padding: 18px 25px; text-align: left; font-size: 11px; font-weight: 900; color: #64748b; border-bottom: 1px solid #e5e7eb; text-transform: uppercase; letter-spacing: 1px; }
.buyer-table tbody td { padding: 18px 25px; font-size: 14px; border-bottom: 1px solid #f3f4f6; color: #475569; }

.status-tag { padding: 5px 12px; border-radius: 100px; font-size: 10px; font-weight: 850; text-transform: uppercase; letter-spacing: 0.5px; }
.status-tag.completed { background: #f0fdf4; color: #16a34a; border: 1px solid rgba(22,163,74,0.1); }
.status-tag.pending { background: #fffbeb; color: #d97706; border: 1px solid rgba(217,119,6,0.1); }

.pagination { display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 20px; margin-bottom: 20px; }
.p-btn { width: 35px; height: 35px; display: flex; align-items: center; justify-content: center; border-radius: 10px; background: #fff; border: 1px solid #e5e7eb; color: #64748b; text-decoration: none; font-weight: 800; font-size: 12px; transition: 0.2s; }
.p-btn.active { background: #111827; color: white; border-color: #111827; }

.btn-back { display: inline-flex; align-items: center; gap: 10px; color: #64748b; text-decoration: none; font-size: 14px; font-weight: 700; margin-bottom: 25px; transition: 0.2s; }
.btn-back:hover { color: #111827; transform: translateX(-5px); }

@media (max-width: 768px) {
    .stats-grid { grid-template-columns: 1fr 1fr; }
    .suspend-btn { position: relative; right: auto; top: auto; width: 100%; margin-top: 15px; }
}
</style>

<a href="/admin/users" class="btn-back"><i class="fas fa-arrow-left"></i> Kembali ke Manajemen User</a>

<div class="detail-header-card">
    <% 
        const colors = ['#6366f1','#10b981','#f59e0b','#ec4899','#3b82f6','#8b5cf6','#ef4444'];
        const color = colors[targetUser.id % colors.length];
        let displayName = targetUser.fullname || targetUser.name || targetUser.email.split('@')[0];
    %>
    
    <div class="user-info-avatar" style="background: <%= color %>">
        <%= displayName.charAt(0).toUpperCase() %>
    </div>

    <div class="user-info-text">
        <h1><%= displayName %></h1>
        <p style="color: #60a5fa; font-size: 13px; font-weight: 400; letter-spacing: 0.2px;"><%= targetUser.email %> • Member sejak <%= new Date(targetUser.created_at).toLocaleDateString('id-ID', {month:'long', year:'numeric'}) %></p>
        <div style="margin-top: 10px;">
            <span class="plan-badge <%= targetUser.plan === 'pro' ? 'plan-pro' : 'plan-free' %>">
                <i class="fas <%= targetUser.plan === 'pro' ? 'fa-crown' : 'fa-user' %>"></i> <%= (targetUser.plan || 'FREE').toUpperCase() %>
            </span>
        </div>
    </div>

    <a href="#" onclick="if(confirm('Yakin ingin mensuspend user ini?')) alert('Fitur backend segera hadir!')" class="suspend-btn">
        <i class="fas fa-user-slash"></i> SUSPEND USER
    </a>
</div>

<div class="stats-grid">
    <div class="stat-box">
        <div class="stat-label">Total Pesanan Diurus</div>
        <div class="stat-value"><%= totalItems %></div>
    </div>
    <div class="stat-box">
        <div class="stat-label">Member Role</div>
        <div class="stat-value" style="color: #3b82f6;"><%= (targetUser.role || 'USER').toUpperCase() %></div>
    </div>
    <div class="stat-box">
        <div class="stat-label">Total Belanja (IDR)</div>
        <div class="stat-value" style="color: #dc2626;">Rp <%= parseFloat(totalSpent || 0).toLocaleString('id-ID') %></div>
    </div>
    <div class="stat-box">
        <div class="stat-label">Total Penjualan (IDR)</div>
        <div class="stat-value" style="color: #16a34a;">Rp <%= parseFloat(totalSales || 0).toLocaleString('id-ID') %></div>
    </div>
</div>

<div class="section-title"><i class="fas fa-shopping-cart"></i> Riwayat Pesanan dari User Lain</div>
<div class="t-filters">
    <a href="/admin/users/detail/<%= targetUser.id %>?status=all" class="t-btn <%= currentStatus === 'all' ? 'active' : '' %>">Semua</a>
    <a href="/admin/users/detail/<%= targetUser.id %>?status=completed" class="t-btn <%= currentStatus === 'completed' ? 'active' : '' %>">Completed ✅</a>
</div>

<div class="buyer-table-scroll">
    <table class="buyer-table">
        <thead>
            <tr>
                <th>Tanggal</th>
                <th>Pembeli</th>
                <th>Produk</th>
                <th>Harga</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <% if (orders && orders.length > 0) { %>
                <% orders.forEach(o => { %>
                    <tr>
                        <td style="font-weight:700; color:#64748b;">
                            <%= new Date(o.created_at).toLocaleDateString('id-ID', {day:'numeric', month:'short'}) %>
                        </td>
                        <td>
                            <div style="font-weight:800; color:#111827;"><%= o.customer_name %></div>
                            <div style="font-size:11.5px; color:#94a3b8;"><%= o.customer_email %></div>
                        </td>
                        <td><strong style="color:#3b82f6;"><%= o.product_name %></strong></td>
                        <td style="font-weight:1000; color: #111827;">Rp <%= parseFloat(o.total_price).toLocaleString('id-ID') %></td>
                        <td><span class="status-tag <%= o.status %>"><%= o.status %></span></td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr><td colspan="5" style="text-align:center; padding:50px; color:#94a3b8;">Belum ada pesanan masuk.</td></tr>
            <% } %>
        </tbody>
    </table>
</div>

<div class="section-title"><i class="fas fa-box"></i> Daftar Produk yang Dibuat User</div>
<div class="buyer-table-scroll">
    <table class="buyer-table">
        <thead>
            <tr>
                <th>Produk</th>
                <th>Harga</th>
                <th>Dibuat Pada</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <% if (userProducts && userProducts.length > 0) { %>
                <% userProducts.forEach(p => { %>
                    <tr>
                        <td>
                            <div style="font-weight:800; color:#111827;"><%= p.name %></div>
                            <div style="font-size:11.5px; color:#94a3b8;">ID: <%= p.id %></div>
                        </td>
                        <td style="font-weight:1000; color: #111827;">Rp <%= parseFloat(p.price).toLocaleString('id-ID') %></td>
                        <td style="color:#64748b;"><%= new Date(p.created_at).toLocaleDateString('id-ID') %></td>
                        <td><span class="status-tag completed">Aktif</span></td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr><td colspan="4" style="text-align:center; padding:50px; color:#94a3b8;">User belum membuat produk apa pun.</td></tr>
            <% } %>
        </tbody>
    </table>
</div>
