<%
    const c = locals.counts || {};
    const visitors = Number(locals.visitors || 0);
    const pageViews = Number(c['page_view'] || 0);
    const viewProduct = Number(c['view_product'] || 0);
    const initiateCheckout = Number(c['initiate_checkout'] || 0);
    const purchases = Number(c['purchase'] || 0);
    const clicks = Number(c['click'] || 0);
    const revenue = Number(locals.revenue || 0);
    const convRate = visitors > 0 ? (purchases / visitors * 100) : 0;
    const funnel = [
        { label: 'Pengunjung', value: visitors, color: '#3b82f6' },
        { label: 'Lihat Produk', value: viewProduct, color: '#8b5cf6' },
        { label: 'Checkout', value: initiateCheckout, color: '#f59e0b' },
        { label: 'Pembelian', value: purchases, color: '#10b981' }
    ];
    const funnelMax = Math.max(1, ...funnel.map(f => f.value));
    const daily = locals.daily || [];
    const dailyMax = Math.max(1, ...daily.map(d => Number(d.visitors || 0)));
    const sources = locals.sources || [];
    const topProducts = locals.topProducts || [];
    const recent = locals.recent || [];
    const fmt = n => Number(n || 0).toLocaleString('id-ID');
    const pctOf = (v) => visitors > 0 ? (Number(v) / visitors * 100) : 0;
    const pctLabel = (v) => { const p = pctOf(v); return (p >= 10 ? Math.round(p) : p.toFixed(1)) + '%'; };

    const ms = locals.metaStats || {};
    const mVisitors = Number(ms.visitors || 0);
    const mOrders = Number(ms.orders || 0);
    const mPaid = Number(ms.paid || 0);
    const mPending = Number(ms.pending || 0);
    const mRevenue = Number(ms.revenue || 0);
    const mCampaigns = ms.campaigns || [];
    const mOrderRate = mVisitors > 0 ? (mOrders / mVisitors * 100) : 0;
    const mPaidRate = mOrders > 0 ? (mPaid / mOrders * 100) : 0;
    const mConv = mVisitors > 0 ? (mPaid / mVisitors * 100) : 0;
    const mFunnelMax = Math.max(1, mVisitors, mOrders, mPaid);
%>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<style>
    .trk-page { width:100%; max-width:100%; min-width:0; overflow-x:hidden; }
    .trk-grid { display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:14px; margin-bottom:20px; }
    .trk-card { background:#fff; border:1px solid #e2e8f0; border-radius:16px; padding:18px 20px; min-width:0; display:flex; align-items:flex-start; gap:12px; }
    .trk-card-icon { width:42px; height:42px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:17px; flex-shrink:0; }
    .trk-card-body { min-width:0; flex:1; }
    .trk-card .lbl { font-size:11px; font-weight:800; color:#64748b; text-transform:uppercase; letter-spacing:.5px; margin-bottom:8px; }
    .trk-card .val { font-size:clamp(17px, 2vw, 24px); font-weight:800; color:#0f172a; line-height:1.1; overflow-wrap:anywhere; }
    .trk-card .sub { font-size:11px; color:#94a3b8; margin-top:6px; font-weight:600; }
    .trk-panel { background:#fff; border:1px solid #e2e8f0; border-radius:16px; padding:22px; margin-bottom:20px; min-width:0; }
    .trk-title { font-size:14px; font-weight:900; color:#111827; margin-bottom:16px; display:flex; align-items:center; gap:8px; }
    .funnel-row { display:flex; align-items:center; gap:14px; margin-bottom:12px; min-width:0; }
    .funnel-name { width:120px; font-size:12px; font-weight:800; color:#374151; flex-shrink:0; }
    .funnel-track { flex:1; min-width:0; background:#f1f5f9; border-radius:8px; height:30px; overflow:hidden; }
    .funnel-fill { height:100%; border-radius:8px; display:flex; align-items:center; padding-left:12px; color:#fff; font-size:12px; font-weight:800; min-width:38px; white-space:nowrap; overflow:hidden; transition:width .3s; }
    .funnel-pct { width:56px; flex-shrink:0; text-align:right; font-size:11px; font-weight:400; color:#64748b; font-variant-numeric:tabular-nums; }
    .funnel-seg em { font-size:11px; font-weight:400; font-style:normal; opacity:.95; }
    .funnel-split { display:grid; grid-template-columns:minmax(0, 1fr) minmax(0, 1fr); gap:32px; align-items:center; }
    .funnel-bars { min-width:0; }
    .funnel-shape { display:flex; flex-direction:column; align-items:center; gap:3px; min-width:0; padding:4px 0; width:100%; max-width:320px; margin:0 auto; }
    .funnel-seg { height:42px; display:flex; flex-direction:column; align-items:center; justify-content:center; color:#fff; line-height:1.15; }
    .funnel-seg span { font-size:9px; font-weight:700; opacity:.95; text-transform:uppercase; letter-spacing:.2px; }
    .funnel-seg strong { font-size:15px; font-weight:900; }
    .trk-cols { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:20px; }
    .src-row, .daily-row { display:flex; align-items:center; gap:10px; min-width:0; padding:7px 0; border-bottom:1px solid #f3f4f6; font-size:12px; }
    .src-row:last-child, .daily-row:last-child { border-bottom:0; }
    .src-name { flex:1; min-width:0; color:#374151; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .src-bar { width:clamp(60px, 10vw, 120px); flex-shrink:0; height:8px; background:#f1f5f9; border-radius:6px; overflow:hidden; }
    .src-bar > span { display:block; height:100%; background:#3b82f6; border-radius:6px; }
    .src-val { width:56px; flex-shrink:0; text-align:right; font-weight:800; color:#0f172a; }
    .daily-bars { display:flex; align-items:flex-end; gap:6px; padding-top:26px; }
    .daily-col { position:relative; flex:1; min-width:0; display:flex; flex-direction:column; align-items:center; gap:4px; }
    .daily-col::after {
        content: attr(data-tip);
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%);
        margin-bottom: 6px;
        background: #0f172a;
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        padding: 5px 8px;
        border-radius: 6px;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transition: opacity .15s;
        z-index: 20;
        box-shadow: 0 4px 12px rgba(15,23,42,.25);
    }
    .daily-col:hover::after { opacity: 1; }
    .daily-val { font-size:9px; font-weight:800; color:#64748b; }
    .daily-bar-area { width:100%; height:110px; display:flex; align-items:flex-end; justify-content:center; }
    .daily-col .bar { width:100%; max-width:26px; background:linear-gradient(180deg,#60a5fa,#3b82f6); border-radius:6px 6px 0 0; min-height:2px; }
    .daily-col small { font-size:9px; color:#94a3b8; font-weight:700; white-space:nowrap; }
    .recent-scroll { max-height:260px; overflow:auto; -webkit-overflow-scrolling:touch; }
    .recent-table { width:100%; table-layout:fixed; border-collapse:collapse; font-size:12px; }
    .recent-table th { text-align:left; color:#64748b; font-size:10px; text-transform:uppercase; letter-spacing:.5px; padding:8px 10px; border-bottom:1px solid #e5e7eb; }
    .recent-table td { padding:8px 10px; border-bottom:1px solid #f3f4f6; color:#374151; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .recent-table th:nth-child(1), .recent-table td:nth-child(1) { width:96px; }
    .recent-table th:nth-child(3), .recent-table td:nth-child(3) { width:96px; }
    .recent-table th:nth-child(4), .recent-table td:nth-child(4) { width:92px; }
    .evt-badge { display:inline-block; max-width:100%; padding:2px 8px; border-radius:6px; font-size:10px; font-weight:800; background:#eff6ff; color:#1d4ed8; overflow:hidden; text-overflow:ellipsis; vertical-align:middle; }
    @media (max-width:1100px) {
        .trk-grid { grid-template-columns:repeat(2, minmax(0, 1fr)); }
        .trk-cols { grid-template-columns:minmax(0, 1fr); }
        .funnel-split { grid-template-columns:minmax(0, 1fr); gap:20px; }
    }
    @media (max-width:640px) {
        .trk-grid { grid-template-columns:minmax(0, 1fr); }
        .trk-panel { padding:16px; }
        .funnel-name { width:84px; font-size:11px; }
        .funnel-pct { width:44px; font-size:10px; }
        .src-bar { width:56px; }
        .src-val { width:42px; }
    }

    /* ===== CARD KHUSUS IKLAN META ===== */
    .meta-card {
        position: relative;
        overflow: hidden;
        margin-bottom: 20px;
        padding: 22px;
        border-radius: 20px;
        color: #e2e8f0;
        border: 1px solid rgba(59,130,246,.35);
        background:
            radial-gradient(120% 150% at 100% 0%, rgba(37,99,235,.55) 0%, rgba(11,18,32,0) 55%),
            linear-gradient(135deg, #0b1220 0%, #0f172a 55%, #060a12 100%);
        box-shadow: 0 18px 45px -24px rgba(37,99,235,.75);
    }
    .meta-head { display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:16px; position:relative; z-index:1; }
    .meta-title { font-size:15px; font-weight:900; display:flex; align-items:center; gap:8px; color:#fff; }
    .meta-title i { color:#60a5fa; }
    .meta-title small { font-size:10px; font-weight:700; color:#93c5fd; }
    .meta-period { font-size:10px; font-weight:800; letter-spacing:.5px; text-transform:uppercase; color:#bfdbfe; background:rgba(59,130,246,.18); border:1px solid rgba(96,165,250,.4); padding:4px 10px; border-radius:999px; }
    .meta-grid { display:grid; grid-template-columns:repeat(4, minmax(0,1fr)); gap:12px; position:relative; z-index:1; }
    .meta-stat { background:rgba(255,255,255,.05); border:1px solid rgba(148,163,184,.18); border-radius:13px; padding:12px 14px; min-width:0; }
    .meta-stat .lbl { font-size:9px; font-weight:800; text-transform:uppercase; letter-spacing:.5px; color:#94a3b8; margin-bottom:6px; }
    .meta-stat .val { font-size:20px; font-weight:900; color:#fff; line-height:1.1; overflow-wrap:anywhere; }
    .meta-stat .sub { font-size:10px; color:#93c5fd; margin-top:5px; font-weight:700; }
    .meta-funnel { margin-top:16px; position:relative; z-index:1; display:grid; gap:8px; }
    .meta-f-row { display:flex; align-items:center; gap:10px; min-width:0; }
    .meta-f-name { width:100px; flex-shrink:0; font-size:11px; font-weight:800; color:#cbd5e1; }
    .meta-f-track { flex:1; min-width:0; height:10px; background:rgba(148,163,184,.15); border-radius:999px; overflow:hidden; }
    .meta-f-fill { height:100%; border-radius:999px; background:linear-gradient(90deg,#60a5fa,#2563eb); }
    .meta-f-val { width:52px; flex-shrink:0; text-align:right; font-size:11px; font-weight:800; color:#fff; }
    .meta-campaigns { margin-top:16px; position:relative; z-index:1; }
    .meta-campaigns-title { font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:.5px; color:#94a3b8; margin-bottom:6px; }
    .meta-camp-row { display:flex; justify-content:space-between; align-items:center; gap:10px; padding:6px 0; border-bottom:1px solid rgba(148,163,184,.12); font-size:11px; }
    .meta-camp-row:last-child { border-bottom:0; }
    .meta-camp-name { color:#cbd5e1; font-weight:700; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; min-width:0; }
    .meta-camp-meta { color:#93c5fd; font-weight:800; white-space:nowrap; }
    .meta-empty { position:relative; z-index:1; margin-top:14px; padding:12px 14px; border-radius:12px; background:rgba(148,163,184,.08); border:1px dashed rgba(148,163,184,.3); color:#94a3b8; font-size:12px; font-weight:600; }
    @media (max-width:1100px) { .meta-grid { grid-template-columns:repeat(2, minmax(0,1fr)); } }
    @media (max-width:560px) {
        .meta-card { padding:16px; }
        .meta-grid { grid-template-columns:minmax(0,1fr); }
        .meta-f-name { width:84px; font-size:10px; }
    }

    /* ===== TAB SUMBER TRAFFIC / IKLAN META ===== */
    .trk-tabs { display:flex; gap:6px; background:#f1f5f9; padding:4px; border-radius:10px; margin-bottom:14px; width:fit-content; }
    .trk-tab { border:0; background:transparent; padding:6px 12px; border-radius:7px; font:inherit; font-size:11px; font-weight:800; color:#64748b; cursor:pointer; }
    .trk-tab.active { background:#fff; color:#111827; box-shadow:0 1px 4px rgba(0,0,0,.08); }
    .trk-panel-head { display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:14px; }
    .trk-panel-head .trk-tabs { margin-bottom:0; }
    .trk-date-form { display:flex; align-items:center; gap:6px; }
    .trk-date { border:1px solid #e2e8f0; border-radius:8px; padding:6px 8px; font-size:11px; font-weight:600; color:#334155; background:#fff; font-family:inherit; outline:none; }
    .trk-date:focus { border-color:#3b82f6; }
    .trk-date-range { min-width:180px; cursor:pointer; }
    .trk-date-btn { border:0; background:#3b82f6; color:#fff; border-radius:8px; padding:7px 10px; cursor:pointer; font-size:11px; font-weight:800; display:flex; align-items:center; }
    .trk-date-btn:hover { background:#2563eb; }
    .traffic-tab { display:none; }
    .traffic-tab.active { display:block; }
    .meta-mini-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:12px; }
    .meta-mini { background:linear-gradient(135deg,#eff6ff,#e0e7ff); border:1px solid #dbeafe; border-radius:12px; padding:10px 12px; min-width:0; }
    .meta-mini .lbl { font-size:9px; font-weight:800; color:#64748b; text-transform:uppercase; letter-spacing:.4px; }
    .meta-mini .val { font-size:18px; font-weight:900; color:#1e3a8a; margin-top:3px; line-height:1.1; overflow-wrap:anywhere; }
    .meta-mini .sub { font-size:9px; font-weight:700; color:#2563eb; margin-top:2px; }
    .meta-mini-funnel { display:grid; gap:6px; margin:8px 0 4px; }
    .meta-mini-funnel .meta-f-name { color:#475569; width:84px; font-size:10px; }
    .meta-mini-funnel .meta-f-val { color:#0f172a; width:40px; font-size:10px; }
    .meta-mini-funnel .meta-f-track { height:8px; background:#f1f5f9; }
    #ttab-meta .meta-camp-name { color:#334155; }
    #ttab-meta .meta-camp-meta { color:#2563eb; }
    #ttab-meta .meta-campaigns-title { color:#94a3b8; }
    #ttab-meta .meta-camp-row { border-bottom-color:#f1f5f9; }
    #ttab-meta .meta-empty { background:#f8fafc; border-color:#e2e8f0; color:#64748b; }
    @media (max-width:560px) {
        .meta-mini-grid { grid-template-columns:minmax(0,1fr); }
    }
</style>

<div class="trk-page">
<div class="trk-grid">
    <div class="trk-card">
        <div class="trk-card-icon" style="background:#eff6ff;color:#2563eb;"><i class="fas fa-users"></i></div>
        <div class="trk-card-body"><div class="lbl">Pengunjung</div><div class="val"><%= fmt(visitors) %></div><div class="sub">30 hari terakhir</div></div>
    </div>
    <div class="trk-card">
        <div class="trk-card-icon" style="background:#f5f3ff;color:#7c3aed;"><i class="fas fa-eye"></i></div>
        <div class="trk-card-body"><div class="lbl">Page Views</div><div class="val"><%= fmt(pageViews) %></div><div class="sub"><%= fmt(clicks) %> klik tercatat</div></div>
    </div>
    <div class="trk-card">
        <div class="trk-card-icon" style="background:#ecfdf5;color:#059669;"><i class="fas fa-shopping-bag"></i></div>
        <div class="trk-card-body"><div class="lbl">Pembelian</div><div class="val"><%= fmt(purchases) %></div><div class="sub">Konversi <%= convRate.toFixed(1) %>%</div></div>
    </div>
    <div class="trk-card">
        <div class="trk-card-icon" style="background:#fffbeb;color:#d97706;"><i class="fas fa-coins"></i></div>
        <div class="trk-card-body"><div class="lbl">Revenue</div><div class="val">Rp <%= fmt(revenue) %></div><div class="sub">dari event purchase</div></div>
    </div>
    <div class="trk-card">
        <div class="trk-card-icon" style="background:#ecfeff;color:#0891b2;"><i class="fas fa-arrow-down"></i></div>
        <div class="trk-card-body"><div class="lbl">Scroll 50%</div><div class="val"><%= fmt(c['scroll_50'] || 0) %></div><div class="sub">mencapai setengah halaman</div></div>
    </div>
    <div class="trk-card">
        <div class="trk-card-icon" style="background:#fff1f2;color:#e11d48;"><i class="fas fa-angles-down"></i></div>
        <div class="trk-card-body"><div class="lbl">Scroll 90%</div><div class="val"><%= fmt(c['scroll_90'] || 0) %></div><div class="sub">mencapai bawah halaman</div></div>
    </div>
</div>

<div class="trk-panel">
    <div class="trk-title"><i class="fas fa-filter" style="color:#3b82f6;"></i> Funnel Kunjungan (30 hari)</div>
    <div class="funnel-split">
        <div class="funnel-bars">
            <% funnel.forEach(f => { const w = Math.max(4, (f.value / funnelMax) * 100); %>
                <div class="funnel-row">
                    <div class="funnel-name"><%= f.label %></div>
                    <div class="funnel-track">
                        <div class="funnel-fill" style="width:<%= w %>%; background:<%= f.color %>;"><%= fmt(f.value) %></div>
                    </div>
                    <div class="funnel-pct"><%= pctLabel(f.value) %></div>
                </div>
            <% }); %>
        </div>
        <div class="funnel-shape">
            <% const shapeW = funnel.map((_, i) => 100 - i * 18); %>
            <% funnel.forEach((f, i) => {
                const w = shapeW[i];
                const nw = (i < funnel.length - 1) ? shapeW[i + 1] : Math.max(8, w * 0.7);
                const ratio = nw / w;
                const bl = ((1 - ratio) / 2) * 100;
                const br = ((1 + ratio) / 2) * 100;
            %>
                <div class="funnel-seg" title="<%= f.label %>: <%= pctLabel(f.value) %>" style="width:<%= w.toFixed(2) %>%; background:<%= f.color %>; clip-path:polygon(0 0, 100% 0, <%= br.toFixed(2) %>% 100%, <%= bl.toFixed(2) %>% 100%);">
                    <em><%= pctLabel(f.value) %></em>
                </div>
            <% }); %>
        </div>
    </div>
</div>

<div class="trk-cols">
    <div class="trk-panel">
        <div class="trk-title"><i class="fas fa-calendar-day" style="color:#8b5cf6;"></i> Pengunjung Harian (14 hari)</div>
        <% if (!daily.length) { %>
            <div style="color:#94a3b8;font-size:12px;padding:20px 0;text-align:center;">Belum ada data.</div>
        <% } else { %>
            <div class="daily-bars">
                <% daily.forEach(d => {
                    const v = Number(d.visitors || 0);
                    const h = Math.max(2, (v / dailyMax) * 100);
                    const dd = new Date(d.d);
                    const lbl = isNaN(dd.getTime()) ? String(d.d).slice(0, 10) : dd.toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit' });
                %>
                    <div class="daily-col" data-tip="<%= lbl %> · <%= v %> pengunjung" title="<%= lbl %> · <%= v %> pengunjung">
                        <span class="daily-val"><%= v %></span>
                        <div class="daily-bar-area"><div class="bar" style="height:<%= h %>%;"></div></div>
                        <small><%= lbl %></small>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>

    <div class="trk-panel">
        <div class="trk-panel-head">
            <div class="trk-tabs">
                <button type="button" class="trk-tab active" onclick="switchTrafficTab('sources', this)">Sumber Traffic</button>
                <button type="button" class="trk-tab" onclick="switchTrafficTab('meta', this)">🎯 Iklan Meta</button>
            </div>
            <form method="GET" action="/admin/tracking" class="trk-date-form" id="trkRangeForm">
                <input type="text" id="trkDateRange" class="trk-date trk-date-range" placeholder="Pilih rentang tanggal" readonly>
                <input type="hidden" name="from" id="trkFrom" value="<%= locals.filterFrom || '' %>">
                <input type="hidden" name="to" id="trkTo" value="<%= locals.filterTo || '' %>">
            </form>
        </div>

        <div class="traffic-tab active" id="ttab-sources">
            <% if (!sources.length) { %>
                <div style="color:#94a3b8;font-size:12px;padding:20px 0;text-align:center;">Belum ada data.</div>
            <% } else { const srcMax = Math.max(1, ...sources.map(s => Number(s.total || 0))); %>
                <% sources.forEach(s => { %>
                    <div class="src-row">
                        <div class="src-name" title="<%= s.source %>"><%= s.source %></div>
                        <div class="src-bar"><span style="width:<%= (Number(s.total)/srcMax*100) %>%;"></span></div>
                        <div class="src-val"><%= fmt(s.total) %></div>
                    </div>
                <% }); %>
            <% } %>
        </div>

        <div class="traffic-tab" id="ttab-meta">
            <div class="meta-mini-grid">
                <div class="meta-mini"><div class="lbl">Pengunjung iklan</div><div class="val"><%= fmt(mVisitors) %></div><div class="sub"><%= mOrderRate.toFixed(1) %>% jadi pesanan</div></div>
                <div class="meta-mini"><div class="lbl">Pesanan</div><div class="val"><%= fmt(mOrders) %></div><div class="sub"><%= fmt(mPending) %> pending</div></div>
                <div class="meta-mini"><div class="lbl">Pembayaran</div><div class="val"><%= fmt(mPaid) %></div><div class="sub"><%= mPaidRate.toFixed(1) %>% dari pesanan</div></div>
                <div class="meta-mini"><div class="lbl">Revenue</div><div class="val">Rp <%= fmt(mRevenue) %></div><div class="sub">konversi <%= mConv.toFixed(1) %>%</div></div>
            </div>

            <% if (mVisitors || mOrders || mPaid) { %>
            <div class="meta-mini-funnel">
                <div class="meta-f-row">
                    <div class="meta-f-name">Pengunjung</div>
                    <div class="meta-f-track"><div class="meta-f-fill" style="width:<%= Math.max(2, (mVisitors / mFunnelMax) * 100) %>%;"></div></div>
                    <div class="meta-f-val"><%= fmt(mVisitors) %></div>
                </div>
                <div class="meta-f-row">
                    <div class="meta-f-name">Pesanan</div>
                    <div class="meta-f-track"><div class="meta-f-fill" style="width:<%= Math.max(2, (mOrders / mFunnelMax) * 100) %>%; background:linear-gradient(90deg,#a78bfa,#7c3aed);"></div></div>
                    <div class="meta-f-val"><%= fmt(mOrders) %></div>
                </div>
                <div class="meta-f-row">
                    <div class="meta-f-name">Pembayaran</div>
                    <div class="meta-f-track"><div class="meta-f-fill" style="width:<%= Math.max(2, (mPaid / mFunnelMax) * 100) %>%; background:linear-gradient(90deg,#34d399,#059669);"></div></div>
                    <div class="meta-f-val"><%= fmt(mPaid) %></div>
                </div>
            </div>
            <% } else { %>
            <div class="meta-empty">Belum ada trafik iklan Meta dalam 30 hari terakhir. Pastikan iklan mengarah ke toko dan membawa <b>fbclid</b>/UTM.</div>
            <% } %>

            <% if (mCampaigns.length) { %>
            <div class="meta-campaigns">
                <div class="meta-campaigns-title">Per Campaign</div>
                <% mCampaigns.forEach(cp => { %>
                    <div class="meta-camp-row">
                        <span class="meta-camp-name"><%= cp.campaign %></span>
                        <span class="meta-camp-meta"><%= cp.orders %> pesanan · <%= cp.paid %> bayar · Rp <%= fmt(cp.revenue) %></span>
                    </div>
                <% }); %>
            </div>
            <% } %>
        </div>
    </div>
</div>

<div class="trk-cols">
    <div class="trk-panel">
        <div class="trk-title"><i class="fas fa-box" style="color:#10b981;"></i> Produk Paling Dilihat</div>
        <% if (!topProducts.length) { %>
            <div style="color:#94a3b8;font-size:12px;padding:20px 0;text-align:center;">Belum ada data.</div>
        <% } else { const pMax = Math.max(1, ...topProducts.map(p => Number(p.views || 0))); %>
            <% topProducts.forEach(p => { %>
                <div class="src-row">
                    <div class="src-name"><%= p.name %></div>
                    <div class="src-bar"><span style="width:<%= (Number(p.views)/pMax*100) %>%; background:#10b981;"></span></div>
                    <div class="src-val"><%= fmt(p.views) %></div>
                </div>
            <% }); %>
        <% } %>
    </div>

    <div class="trk-panel">
        <div class="trk-title"><i class="fas fa-clock-rotate-left" style="color:#64748b;"></i> Event Terbaru</div>
        <% if (!recent.length) { %>
            <div style="color:#94a3b8;font-size:12px;padding:20px 0;text-align:center;">Belum ada event.</div>
        <% } else { %>
            <div class="recent-scroll">
            <table class="recent-table">
                <thead><tr><th>Event</th><th>Halaman</th><th>Sumber</th><th>Waktu</th></tr></thead>
                <tbody>
                <% recent.forEach(r => { %>
                    <tr>
                        <td><span class="evt-badge"><%= r.event_name %></span></td>
                        <td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= r.page_url || '' %>"><%= r.page_url || '-' %></td>
                        <td><%= r.utm_source || r.referrer || 'Direct' %></td>
                        <td style="white-space:nowrap;"><%= new Date(r.created_at).toLocaleString('id-ID',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}) %></td>
                    </tr>
                <% }); %>
                </tbody>
            </table>
            </div>
        <% } %>
    </div>
</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var input = document.getElementById('trkDateRange');
    if (!input || typeof flatpickr === 'undefined') return;
    var fromEl = document.getElementById('trkFrom');
    var toEl = document.getElementById('trkTo');
    flatpickr(input, {
        mode: 'range',
        dateFormat: 'd M Y',
        defaultDate: (fromEl.value && toEl.value) ? [new Date(fromEl.value + 'T00:00:00'), new Date(toEl.value + 'T00:00:00')] : null,
        onChange: function (selectedDates, dateStr, instance) {
            if (selectedDates.length === 2) {
                fromEl.value = instance.formatDate(selectedDates[0], 'Y-m-d');
                toEl.value = instance.formatDate(selectedDates[1], 'Y-m-d');
                document.getElementById('trkRangeForm').submit();
            }
        }
    });
});
</script>

<script>
function switchTrafficTab(id, el) {
    document.querySelectorAll('.traffic-tab').forEach(function (t) { t.classList.remove('active'); });
    document.querySelectorAll('.trk-tab').forEach(function (b) { b.classList.remove('active'); });
    var target = document.getElementById('ttab-' + id);
    if (target) target.classList.add('active');
    if (el) el.classList.add('active');
}
</script>
