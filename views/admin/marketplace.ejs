<style>
    .market-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 16px;
        margin-top: 20px;
    }
    .product-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #e5e7eb;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
    }
    .product-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
        border-color: #10b981;
    }
    .card-thumb-w {
        position: relative;
        aspect-ratio: 1/1;
        overflow: hidden;
        background: #f8fafc;
    }
    .card-thumb {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }
    .product-card:hover .card-thumb {
        transform: scale(1.05);
    }
    .card-badge {
        position: absolute;
        top: 8px; right: 8px;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(8px);
        padding: 2px 8px;
        border-radius: 50px;
        font-size: 8px;
        font-weight: 800;
        color: #10b981;
        border: 1px solid rgba(16, 185, 129, 0.1);
    }
    .card-body-p {
        padding: 12px;
    }
    .seller-info {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 8px;
    }
    .seller-avatar {
        width: 18px; height: 18px;
        border-radius: 50%;
        background: #f1f5f9;
        display: flex; align-items: center; justify-content: center;
        font-size: 8px; font-weight: 700; color: #64748b;
        border: 1px solid #e2e8f0;
    }
    .seller-name-text {
        font-size: 10px; font-weight: 600; color: #64748b;
    }
    .prod-name-p {
        font-size: 13px;
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 8px;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 2.6em;
    }
    .price-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-top: 8px;
    }
    .price-label { font-size: 8px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; }
    .price-val { font-size: 14px; font-weight: 900; color: #1e293b; }
    
    .comm-box {
        margin-top: 10px;
        padding: 8px;
        background: #f0fdf4;
        border-radius: 10px;
        border: 1px dashed #10b981;
    }
    .comm-label-p { font-size: 8px; font-weight: 800; color: #059669; text-transform: uppercase; margin-bottom: 1px; }
    .comm-val-p { font-size: 12px; font-weight: 900; color: #064e3b; }

    .btn-preview {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        width: 100%;
        margin-top: 12px;
        padding: 8px;
        background: #111827;
        color: #fff;
        text-decoration: none;
        border-radius: 10px;
        font-size: 11px;
        font-weight: 700;
        transition: 0.2s;
    }
    .btn-preview:hover {
        background: #10b981;
    }

    /* Filters */
    .search-container {
        background: #fff;
        padding: 16px 20px;
        border-radius: 16px;
        border: 1px solid #e5e7eb;
        margin-bottom: 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }
    .search-input-w {
        position: relative;
        flex: 1;
        min-width: 240px;
    }
    .search-input-w i {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 12px;
    }
    .search-input {
        width: 100%;
        padding: 10px 14px 10px 38px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        font-size: 13px;
        outline: none;
        transition: 0.2s;
    }
    .search-input:focus {
        border-color: #10b981;
        background: #fff;
        box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.05);
    }
</style>

<div class="search-container">
    <div>
        <h4 style="font-weight: 900; color: #111827; margin-bottom: 4px;">Marketplace Produk</h4>
        <p style="font-size: 13px; color: #64748b; margin: 0;">Temukan produk terbaik untuk dipromosikan</p>
    </div>
    <form action="/admin/marketplace" method="GET" class="search-input-w">
        <i class="fas fa-search"></i>
        <input type="text" name="search" class="search-input" placeholder="Cari nama produk atau kategori..." value="<%= pagination.search %>">
    </form>
</div>

<div class="market-grid">
    <% if (products && products.length > 0) { %>
        <% products.forEach(p => { %>
            <div class="product-card">
                <div class="card-thumb-w">
                    <img src="<%= img(p.thumb) %>" class="card-thumb" onerror="this.src='/images/placeholder.png'">
                    <div class="card-badge"><%= p.product_type || 'DIGITAL' %></div>
                </div>
                <div class="card-body-p">
                    <div class="seller-info">
                        <div class="seller-avatar"><%= (p.seller_name || 'A').charAt(0) %></div>
                        <div class="seller-name-text">@<%= p.seller_slug %></div>
                    </div>
                    <h3 class="prod-name-p"><%= p.name %></h3>
                    
                    <div class="price-row">
                        <div>
                            <div class="price-label">Harga Jual</div>
                            <div class="price-val"><%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(p.price) %></div>
                        </div>
                    </div>

                    <div class="comm-box">
                        <div class="comm-label-p">Komisi <%= parseFloat(p.commission_percent || 20) %>%</div>
                        <div class="comm-val-p">Rp <%= new Intl.NumberFormat('id-ID', { maximumFractionDigits: 0 }).format((p.price * (p.commission_percent || 20)) / 100) %></div>
                    </div>

                    <a href="/p/<%= p.id %>" target="_blank" class="btn-preview">
                        <i class="fas fa-external-link-alt"></i> Preview Produk
                    </a>
                </div>
            </div>
        <% }) %>
    <% } else { %>
        <div style="grid-column: 1/-1; text-align: center; padding: 100px 20px; background: #fff; border-radius: 20px; border: 1px dashed #e2e8f0;">
            <img src="https://cdn-icons-png.flaticon.com/512/7486/7486744.png" style="width: 80px; opacity: 0.3; margin-bottom: 20px;">
            <h5 style="color: #94a3b8; font-weight: 700;">Belum ada produk di marketplace</h5>
        </div>
    <% } %>
</div>

<% if (pagination.totalPages > 1) { %>
    <div style="margin-top: 40px; display: flex; justify-content: center; gap: 8px;">
        <% for(let i=1; i<=pagination.totalPages; i++) { %>
            <a href="/admin/marketplace?page=<%= i %>&search=<%= pagination.search %>" 
               style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 12px; background: <%= pagination.page == i ? '#111827' : '#fff' %>; color: <%= pagination.page == i ? '#fff' : '#64748b' %>; text-decoration: none; font-weight: 700; border: 1px solid <%= pagination.page == i ? '#111827' : '#e5e7eb' %>; transition: 0.2s;">
                <%= i %>
            </a>
        <% } %>
    </div>
<% } %>
