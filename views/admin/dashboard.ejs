<%
    const s = stats || {};
    const totalRevenue = parseFloat(s.total_revenue || 0);
    const balance = parseFloat(s.balance || 0);
    const totalSales = parseInt(s.total_sales || 0);
    const totalProducts = parseInt(s.total_products || 0);
    const todaySales = parseFloat(s.today_sales || 0);
    const platformSales = parseFloat(s.platform_sales || 0);
    const userSlug = s.slug || 'username';
%>

<style>
.dash-cards-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: 10px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px -1px rgba(0, 0, 0, 0.01);
}
.dash-cards-row > div:not(:last-child) {
    border-right: 1px solid #f1f5f9;
    padding-right: 16px;
}
.dash-stat-card {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 14px;
    transition: all 0.2s ease;
    box-shadow: none;
    min-width: 0;
}
.dash-stat-icon {
    width: 42px; height: 42px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
}
.dash-stat-icon.green  { background: #ecfdf5; color: #059669; }
.dash-stat-icon.blue   { background: #eff6ff; color: #2563eb; }
.dash-stat-icon.amber  { background: #fffbeb; color: #d97706; }
.dash-stat-icon.purple { background: #f5f3ff; color: #7c3aed; }
.dash-stat-icon.gray   { background: #f8fafc; color: #475569; }

.dash-stat-info { flex: 1; min-width: 0; }
.dash-stat-label {
    font-size: 11px;
    font-weight: 700;
    color: #64748b;
    margin-bottom: 4px;
}
.dash-stat-value {
    font-size: 17px;
    font-weight: 600;
    color: #0f172a;
    letter-spacing: -0.3px;
    line-height: 1.2;
    display: flex;
    align-items: baseline;
    gap: 2px;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
}
.dash-stat-value small {
    font-size: 11px;
    opacity: 0.5;
    font-weight: 700;
}
.dash-stat-sub {
    font-size: 11px;
    font-weight: 700;
    color: #94a3b8;
}

@media (max-width: 1400px) { .dash-cards-row { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; } }
@media (max-width: 1200px) {
    .dash-cards-row { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; }
    .dash-cards-row > div { padding-bottom: 16px; margin-bottom: 16px; }
    .dash-cards-row > div:nth-child(odd) { border-right: 1px solid #f1f5f9; padding-right: 16px; }
    .dash-cards-row > div:nth-child(even) { border-right: none; padding-right: 0; padding-left: 16px; }
    .dash-cards-row > div:nth-child(1), .dash-cards-row > div:nth-child(2) { border-bottom: 1px solid #f1f5f9; }
    .dash-cards-row > div:nth-child(3), .dash-cards-row > div:nth-child(4) { padding-bottom: 0; margin-bottom: 0; border-bottom: none; }
}
@media (max-width: 640px) {
    .dash-cards-row { grid-template-columns: minmax(0, 1fr); gap: 0; padding: 20px; }
    .dash-cards-row > div { border-right: none !important; padding-right: 0 !important; padding-left: 0 !important; padding-bottom: 16px; margin-bottom: 16px; border-bottom: 1px solid #e2e8f0; }
    .dash-cards-row > div:last-child { border-bottom: none; padding-bottom: 0; margin-bottom: 0; }
    .dash-stat-card { padding: 0; }
    .dash-stat-value { font-size: 15px !important; }
    .dash-stat-icon { width: 36px; height: 36px; font-size: 14px; }
}
@media (max-width: 480px) { 
    .dash-stat-value { font-size: 15px !important; } 
    .dash-stat-card { padding: 12px; }
}

/* BIO LINK CARD ENHANCEMENT */
.bio-card {
    background: #fff;
    border: 1px solid #f1f5f9;
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
}
.bio-input-group {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
}
.bio-input-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    padding: 10px 18px;
    transition: all 0.2s;
}
.bio-input-wrap:focus-within {
    border-color: #3b82f6;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}
.bio-btn {
    padding: 11px 20px;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1.5px solid #e2e8f0;
    background: #fff;
    color: #475569;
}
.bio-btn:hover { background: #f8fafc; border-color: #cbd5e1; }
.bio-btn.primary { background: #3b82f6; color: #fff; border: none; }
.bio-btn.primary:hover { background: #2563eb; }
</style>

