<!-- CHART -->
<div class="bio-card" style="padding: 24px; margin-top: 24px;">
    <div style="font-size: 11px; font-weight: 800; color: #1e293b; letter-spacing: 0.5px; margin-bottom: 16px; display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
