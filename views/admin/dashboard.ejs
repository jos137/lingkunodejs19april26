<%
    const s = stats || {};
    const totalRevenue = parseFloat(s.total_revenue || 0);
    const balance = parseFloat(s.balance || 0);
    const totalSales = parseInt(s.total_sales || 0);
    const totalProducts = parseInt(s.total_products || 0);
    const todaySales = parseFloat(s.today_sales || 0);
    const platformSales = parseFloat(s.platform_sales || 0);
    const userSlug = s.slug || 'username';
%>

<style>
.dash-cards-row {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    margin-top: 10px;
}
.dash-stat-card {
    background: #fff;
    border: 1px solid #f1f5f9;
    border-radius: 12px;
    padding: 16px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
}
.dash-stat-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08);
}
.dash-stat-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
}
.dash-stat-card:nth-child(1)::before { background: #10b981; }
.dash-stat-card:nth-child(2)::before { background: #3b82f6; }
.dash-stat-card:nth-child(3)::before { background: #f59e0b; }
.dash-stat-card:nth-child(4)::before { background: #8b5cf6; }
.dash-stat-card:nth-child(5)::before { background: #64748b; }

.dash-stat-label {
    font-size: 10px;
    font-weight: 800;
    color: #94a3b8;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
    text-transform: uppercase;
}
.dash-stat-value {
    font-size: 18px;
    font-weight: 600;
    color: #111827;
    letter-spacing: -0.2px;
    line-height: 1.2;
    display: flex;
    align-items: baseline;
    gap: 3px;
}
.dash-stat-card:nth-child(1) .dash-stat-value { color: #10b981; }
.dash-stat-card:nth-child(2) .dash-stat-value { color: #3b82f6; }
.dash-stat-card:nth-child(3) .dash-stat-value { color: #f59e0b; }
.dash-stat-card:nth-child(4) .dash-stat-value { color: #8b5cf6; }
.dash-stat-card:nth-child(5) .dash-stat-value { color: #64748b; }

.dash-stat-value small {
    font-size: 0.65em;
    color: inherit;
    opacity: 0.7;
    font-weight: 600;
}
.dash-stat-sub {
    font-size: 12px;
    font-weight: 700;
    color: inherit;
    opacity: 0.7;
}

@media (max-width: 1400px) { .dash-cards-row { grid-template-columns: repeat(5, 1fr); gap: 8px; } }
@media (max-width: 1200px) { .dash-cards-row { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 1024px) { .dash-cards-row { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 640px) { .dash-cards-row { grid-template-columns: repeat(2, 1fr); gap: 8px; } }
@media (max-width: 480px) { 
    .dash-stat-value { font-size: 15px !important; } 
    .dash-stat-card { padding: 12px; }
}

/* BIO LINK CARD ENHANCEMENT */
.bio-card {
    background: #fff;
    border: 1px solid #f1f5f9;
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
}
.bio-input-group {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
}
.bio-input-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    padding: 10px 18px;
    transition: all 0.2s;
}
.bio-input-wrap:focus-within {
    border-color: #3b82f6;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}
.bio-btn {
    padding: 11px 20px;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1.5px solid #e2e8f0;
    background: #fff;
    color: #475569;
}
.bio-btn:hover { background: #f8fafc; border-color: #cbd5e1; }
.bio-btn.primary { background: #3b82f6; color: #fff; border: none; }
.bio-btn.primary:hover { background: #2563eb; }
</style>

<!-- YOUR BIO LINK RE-WORKED FOR RESPONSIVE -->
<div class="bio-row-container" style="display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; margin-bottom: 24px;">
    <% if (locals.features && features.show_today_sales) { %>
        <!-- FEATURE: PENJUALAN HARI INI (Controlled by Feature Flag) -->
        <div class="bio-card" style="width: 320px; background: linear-gradient(135deg, #10b981, #059669); border: none; position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: center; min-height: 120px;">
            <!-- ORNAMEN UANG (SILUET) -->
            <i class="fas fa-money-bill-wave" style="position: absolute; right: -20px; bottom: -20px; font-size: 120px; color: rgba(255,255,255,0.12); transform: rotate(-15deg);"></i>
            
            <div style="position: relative; z-index: 2;">
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
                    <div style="width: 32px; height: 32px; background: rgba(255,255,255,0.2); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white;">
                        <i class="fas fa-coins"></i>
                    </div>
                    <div style="font-size: 10px; font-weight: 800; color: rgba(255,255,255,0.85); letter-spacing: 1px; text-transform: uppercase;">PENJUALAN HARI INI</div>
                </div>
                <div style="font-size: 26px; font-weight: 700; color: white; display: flex; align-items: baseline; gap: 4px;">
                    <small style="font-size: 14px; opacity: 0.8; font-weight: 600;">Rp</small>
                    <%= todaySales.toLocaleString('id-ID') %>
                </div>

            </div>
        </div>
    <% } %>

    <div class="bio-card" style="flex: 1; min-width: 300px; margin: 0;">
        <div style="font-size: 11px; font-weight: 800; color: #64748b; letter-spacing: 1px; margin-bottom: 12px; text-transform: uppercase;">LINK BIO ANDA</div>
        <div class="bio-input-group">
            <div class="bio-input-wrap">
                <span style="color:#94a3b8; font-size:14px; font-weight:600;">lingku.xyz/</span>
                <input type="text" id="slugInput" value="<%= userSlug %>" 
                    style="border:none; outline:none; background:transparent; font-size:14px; font-weight:800; color:#111827; flex:1; font-family:inherit;">
            </div>
            <button onclick="updateSlug()" class="bio-btn primary">Update</button>
            <button onclick="window.open('/' + document.getElementById('slugInput').value, '_blank')" class="bio-btn" title="Open Link">
                <i class="fas fa-external-link-alt"></i>
            </button>
            <button onclick="copyLink()" class="bio-btn" title="Copy Link">
                <i class="fas fa-copy" style="color:#10b981;"></i>
            </button>
        </div>
    </div>
</div>

<style>
    @media (max-width: 640px) {
        .bio-row-container { flex-direction: column-reverse !important; gap: 12px !important; margin-bottom: 16px !important; }
        .bio-card { width: 100% !important; min-width: 100% !important; padding: 18px !important; }
        .bio-input-group { flex-wrap: wrap; gap: 8px !important; }
        .bio-input-wrap { width: 100% !important; flex: none !important; padding: 8px 12px !important; }
        .bio-btn { flex: 1; justify-content: center; padding: 10px 5px !important; font-size: 11px !important; }
        .bio-btn.primary { flex: 2; } /* Update button gets more space */
        .bio-input-wrap span { font-size: 11px !important; }
        .bio-input-wrap input { font-size: 13px !important; }
        .dash-stat-value { font-size: 16px !important; }
        .dash-stat-label { font-size: 9px !important; }
    }
</style>

<!-- STAT CARDS -->
<div class="dash-cards-row">
    <div class="dash-stat-card">
        <div class="dash-stat-label">Total Revenue</div>
        <div class="dash-stat-value"><small>Rp</small><%= totalRevenue.toLocaleString('id-ID') %></div>
    </div>
    <div class="dash-stat-card">
        <div class="dash-stat-label">Saldo Tersedia</div>
        <div class="dash-stat-value"><small>Rp</small><%= balance.toLocaleString('id-ID') %></div>
    </div>
    <div class="dash-stat-card">
        <div class="dash-stat-label">Total Sales (Qty)</div>
        <div class="dash-stat-value"><%= totalSales %> <span class="dash-stat-sub">Items</span></div>
    </div>
    <div class="dash-stat-card">
        <div class="dash-stat-label">Jumlah Produk</div>
        <div class="dash-stat-value"><%= totalProducts %> <span class="dash-stat-sub">Katalog</span></div>
    </div>
    <% if (user.role === 'admin') { %>
    <div class="dash-stat-card">
        <div class="dash-stat-label">Penjualan Platform</div>
        <div class="dash-stat-value"><small>Rp</small><%= platformSales.toLocaleString('id-ID') %></div>
    </div>
    <% } %>
</div>

<!-- CHART -->
<div class="bio-card" style="padding: 24px; margin-top: 24px;">
    <div style="font-size: 11px; font-weight: 800; color: #1e293b; letter-spacing: 0.5px; margin-bottom: 16px;">
        <i class="fas fa-chart-line" style="color:#3b82f6;"></i> SALES PERFORMANCE
        <% if (locals.filterMonth) { %>
            (<%= new Date(filterMonth + '-01').toLocaleDateString('id-ID', { month: 'long', year: 'numeric' }).toUpperCase() %>)
        <% } else if (locals.filterDate) { %>
            (<%= new Date(filterDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).toUpperCase() %>)
        <% } else { %>
            (LAST 30 DAYS)
        <% } %>
    </div>
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
        <div style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 14px 32px; text-align: center; min-width: 200px;">
            <div style="font-size: 10px; font-weight: 700; color: #94a3b8; letter-spacing: 0.5px; margin-bottom: 4px;">TOTAL PENDAPATAN</div>
            <div style="display: flex; align-items: baseline; justify-content: center; gap: 3px;">
                <span style="font-size: 12px; font-weight: 700; color: #3b82f6;">Rp</span>
                <span style="font-size: 22px; font-weight: 800; color: #3b82f6; letter-spacing: -0.5px;"><%= (chartTotal || 0).toLocaleString('id-ID') %></span>
            </div>
        </div>
        <div style="display: flex; align-items: center; gap: 4px;">
            <% var activeMode = locals.filterMonth ? 'month' : 'date'; %>
            <div style="display: flex; background: #f1f5f9; border-radius: 8px; padding: 2px;">
                <span id="mDateBtn" onclick="switchMode('date')" style="padding:4px 10px; border-radius:6px; font-size:10px; font-weight:700; cursor:pointer; background:<%= activeMode==='date'?'#fff':'transparent' %>; color:<%= activeMode==='date'?'#1e293b':'#64748b' %>; transition:all 0.15s;">Harian</span>
                <span id="mMonthBtn" onclick="switchMode('month')" style="padding:4px 10px; border-radius:6px; font-size:10px; font-weight:700; cursor:pointer; background:<%= activeMode==='month'?'#fff':'transparent' %>; color:<%= activeMode==='month'?'#1e293b':'#64748b' %>; transition:all 0.15s;">Bulanan</span>
            </div>
            <div id="filterCtrl" style="display:flex;">
                <input type="date" id="dateInput" value="<%= locals.filterDate || '' %>"
                    style="padding:6px 10px; border:1.5px solid #e2e8f0; border-radius:8px; font-size:11px; font-weight:700; color:#334155; outline:none; background:#f8fafc; cursor:pointer; <%= activeMode==='month'?'display:none':'' %>">
                <select id="monthInput" style="padding:6px 10px; border:1.5px solid #e2e8f0; border-radius:8px; font-size:11px; font-weight:700; color:#334155; outline:none; background:#f8fafc; cursor:pointer; <%= activeMode==='date'?'display:none':'' %>">
                    <option value="">-- Bulan --</option>
                    <% 
                    var nowM = new Date();
                    for (var iM = 0; iM < 12; iM++) {
                        var dM = new Date(nowM.getFullYear(), nowM.getMonth() - iM, 1);
                        var vM = dM.getFullYear() + '-' + String(dM.getMonth() + 1).padStart(2, '0');
                        var lM = dM.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
                    %>
                    <option value="<%= vM %>" <%= locals.filterMonth === vM ? 'selected' : '' %>><%= lM %></option>
                    <% } %>
                </select>
            </div>
            <% if (locals.filterDate || locals.filterMonth) { %>
                <button onclick="window.location.href='/admin'" style="border:none; background:#f1f5f9; color:#64748b; width:28px; height:28px; border-radius:8px; cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:12px;" title="Reset">
                    <i class="fas fa-times"></i>
                </button>
            <% } %>
        </div>
        <script>
        function switchMode(mode) {
            document.getElementById('mDateBtn').style.background = mode === 'date' ? '#fff' : 'transparent';
            document.getElementById('mDateBtn').style.color = mode === 'date' ? '#1e293b' : '#64748b';
            document.getElementById('mMonthBtn').style.background = mode === 'month' ? '#fff' : 'transparent';
            document.getElementById('mMonthBtn').style.color = mode === 'month' ? '#1e293b' : '#64748b';
            document.getElementById('dateInput').style.display = mode === 'date' ? '' : 'none';
            document.getElementById('monthInput').style.display = mode === 'month' ? '' : 'none';
        }
        document.getElementById('dateInput').addEventListener('change', function() {
            if (this.value) window.location.href = '/admin?date=' + this.value;
        });
        document.getElementById('monthInput').addEventListener('change', function() {
            if (this.value) window.location.href = '/admin?month=' + this.value; else window.location.href = '/admin';
        });
        </script>
    </div>
    <div class="dash-chart-container" style="height: 320px; position: relative;">
        <canvas id="dashChart"></canvas>
    </div>
</div>

<style>
    @media (max-width: 640px) {
        .dash-chart-container { height: 240px !important; }
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const labels = [];
    const dataVals = [];
    <% (chartData || []).forEach(function(d) { %>
        labels.push('<%= new Date(d.date).toLocaleDateString("id-ID", { day:"numeric", month:"short" }) %>');
        dataVals.push(<%= d.revenue || 0 %>);
    <% }); %>

    const isFiltered = '<%= locals.filterDate || locals.filterMonth %>';
    const chartType = isFiltered ? 'bar' : 'line';
    const grad = document.getElementById('dashChart').getContext('2d').createLinearGradient(0, 0, 0, 320);
    grad.addColorStop(0, 'rgba(16,185,129,0.30)');
    grad.addColorStop(0.5, 'rgba(16,185,129,0.08)');
    grad.addColorStop(1, 'rgba(16,185,129,0.01)');
    
    new Chart(document.getElementById('dashChart').getContext('2d'), {
        type: chartType,
        data: {
            labels: labels,
            datasets: [{
                label: 'Revenue',
                data: dataVals,
                borderColor: '#10b981',
                backgroundColor: chartType === 'bar' ? function(ctx) {
                    const ca = ctx.chart.chartArea;
                    if (!ca) return '#10b981';
                    var g = ctx.chart.ctx.createLinearGradient(0, ca.bottom, 0, ca.top);
                    g.addColorStop(0, '#065f46');
                    g.addColorStop(0.5, '#10b981');
                    g.addColorStop(1, '#6ee7b7');
                    return g;
                } : grad,
                fill: true,
                tension: 0.35,
                borderWidth: chartType === 'bar' ? 0 : 3,
                borderRadius: chartType === 'bar' ? 6 : 0,
                maxBarThickness: chartType === 'bar' ? 36 : undefined,
                barPercentage: chartType === 'bar' ? 0.6 : 1,
                categoryPercentage: chartType === 'bar' ? 0.8 : 1,
                pointRadius: chartType === 'bar' ? 0 : ctx => Math.abs(ctx.parsed.y) > 0 ? 4 : 0,
                pointBackgroundColor: '#fff',
                pointBorderColor: '#10b981',
                pointBorderWidth: 2.5,
                pointHoverRadius: 6,
                pointHoverBorderWidth: 3,
                hoverBackgroundColor: '#10b981'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            animation: {
                duration: 800,
                easing: 'easeOutQuart'
            },
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#0f172a',
                    titleFont: { size: 11, weight: '700' },
                    bodyFont: { size: 13, weight: '700' },
                    padding: { top: 10, bottom: 10, left: 14, right: 14 },
                    cornerRadius: 10,
                    boxPadding: 6,
                    usePointStyle: true,
                    callbacks: {
                        label: ctx => 'Rp ' + ctx.parsed.y.toLocaleString('id-ID')
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: { 
                        font: { size: 11, weight: '600' }, 
                        color: '#94a3b8',
                        maxRotation: 45
                    }
                },
                y: {
                    min: 0,
                    grid: { 
                        color: '#f1f5f9', 
                        drawBorder: false 
                    },
                    ticks: {
                        font: { size: 11, weight: '600' },
                        color: '#94a3b8',
                        padding: 8,
                        callback: v => v >= 1000000 ? (v/1000000).toFixed(1) + 'M' : v >= 1000 ? (v/1000) + 'K' : v
                    }
                }
            },
            elements: {
                bar: {
                    borderSkipped: false,
                    borderRadius: { topLeft: 6, topRight: 6, bottomLeft: 0, bottomRight: 0 }
                }
            }
        }
    });

    function copyLink() {
        const slug = document.getElementById('slugInput').value;
        navigator.clipboard.writeText('https://lingku.xyz/' + slug);
        alert('Link disalin!');
    }

    async function updateSlug() {
        const slug = document.getElementById('slugInput').value;
        if (!slug) return alert('Slug tidak boleh kosong.');
        
        try {
            const res = await fetch('/admin/update-slug', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ slug })
            });
            const d = await res.json();
            if (d.success) {
                alert('Slug berhasil diperbarui!');
                location.reload(); // Reload to sync header and other parts
            } else {
                alert(d.message || 'Gagal update slug.');
            }
        } catch(e) {
            alert('Terjadi kesalahan sistem.');
        }
    }
</script>
