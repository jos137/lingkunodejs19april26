</div>

<!-- CHART -->
<div class="bio-card dash-performance" style="padding: 24px; margin-top: 24px;">
    <div style="font-size: 11px; font-weight: 800; color: #1e293b; letter-spacing: 0.5px; margin-bottom: 16px; display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
        <span><i class="fas fa-chart-line" style="color:#3b82f6;"></i> PERFORMA PENJUALAN
        <% if (locals.filterMonth) { %>
            (<%= new Date(filterMonth + '-01').toLocaleDateString('id-ID', { month: 'long', year: 'numeric' }).toUpperCase() %>)
        <% } else if (locals.filterDate) { %>
            (<%= new Date(filterDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).toUpperCase() %>)
        <% } else { %>
            (30 HARI TERAKHIR)
        <% } %>
        </span>
        <span style="display:inline-flex;background:#f1f5f9;border-radius:9px;padding:3px;gap:3px;">
            <button type="button" id="chartProductTab" onclick="switchChart('product')" style="border:0;padding:6px 10px;border-radius:7px;background:#fff;color:#1e293b;font-size:10px;font-weight:800;cursor:pointer;box-shadow:0 1px 3px rgba(15,23,42,.08);">Penjualan Produk</button>
            <% if (user && user.role === 'admin') { %>
                <button type="button" id="chartPlatformTab" onclick="switchChart('platform')" style="border:0;padding:6px 10px;border-radius:7px;background:transparent;color:#64748b;font-size:10px;font-weight:800;cursor:pointer;">Penjualan Platform</button>
            <% } %>
        </span>
        <span style="display: inline-flex; align-items: center; gap: 6px; font-size: 10px; font-weight: 700; color: #64748b;">
            <span id="primaryLegendDot" style="width: 10px; height: 10px; border-radius: 50%; background: #10b981; display: inline-block;"></span> <span id="primaryLegendLabel">Revenue</span>
        </span>
        <span style="display: inline-flex; align-items: center; gap: 6px; font-size: 10px; font-weight: 700; color: #64748b;">
            <span id="secondaryLegendDot" style="width: 10px; height: 10px; border-radius: 50%; background: #f97316; display: inline-block;"></span> <span id="secondaryLegendLabel">Visitor</span>
        </span>
    </div>
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
        <div style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 14px 32px; text-align: center; min-width: 200px;">
            <div style="font-size: 10px; font-weight: 700; color: #94a3b8; letter-spacing: 0.5px; margin-bottom: 4px;">TOTAL PENDAPATAN</div>
            <div style="display: flex; align-items: baseline; justify-content: center; gap: 3px;">
                <span style="font-size: 12px; font-weight: 700; color: #3b82f6;">Rp</span>
                <span id="chartTotalValue" style="font-size: 22px; font-weight: 800; color: #3b82f6; letter-spacing: -0.5px;"><%= (chartTotal || 0).toLocaleString('id-ID') %></span>
            </div>
        </div>
        <div style="display: flex; align-items: center; gap: 4px;">
            <% var activeMode = locals.filterMonth ? 'month' : 'date'; %>
            <div style="display: flex; background: #f1f5f9; border-radius: 8px; padding: 2px;">
                <span id="mDateBtn" onclick="switchMode('date')" style="padding:4px 10px; border-radius:6px; font-size:10px; font-weight:700; cursor:pointer; background:<%= activeMode==='date'?'#fff':'transparent' %>; color:<%= activeMode==='date'?'#1e293b':'#64748b' %>; transition:all 0.15s;">Harian</span>
                <span id="mMonthBtn" onclick="switchMode('month')" style="padding:4px 10px; border-radius:6px; font-size:10px; font-weight:700; cursor:pointer; background:<%= activeMode==='month'?'#fff':'transparent' %>; color:<%= activeMode==='month'?'#1e293b':'#64748b' %>; transition:all 0.15s;">Bulanan</span>
            </div>
            <div id="filterCtrl" style="display:flex;">
                <input type="date" id="dateInput" value="<%= locals.filterDate || '' %>"
                    style="padding:6px 10px; border:1.5px solid #e2e8f0; border-radius:8px; font-size:11px; font-weight:700; color:#334155; outline:none; background:#f8fafc; cursor:pointer; <%= activeMode==='month'?'display:none':'' %>">
                <select id="monthInput" style="padding:6px 10px; border:1.5px solid #e2e8f0; border-radius:8px; font-size:11px; font-weight:700; color:#334155; outline:none; background:#f8fafc; cursor:pointer; <%= activeMode==='date'?'display:none':'' %>">
                    <option value="">-- Bulan --</option>
                    <%
                    var nowM = new Date();
                    for (var iM = 0; iM < 12; iM++) {
                        var dM = new Date(nowM.getFullYear(), nowM.getMonth() - iM, 1);
                        var vM = dM.getFullYear() + '-' + String(dM.getMonth() + 1).padStart(2, '0');
                        var lM = dM.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
                    %>
                    <option value="<%= vM %>" <%= locals.filterMonth === vM ? 'selected' : '' %>><%= lM %></option>
                    <% } %>
                </select>
            </div>
            <% if (locals.filterDate || locals.filterMonth) { %>
                <button onclick="window.location.href='/admin'" style="border:none; background:#f1f5f9; color:#64748b; width:28px; height:28px; border-radius:8px; cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:12px;" title="Reset">
                    <i class="fas fa-times"></i>
                </button>
            <% } %>
        </div>
        <script>
        function switchMode(mode) {
            document.getElementById('mDateBtn').style.background = mode === 'date' ? '#fff' : 'transparent';
            document.getElementById('mDateBtn').style.color = mode === 'date' ? '#1e293b' : '#64748b';
            document.getElementById('mMonthBtn').style.background = mode === 'month' ? '#fff' : 'transparent';
            document.getElementById('mMonthBtn').style.color = mode === 'month' ? '#1e293b' : '#64748b';
            document.getElementById('dateInput').style.display = mode === 'date' ? '' : 'none';
            document.getElementById('monthInput').style.display = mode === 'month' ? '' : 'none';
        }
        document.getElementById('dateInput').addEventListener('change', function() {
            if (this.value) window.location.href = '/admin?date=' + this.value;
        });
        document.getElementById('monthInput').addEventListener('change', function() {
            if (this.value) window.location.href = '/admin?month=' + this.value; else window.location.href = '/admin';
        });
        </script>
    </div>
    <div class="dash-chart-container" style="height: 320px; position: relative;">
        <canvas id="dashChart"></canvas>
    </div>
</div>

<style>
    @media (max-width: 640px) {
        .dash-chart-container { height: 240px !important; }
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const labels = [];
    const dataVals = [];
    const visitorVals = [];
    const platformLabels = [];
    const platformDataVals = [];
    const platformRenewalVals = [];
    <% (chartData || []).forEach(function(d) { %>
        labels.push('<%= new Date(d.date).toLocaleDateString("id-ID", { day:"numeric", month:"short" }) %>');
        dataVals.push(<%= d.revenue || 0 %>);
        visitorVals.push(<%= d.visitors || 0 %>);
    <% }); %>
    <% (platformChartData || []).forEach(function(d) { %>
        platformLabels.push('<%= new Date(d.date).toLocaleDateString("id-ID", { day:"numeric", month:"short" }) %>');
        platformDataVals.push(<%= d.revenue || 0 %>);
        platformRenewalVals.push(<%= d.renewal_revenue || 0 %>);
    <% }); %>

    const isFiltered = '<%= locals.filterDate || locals.filterMonth %>';
    const chartType = isFiltered ? 'bar' : 'line';
    const grad = document.getElementById('dashChart').getContext('2d').createLinearGradient(0, 0, 0, 320);
    grad.addColorStop(0, 'rgba(16,185,129,0.30)');
    grad.addColorStop(0.5, 'rgba(16,185,129,0.08)');
    grad.addColorStop(1, 'rgba(16,185,129,0.01)');

    let dashChart = new Chart(document.getElementById('dashChart').getContext('2d'), {
        type: chartType,
        data: {
            labels: labels,
            datasets: [{
                label: 'Revenue',
                data: dataVals,
                borderColor: '#10b981',
                backgroundColor: chartType === 'bar' ? function(ctx) {
                    const ca = ctx.chart.chartArea;
                    if (!ca) return '#10b981';
                    var g = ctx.chart.ctx.createLinearGradient(0, ca.bottom, 0, ca.top);
                    g.addColorStop(0, '#065f46');
                    g.addColorStop(0.5, '#10b981');
                    g.addColorStop(1, '#6ee7b7');
                    return g;
                } : grad,
                fill: true,
                tension: 0.35,
                borderWidth: chartType === 'bar' ? 0 : 3,
                borderRadius: chartType === 'bar' ? 6 : 0,
                maxBarThickness: chartType === 'bar' ? 36 : undefined,
                barPercentage: chartType === 'bar' ? 0.6 : 1,
                categoryPercentage: chartType === 'bar' ? 0.8 : 1,
                pointRadius: chartType === 'bar' ? 0 : ctx => Math.abs(ctx.parsed.y) > 0 ? 4 : 0,
                pointBackgroundColor: '#fff',
                pointBorderColor: '#10b981',
                pointBorderWidth: 2.5,
                pointHoverRadius: 6,
                pointHoverBorderWidth: 3,
                hoverBackgroundColor: '#10b981'
            },
            {
                label: 'Visitor',
                data: visitorVals,
                borderColor: '#f97316',
                backgroundColor: chartType === 'bar' ? '#fdba74' : 'rgba(249,115,22,0.12)',
                fill: chartType === 'bar' ? true : true,
                tension: 0.35,
                borderWidth: chartType === 'bar' ? 0 : 2.5,
                borderRadius: chartType === 'bar' ? 6 : 0,
                maxBarThickness: chartType === 'bar' ? 36 : undefined,
                yAxisID: 'y1',
                pointRadius: chartType === 'bar' ? 0 : 3,
                pointBackgroundColor: '#fff',
                pointBorderColor: '#f97316',
                pointBorderWidth: 2,
                pointHoverRadius: 5,
                hoverBackgroundColor: '#f97316'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            animation: {
                duration: 800,
                easing: 'easeOutQuart'
            },
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#0f172a',
                    titleFont: { size: 11, weight: '700' },
                    bodyFont: { size: 13, weight: '700' },
                    padding: { top: 10, bottom: 10, left: 14, right: 14 },
                    cornerRadius: 10,
                    boxPadding: 6,
                    usePointStyle: true,
                    callbacks: {
                        label: ctx => ctx.dataset.label === 'Visitor'
                            ? 'Visitor: ' + ctx.parsed.y + ' orang'
                            : 'Rp ' + ctx.parsed.y.toLocaleString('id-ID')
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: {
                        font: { size: 11, weight: '600' },
                        color: '#94a3b8',
                        maxRotation: 45
                    }
                },
                y: {
                    type: 'linear',
                    position: 'left',
                    min: 0,
                    grid: {
                        color: '#f1f5f9',
                        drawBorder: false
                    },
                    ticks: {
                        font: { size: 11, weight: '600' },
                        color: '#94a3b8',
                        padding: 8,
                        callback: v => v >= 1000000 ? (v/1000000).toFixed(1) + 'M' : v >= 1000 ? (v/1000) + 'K' : v
                    }
                },
                y1: {
                    type: 'linear',
                    position: 'right',
                    min: 0,
                    grid: { display: false, drawBorder: false },
                    ticks: {
                        font: { size: 11, weight: '600' },
                        color: '#fb923c',
                        padding: 8,
                        precision: 0
                    }
                }
            },
            elements: {
                bar: {
                    borderSkipped: false,
                    borderRadius: { topLeft: 6, topRight: 6, bottomLeft: 0, bottomRight: 0 }
                }
            }
        }
    });

    function switchChart(mode) {
        const isPlatform = mode === 'platform';
        dashChart.data.labels = isPlatform ? platformLabels : labels;
        dashChart.data.datasets[0].data = isPlatform ? platformDataVals : dataVals;
        dashChart.data.datasets[0].label = isPlatform ? 'Penjualan Platform' : 'Revenue';
        dashChart.data.datasets[0].borderColor = isPlatform ? '#7c3aed' : '#10b981';
        dashChart.data.datasets[0].pointBorderColor = isPlatform ? '#7c3aed' : '#10b981';
        dashChart.data.datasets[0].hoverBackgroundColor = isPlatform ? '#7c3aed' : '#10b981';
        dashChart.data.datasets[0].backgroundColor = isPlatform ? 'rgba(124,58,237,0.16)' : grad;
        dashChart.data.datasets[1].data = isPlatform ? platformRenewalVals : visitorVals;
        dashChart.data.datasets[1].label = isPlatform ? 'Renewal PRO' : 'Visitor';
        dashChart.data.datasets[1].borderColor = isPlatform ? '#ec4899' : '#f97316';
        dashChart.data.datasets[1].pointBorderColor = isPlatform ? '#ec4899' : '#f97316';
        dashChart.data.datasets[1].hoverBackgroundColor = isPlatform ? '#ec4899' : '#f97316';
        dashChart.data.datasets[1].backgroundColor = isPlatform ? 'rgba(236,72,153,0.14)' : (chartType === 'bar' ? '#fdba74' : 'rgba(249,115,22,0.12)');
        dashChart.data.datasets[1].yAxisID = isPlatform ? 'y' : 'y1';
        dashChart.options.scales.y1.display = !isPlatform;
        dashChart.update();

        document.getElementById('chartTotalValue').textContent = (isPlatform ? <%= platformChartTotal || 0 %> : <%= chartTotal || 0 %>).toLocaleString('id-ID');
        const productTab = document.getElementById('chartProductTab');
        const platformTab = document.getElementById('chartPlatformTab');
        if (productTab) {
            productTab.style.background = isPlatform ? 'transparent' : '#fff';
            productTab.style.color = isPlatform ? '#64748b' : '#1e293b';
            productTab.style.boxShadow = isPlatform ? 'none' : '0 1px 3px rgba(15,23,42,.08)';
        }
        if (platformTab) {
            platformTab.style.background = isPlatform ? '#fff' : 'transparent';
            platformTab.style.color = isPlatform ? '#1e293b' : '#64748b';
            platformTab.style.boxShadow = isPlatform ? '0 1px 3px rgba(15,23,42,.08)' : 'none';
        }
        const primaryLegendDot = document.getElementById('primaryLegendDot');
        const secondaryLegendDot = document.getElementById('secondaryLegendDot');
        const primaryLegendLabel = document.getElementById('primaryLegendLabel');
        const secondaryLegendLabel = document.getElementById('secondaryLegendLabel');
        if (primaryLegendDot) primaryLegendDot.style.background = isPlatform ? '#7c3aed' : '#10b981';
        if (secondaryLegendDot) secondaryLegendDot.style.background = isPlatform ? '#ec4899' : '#f97316';
        if (primaryLegendLabel) primaryLegendLabel.textContent = isPlatform ? 'Penjualan Platform' : 'Revenue';
        if (secondaryLegendLabel) secondaryLegendLabel.textContent = isPlatform ? 'Renewal PRO' : 'Visitor';
    }

    function copyLink() {
        const slug = document.getElementById('slugInput').value;
        navigator.clipboard.writeText('https://lingku.xyz/' + slug);
        alert('Link disalin!');
    }

    async function updateSlug() {
        const slug = document.getElementById('slugInput').value;
        if (!slug) return alert('Slug tidak boleh kosong.');

        try {
            const res = await fetch('/admin/update-slug', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ slug })
            });
            const d = await res.json();
            if (d.success) {
                alert('Slug berhasil diperbarui!');
                location.reload(); // Reload to sync header and other parts
            } else {
                alert(d.message || 'Gagal update slug.');
            }
        } catch(e) {
            alert('Terjadi kesalahan sistem.');
        }
    }
</script>

