<%
    const s = stats || {};
    const totalRevenue = parseFloat(s.total_revenue || 0);
    const balance = parseFloat(s.balance || 0);
    const totalSales = parseInt(s.total_sales || 0);
    const totalProducts = parseInt(s.total_products || 0);
    const todaySales = parseFloat(s.today_sales || 0);
    const platformSales = parseFloat(s.platform_sales || 0);
    const platformTodaySales = parseFloat(s.platform_today_sales || 0);
    const userSlug = s.slug || 'username';
%>

<div class="dashboard-refresh">
<div class="dash-welcome">
    <div><p>Pantau penjualan, kelola toko, dan lihat perkembangan bisnismu.</p></div>
</div>
<style>
.dash-cards-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: 10px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 20px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px -1px rgba(0, 0, 0, 0.01);
}
.dash-stat-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 18px 20px;
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
    box-shadow: none;
}
.dash-stat-icon {
    width: 52px; height: 52px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
}
.dash-stat-icon.green  { background: #ecfdf5; color: #059669; }
.dash-stat-icon.blue   { background: #eff6ff; color: #2563eb; }
.dash-stat-icon.amber  { background: #fffbeb; color: #d97706; }
.dash-stat-icon.purple { background: #f5f3ff; color: #7c3aed; }
.dash-stat-icon.gray   { background: #f8fafc; color: #475569; }

.dash-stat-info { flex: 1; min-width: 0; }
.dash-stat-label {
    font-size: 11px;
    font-weight: 700;
    color: #64748b;
    margin-bottom: 4px;
}
.dash-stat-value {
    font-size: clamp(18px, 1.7vw, 24px);
    font-weight: 600;
    color: #0f172a;
    letter-spacing: -0.5px;
    line-height: 1.2;
    display: flex;
    align-items: baseline;
    gap: 2px;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
}
.dash-stat-value small {
    font-size: 11px;
    opacity: 0.5;
    font-weight: 700;
}
.dash-stat-sub {
    font-size: 11px;
    font-weight: 700;
    color: #94a3b8;
}

@media (max-width: 1400px) { .dash-cards-row { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; } }
@media (max-width: 1200px) {
    .dash-cards-row { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
}
@media (max-width: 640px) {
    .dash-cards-row { grid-template-columns: minmax(0, 1fr); gap: 12px; padding: 20px; }
    .dash-stat-value { font-size: 15px !important; }
    .dash-stat-icon { width: 36px; height: 36px; font-size: 14px; }
}
@media (max-width: 480px) {
    .dash-stat-value { font-size: 15px !important; }
}

/* BIO LINK CARD ENHANCEMENT */
.bio-card {
    background: #fff;
    border: 1px solid #f1f5f9;
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
}
.bio-input-group {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
}
.bio-input-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    padding: 10px 18px;
    transition: all 0.2s;
}
.bio-input-wrap:focus-within {
    border-color: #3b82f6;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}
.bio-btn {
    padding: 11px 20px;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1.5px solid #e2e8f0;
    background: #fff;
    color: #475569;
}
.bio-btn:hover { background: #f8fafc; border-color: #cbd5e1; }
.bio-btn.primary { background: #3b82f6; color: #fff; border: none; }
.bio-btn.primary:hover { background: #2563eb; }
</style>

<!-- YOUR BIO LINK RE-WORKED FOR RESPONSIVE -->
<div class="bio-row-container" style="display: flex; flex-wrap: wrap; gap: 24px; align-items: stretch; margin-bottom: 24px;">
    <% if (locals.features && features.show_today_sales) { %>
        <!-- FEATURE: PENJUALAN HARI INI (Controlled by Feature Flag) -->
        <div class="bio-card dash-today" style="width: 320px; background: linear-gradient(135deg, #8b5cf6, #6d28d9); border: none; position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: center; min-height: 120px;">
            <!-- ORNAMEN UANG (SILUET) -->
            <i class="fas fa-money-bill-wave" style="position: absolute; right: -20px; bottom: -20px; font-size: 120px; color: rgba(255,255,255,0.12); transform: rotate(-15deg);"></i>

            <div style="position: relative; z-index: 2;">
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
                    <div style="width: 32px; height: 32px; background: rgba(255,255,255,0.2); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white;">
                        <i class="fas fa-coins"></i>
                    </div>
                    <div style="font-size: 10px; font-weight: 800; color: rgba(255,255,255,0.85); letter-spacing: 1px; text-transform: uppercase;">PENJUALAN HARI INI</div>
                </div>
                <div style="font-size: 26px; font-weight: 500; color: white; display: flex; align-items: baseline; gap: 4px;">
                    <small style="font-size: 14px; opacity: 0.8; font-weight: 500;">Rp</small>
                    <%= todaySales.toLocaleString('id-ID') %>
                </div>

            </div>
        </div>
        <% if (user && user.role === 'admin') { %>
            <div class="bio-card dash-platform-today" style="width: 320px; background: linear-gradient(135deg, #dbeafe, #bfdbfe); border: 1px solid #93c5fd; position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: center; min-height: 120px;">
                <i class="fas fa-building" style="position: absolute; right: -14px; bottom: -18px; font-size: 112px; color: rgba(30,64,175,0.12); transform: rotate(-12deg);"></i>
                <div style="position:relative;z-index:2;">
                    <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
                        <div style="width:32px;height:32px;background:rgba(37,99,235,0.14);border-radius:10px;display:flex;align-items:center;justify-content:center;color:#1d4ed8;"><i class="fas fa-chart-line"></i></div>
                        <div style="font-size:10px;font-weight:800;color:#1e40af;letter-spacing:1px;text-transform:uppercase;">PENJUALAN PLATFORM HARI INI</div>
                    </div>
                    <div style="font-size:26px;font-weight:600;color:#1e3a8a;display:flex;align-items:baseline;gap:4px;"><small style="font-size:14px;opacity:.75;font-weight:600;">Rp</small><%= platformTodaySales.toLocaleString('id-ID') %></div>
                </div>
            </div>
        <% } %>
    <% } %>

    <div class="bio-card dash-store" style="flex: 1; min-width: 300px; margin: 0;">
        <div style="font-size: 11px; font-weight: 800; color: #64748b; letter-spacing: 1px; margin-bottom: 12px; text-transform: uppercase;">LINK BIO ANDA</div>
        <div class="bio-input-group">
            <div class="bio-input-wrap">
                <span style="color:#94a3b8; font-size:14px; font-weight:600;">lingku.xyz/</span>
                <input type="text" id="slugInput" aria-label="Alamat toko" value="<%= userSlug %>"
                    style="border:none; outline:none; background:transparent; font-size:14px; font-weight:800; color:#111827; flex:1; font-family:inherit;">
            </div>
            <button onclick="updateSlug()" class="bio-btn primary">Update</button>
            <button onclick="window.open('/' + document.getElementById('slugInput').value, '_blank')" class="bio-btn" title="Buka toko" aria-label="Buka toko">
                <i class="fas fa-external-link-alt"></i>
            </button>
            <button onclick="copyLink()" class="bio-btn" title="Salin tautan" aria-label="Salin tautan">
                <i class="fas fa-copy" style="color:#10b981;"></i>
            </button>
        </div>
    </div>
</div>

<style>
    @media (max-width: 640px) {
        .bio-row-container { flex-direction: column-reverse !important; gap: 12px !important; margin-bottom: 16px !important; }
        .bio-card { width: 100% !important; min-width: 100% !important; padding: 18px !important; }
        .bio-input-group { flex-wrap: wrap; gap: 8px !important; }
        .bio-input-wrap { width: 100% !important; flex: none !important; padding: 8px 12px !important; }
        .bio-btn { flex: 1; justify-content: center; padding: 10px 5px !important; font-size: 11px !important; }
        .bio-btn.primary { flex: 2; } /* Update button gets more space */
