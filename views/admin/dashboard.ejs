    <div class="dash-stat-card">
        <div class="dash-stat-icon green"><i class="fas fa-coins"></i></div>
        <div class="dash-stat-info">
            <div class="dash-stat-label">Total Pendapatan</div>
            <div class="dash-stat-value"><small>Rp</small><%= totalRevenue.toLocaleString('id-ID') %></div>
        </div>
    </div>
    <div class="dash-stat-card">
        <div class="dash-stat-icon blue"><i class="fas fa-wallet"></i></div>
        <div class="dash-stat-info">
            <div class="dash-stat-label">Saldo Tersedia</div>
            <div class="dash-stat-value"><small>Rp</small><%= balance.toLocaleString('id-ID') %></div>
        </div>
    </div>
    <div class="dash-stat-card">
        <div class="dash-stat-icon amber"><i class="fas fa-shopping-bag"></i></div>
        <div class="dash-stat-info">
            <div class="dash-stat-label">Total Penjualan</div>
            <div class="dash-stat-value"><%= totalSales %></div>
