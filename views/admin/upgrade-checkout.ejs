<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout Upgrade PRO - Lingku.xyz</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root { --primary: #8b5cf6; --secondary: #6d28d9; --bg: #f8fafc; --text: #1e293b; --text-muted: #64748b; }
        body { font-family: 'Inter', system-ui, sans-serif; background: var(--bg); color: var(--text); margin: 0; display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 20px; box-sizing: border-box; }
        .checkout-card { background: #fff; width: 100%; max-width: 480px; border-radius: 32px; padding: 40px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.08); position: relative; }
        .back-link { position: absolute; top: 40px; left: 40px; text-decoration: none; color: var(--text-muted); font-size: 13px; font-weight: 700; display: flex; align-items: center; gap: 8px; transition: 0.2s; }
        .back-link:hover { color: var(--primary); transform: translateX(-4px); }
        .header { text-align: center; margin-bottom: 32px; margin-top: 20px; }
        .title { font-size: 24px; font-weight: 900; margin: 0 0 8px 0; color: #0f172a; }
        .subtitle { font-size: 14px; color: var(--text-muted); margin: 0; font-weight: 500; }
        
        .product-summary { background: #f8fafc; border: 1.5px solid #f1f5f9; border-radius: 20px; padding: 20px; display: flex; align-items: center; gap: 16px; margin-bottom: 32px; }
        .product-icon { width: 60px; height: 60px; background: linear-gradient(135deg, #8b5cf6, #6d28d9); border-radius: 14px; display: flex; align-items: center; justify-content: center; color: white; font-size: 24px; }
        .product-info { flex: 1; }
        .product-name { font-size: 15px; font-weight: 800; color: #1e293b; margin-bottom: 2px; }
        .product-price { font-size: 15px; font-weight: 700; color: #8b5cf6; }

        .form-group { margin-bottom: 20px; }
        .label { display: block; font-size: 12px; font-weight: 800; color: #475569; text-transform: uppercase; margin-bottom: 8px; letter-spacing: 0.5px; }
        .input { width: 100%; padding: 14px 18px; background: #fff; border: 1.5px solid #e2e8f0; border-radius: 14px; font-size: 14px; color: #1e293b; font-weight: 600; box-sizing: border-box; transition: 0.2s; }
        .input:focus { border-color: #8b5cf6; box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.08); outline: none; }
        
        .pay-btn { width: 100%; padding: 18px; background: linear-gradient(135deg, #8b5cf6, #6d28d9); color: #fff; border: none; border-radius: 16px; font-size: 15px; font-weight: 800; cursor: pointer; transition: 0.2s; box-shadow: 0 10px 25px -5px rgba(139, 92, 246, 0.4); display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 12px; }
        .pay-btn:hover { transform: translateY(-2px); box-shadow: 0 15px 35px -5px rgba(139, 92, 246, 0.5); }
        
        .payment-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 10px; }
        .pay-option { 
            padding: 12px 8px; border: 1.5px solid #f1f5f9; border-radius: 12px; 
            display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; 
            cursor: pointer; transition: 0.2s; position: relative; background: #fff;
        }
        .pay-option img { height: 20px; width: auto; max-width: 100%; filter: grayscale(1); opacity: 0.6; transition: 0.2s; }
        .pay-option span { font-size: 10px; font-weight: 800; color: #94a3b8; text-transform: uppercase; }
        .pay-option:hover { border-color: #cbd5e1; background: #f8fafc; }
        .pay-option.active { border-color: #8b5cf6; background: #f5f3ff; box-shadow: 0 4px 12px rgba(139, 92, 246, 0.1); }
        .pay-option.active img { filter: grayscale(0); opacity: 1; }
        .pay-option.active span { color: #5b21b6; }
        .pay-option.active::after { content: '\f058'; font-family: 'Font Awesome 5 Free'; font-weight: 900; position: absolute; top: 4px; right: 4px; font-size: 10px; color: #8b5cf6; }

        .footer-note { text-align: center; margin-top: 24px; font-size: 11px; color: var(--text-muted); font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 6px; }
        .footer-note i { color: #8b5cf6; }
    </style>
</head>
<body>
    <div class="checkout-card">
        <a href="javascript:history.back()" class="back-link"><i class="fas fa-chevron-left"></i> Kembali</a>
        
        <div class="header">
            <h1 class="title">Informasi Pesanan</h1>
            <p class="subtitle">Satu langkah lagi menuju pengalaman PRO.</p>
        </div>

        <div class="product-summary">
            <div class="product-icon">
                <i class="fas fa-crown"></i>
            </div>
            <div class="product-info">
                <div class="product-name">Upgrade Paket PRO (1 Tahun)</div>
                <div class="product-price">Rp <%= Number(price_pro).toLocaleString('id-ID') %></div>
            </div>
        </div>

        <form action="/admin/upgrade/process" method="POST" id="checkoutForm">
            <input type="hidden" name="payment_method" id="payMethod" value="qr">
            <input type="hidden" name="payment_channel" id="payChannel" value="qris">
            
            <div class="form-group">
                <label class="label">Nama Lengkap</label>
                <input type="text" name="name" class="input" value="<%= user.fullname || user.name %>" required>
            </div>
            
            <div class="form-group">
                <label class="label">Alamat Email</label>
                <input type="email" name="email" class="input" value="<%= user.email %>" readonly>
            </div>
            
            <div class="form-group">
                <label class="label">Nomor WhatsApp</label>
                <input type="text" name="phone" class="input" value="<%= user.whatsapp || user.phone %>" placeholder="e.g. 08123456789" required>
            </div>

            <div class="form-group" style="margin-top: 32px;">
                <label class="label">Pilih Metode Pembayaran</label>
                <div class="payment-grid">
                    <div class="pay-option active" data-method="qris" data-channel="qris" onclick="selectPay(this)">
                        <img src="https://img.icons8.com/color/48/000000/qr-code.png" alt="QRIS">
                        <span>QRIS</span>
                    </div>
                    <div class="pay-option" data-method="va" data-channel="bca" onclick="selectPay(this)">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/5/5c/Bank_Central_Asia.svg" alt="BCA">
                        <span>BCA</span>
                    </div>
                    <div class="pay-option" data-method="va" data-channel="mandiri" onclick="selectPay(this)">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/a/ad/Bank_Mandiri_logo_2016.svg" alt="Mandiri">
                        <span>Mandiri</span>
                    </div>
                    <div class="pay-option" data-method="va" data-channel="bni" onclick="selectPay(this)">
                        <img src="https://upload.wikimedia.org/wikipedia/id/thumb/5/55/BNI_logo.svg/1280px-BNI_logo.svg.png" alt="BNI">
                        <span>BNI</span>
                    </div>
                    <div class="pay-option" data-method="va" data-channel="bri" onclick="selectPay(this)">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/2/2e/BRI_Logo.svg/1280px-BRI_Logo.svg.png" alt="BRI">
                        <span>BRI</span>
                    </div>
                    <div class="pay-option" data-method="cstore" data-channel="alfamart" onclick="selectPay(this)">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/8/86/Alfamart_logo.svg" alt="Alfamart">
                        <span>Alfamart</span>
                    </div>
                </div>
            </div>

            <button type="submit" class="pay-btn">
                Lanjutkan Pembayaran <i class="fas fa-arrow-right"></i>
            </button>
        </form>

        <script>
            function selectPay(el) {
                document.querySelectorAll('.pay-option').forEach(o => o.classList.remove('active'));
                el.classList.add('active');
                document.getElementById('payMethod').value = el.dataset.method;
                document.getElementById('payChannel').value = el.dataset.channel;
            }

            document.getElementById('checkoutForm').addEventListener('submit', function(e) {
                const btn = this.querySelector('.pay-btn');
                btn.style.opacity = '0.7';
                btn.style.cursor = 'not-allowed';
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Memproses...';
            });
        </script>

        <div class="footer-note">
            <i class="fas fa-lock"></i> Pembayaran Aman & Terenkripsi oleh iPaymu
        </div>
    </div>
</body>
</html>
