<style>
    .scanner-box { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 16px; margin-bottom: 20px; }
    .mode-toggle { display: flex; gap: 6px; margin-bottom: 12px; background: #f1f5f9; padding: 3px; border-radius: 8px; width: fit-content; }
    .mode-btn { padding: 6px 14px; border-radius: 6px; border: none; font-size: 11px; font-weight: 700; cursor: pointer; transition: 0.15s; background: transparent; color: #64748b; }
    .mode-btn.active { background: #fff; color: #1e293b; box-shadow: 0 1px 2px rgba(0,0,0,0.04); }
    #reader { width: 100%; max-width: 400px; border-radius: 10px; overflow: hidden; border: 1.5px solid #e2e8f0; }
    .manual-input { display: flex; gap: 6px; }
    .manual-input input { flex: 1; padding: 8px 12px; border: 1.5px solid #e2e8f0; border-radius: 8px; font-size: 13px; font-weight: 700; outline: none; }
    .manual-input input:focus { border-color: #10b981; }
    .validate-btn { padding: 8px 18px; background: #10b981; color: #fff; border: none; border-radius: 8px; font-weight: 800; cursor: pointer; font-size: 13px; white-space: nowrap; }
    .validate-btn:disabled { background: #94a3b8; cursor: not-allowed; }
    .scan-result { margin-top: 12px; padding: 12px 16px; border-radius: 10px; font-size: 13px; font-weight: 700; display: none; }
    .scan-result.success { background: #f0fdf4; border: 1px solid #10b981; display: block; color: #065f46; }
    .scan-result.error { background: #fef2f2; border: 1px solid #ef4444; display: block; color: #991b1b; }
    
    .ticket-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .ticket-table th { background: #f8fafc; padding: 10px 12px; text-align: left; font-weight: 800; color: #64748b; font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1.5px solid #e2e8f0; }
    .ticket-table td { padding: 10px 12px; border-bottom: 1px solid #f1f5f9; color: #334155; font-weight: 600; }
    .ticket-table .code { font-family: monospace; font-size: 11px; font-weight: 800; color: #1e293b; }
    .badge { display: inline-block; padding: 3px 10px; border-radius: 100px; font-size: 10px; font-weight: 800; }
    .badge-active { background: #f0fdf4; color: #059669; }
    .badge-used { background: #fef2f2; color: #dc2626; }
</style>

<div style="display:flex; align-items:center; justify-content:flex-end; margin-bottom:16px;">
    <div style="font-size:12px; font-weight:700; color:#64748b;">Total: <%= tickets.length %> tiket</div>
</div>

<div class="scanner-box">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 12px;">
        <div class="mode-toggle" style="margin-bottom: 0;">
            <button class="mode-btn active" id="btnCamera" onclick="switchMode('camera')"><i class="fas fa-camera"></i> Kamera</button>
            <button class="mode-btn" id="btnManual" onclick="switchMode('manual')"><i class="fas fa-keyboard"></i> Input Manual</button>
        </div>
        
        <!-- Filter Tanggal -->
        <form method="GET" action="/admin/tiket/scanner" style="display: flex; gap: 8px; align-items: center;">
            <input type="date" name="date" value="<%= typeof filterDate !== 'undefined' && filterDate ? filterDate : '' %>" onchange="this.form.submit()" style="padding: 6px 12px; border: 1.5px solid #e2e8f0; border-radius: 8px; font-size: 12px; font-weight: 700; color: #1e293b; outline: none; background: #fff;">
            <% if (typeof filterDate !== 'undefined' && filterDate) { %>
                <a href="/admin/tiket/scanner" style="font-size: 11px; font-weight: 800; color: #ef4444; text-decoration: none; display: flex; align-items: center; gap: 4px;"><i class="fas fa-times"></i> Reset</a>
            <% } %>
        </form>
    </div>
    
    <div id="cameraMode">
        <div id="reader"></div>
    </div>
    
    <div id="manualMode" style="display:none;">
        <div class="manual-input">
            <input type="text" id="codeInput" placeholder="Kode tiket..." onkeydown="if(event.key==='Enter')validateManual()">
            <button class="validate-btn" onclick="validateManual()">Validasi</button>
        </div>
    </div>
    
    <div id="scanResult" class="scan-result"></div>
</div>

<% if (tickets.length > 0) { %>
<div class="scanner-box" style="overflow-x:auto;">
    <table class="ticket-table">
        <thead>
            <tr>
                <th>Kode</th>
                <th>Customer</th>
                <th>Produk</th>
                <th>Harga</th>
                <th>Status</th>
                <th>Tgl Dibuat</th>
            </tr>
        </thead>
        <tbody>
            <% tickets.forEach(t => { %>
            <tr>
                <td><span class="code"><%= t.ticket_code %></span></td>
                <td>
                    <div style="font-weight:700;"><%= t.customer_name || '-' %></div>
                    <div style="font-size:10px;color:#94a3b8;"><%= t.customer_email || '' %></div>
                    <% if (t.customer_whatsapp) { %><div style="font-size:10px;color:#64748b;"><%= t.customer_whatsapp %></div><% } %>
                </td>
                <td style="max-width:180px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="<%= t.product_name %>"><%= t.product_name %></td>
                <td>Rp <%= parseFloat(t.total_price || 0).toLocaleString('id-ID') %></td>
                <td>
                    <% if (t.scanned_at) { %>
                        <span class="badge badge-used">Terpakai</span>
                        <div style="font-size:9px;color:#94a3b8;"><%= new Date(t.scanned_at).toLocaleDateString('id-ID', {day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}) %></div>
                    <% } else { %>
                        <span class="badge badge-active">Aktif</span>
                    <% } %>
                </td>
                <td style="font-size:11px;color:#94a3b8;"><%= new Date(t.created_at).toLocaleDateString('id-ID', {day:'numeric',month:'short'}) %></td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</div>
<% } else { %>
<div class="scanner-box" style="text-align:center; padding:40px; color:#94a3b8; font-weight:700;">
    Belum ada tiket
</div>
<% } %>

<script src="https://unpkg.com/html5-qrcode"></script>
<script>
    let scanner = null;
    
    function switchMode(mode) {
        document.getElementById('btnCamera').classList.toggle('active', mode === 'camera');
        document.getElementById('btnManual').classList.toggle('active', mode === 'manual');
        document.getElementById('cameraMode').style.display = mode === 'camera' ? '' : 'none';
        document.getElementById('manualMode').style.display = mode === 'manual' ? '' : 'none';
        if (mode === 'camera') startScanner(); else stopScanner();
    }
    
    function startScanner() {
        if (scanner) return;
        scanner = new Html5Qrcode("reader");
        scanner.start(
            { facingMode: "environment" },
            { fps: 10, qrbox: { width: 250, height: 250 } },
            (decodedText) => { stopScanner(); validateCode(extractCode(decodedText)); },
            () => {}
        ).catch(e => console.log('Camera error:', e));
    }
    
    function stopScanner() {
        if (scanner) { scanner.stop().catch(() => {}); scanner = null; }
    }
    
    function extractCode(url) {
        try { return new URL(url).pathname.replace('/tiket/', ''); } catch(e) { return url; }
    }
    
    function validateManual() {
        const code = document.getElementById('codeInput').value.trim();
        if (!code) return;
        validateCode(code);
    }
    
    function validateCode(code) {
        const result = document.getElementById('scanResult');
        document.getElementById('scanResult').className = 'scan-result';
        
        fetch('/api/tiket/validate/' + code, { method: 'POST' })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    result.className = 'scan-result success';
                    result.innerHTML = '✅ <strong>Tiket Valid!</strong> — ' + data.customer_name + ' (' + data.ticket_code + ')';
                    setTimeout(() => location.reload(), 1500);
                } else {
                    result.className = 'scan-result error';
                    result.innerHTML = '❌ ' + data.message;
                }
            })
            .catch(() => {
                result.className = 'scan-result error';
                result.innerHTML = '⚠️ Gagal validasi';
            });
    }
</script>
