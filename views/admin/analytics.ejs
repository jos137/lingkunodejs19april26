<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
.ga-cards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-bottom: 14px; background: #fff; border: 1px solid #e2e8f0; border-radius: 20px; padding: 20px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px -1px rgba(0, 0, 0, 0.01); }
.ga-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 18px 20px; min-width: 0; display: flex; align-items: center; gap: 14px; }
.ga-icon { width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }
.ga-icon.green { background: #ecfdf5; color: #059669; }
.ga-icon.blue { background: #eff6ff; color: #2563eb; }
.ga-icon.teal { background: #f0fdfa; color: #0d9488; }
.ga-icon.purple { background: #f5f3ff; color: #7c3aed; }
.ga-icon.rose { background: #fff1f2; color: #e11d48; }
.ga-icon.amber { background: #fffbeb; color: #d97706; }
.ga-icon.sky { background: #f0f9ff; color: #0284c7; }
.ga-icon.red { background: #fef2f2; color: #dc2626; }
.ga-info { flex: 1; min-width: 0; }
.ga-card-label { font-size: 10px; font-weight: 700; color: #64748b; letter-spacing: 0.5px; margin-bottom: 4px; text-transform: uppercase; }
.ga-card-value { font-size: 20px; font-weight: 600; color: #111827; white-space: nowrap; font-variant-numeric: tabular-nums; max-width: 100%; overflow: hidden; text-overflow: ellipsis; }
.ga-card-sub { font-size: 11px; color: #94a3b8; margin-top: 4px; font-weight: 600; }

.ga-bottom { display: grid; grid-template-columns: 1fr 280px; gap: 18px; margin-top: 18px; }
.ga-chart-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; padding: 24px; }
.ga-chart-title { font-size: 14px; font-weight: 800; color: #111827; margin-bottom: 16px; }
.ga-actions-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; padding: 24px; }
.ga-action-title { font-size: 14px; font-weight: 800; color: #111827; margin-bottom: 16px; }
.ga-action-btn { display: block; width: 100%; padding: 12px; text-align: center; border-radius: 10px; font-size: 13px; font-weight: 800; cursor: pointer; margin-bottom: 10px; border: none; transition: 0.15s; text-decoration: none; }
.ga-action-btn.primary { background: #ef4444; color: #fff; }
.ga-action-btn.primary:hover { background: #dc2626; }
.ga-action-btn.outline { background: #fff; color: #374151; border: 2px solid #e5e7eb; }
.ga-action-btn.outline:hover { border-color: #3b82f6; color: #3b82f6; }
.ga-stats { margin-top: 18px; }
.ga-stat-row { display: flex; justify-content: space-between; padding: 8px 0; font-size: 13px; }
.ga-stat-row .label { color: #94a3b8; }
.ga-stat-row .val { font-weight: 800; color: #111827; }

@media (max-width: 900px) {
    .ga-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; padding: 20px; }
    .ga-bottom { grid-template-columns: 1fr; }
}
@media (max-width: 640px) {
    .ga-cards { grid-template-columns: minmax(0, 1fr); gap: 12px; padding: 20px; }
    .ga-icon { width: 36px; height: 36px; font-size: 14px; }
    .ga-card-value { font-size: 17px; }
}
</style>

<%
const fmtR = (n) => 'Rp' + parseFloat(n || 0).toLocaleString('id-ID');
%>

<!-- Row 1: 4 Cards -->
<div class="ga-cards">
    <div class="ga-card">
        <div class="ga-icon green"><i class="fas fa-money-bill-wave"></i></div>
        <div class="ga-info">
            <div class="ga-card-label">Total Gross Sales</div>
            <div class="ga-card-value" style="color:#111827;" title="<%= fmtR(total_income) %>"><%= fmtR(total_income) %></div>
            <div class="ga-card-sub"><%= total_orders %> Pesanan Berhasil</div>
        </div>
    </div>
    <div class="ga-card">
        <div class="ga-icon blue"><i class="fas fa-store"></i></div>
        <div class="ga-info">
            <div class="ga-card-label">Penjualan Platform</div>
            <div class="ga-card-value" style="color:#3b82f6;" title="<%= fmtR(platform_income || 0) %>"><%= fmtR(platform_income || 0) %></div>
            <div class="ga-card-sub">Cuan Upgrade PRO</div>
        </div>
    </div>
    <div class="ga-card">
        <div class="ga-icon teal"><i class="fas fa-piggy-bank"></i></div>
        <div class="ga-info">
            <div class="ga-card-label">Omset Admin Lingku</div>
            <div class="ga-card-value" style="color:#10b981;" title="<%= fmtR(total_income) %>"><%= fmtR(total_income) %></div>
            <div class="ga-card-sub">Produk Digital Admin</div>
        </div>
    </div>
    <div class="ga-card">
        <div class="ga-icon purple"><i class="fas fa-crown"></i></div>
        <div class="ga-info">
            <div class="ga-card-label">Jumlah User Pro</div>
            <div class="ga-card-value" style="color:#8b5cf6;"><%= dana_mengendap || 0 %> <span style="font-size: 14px; font-weight: 800;">Users</span></div>
            <div class="ga-card-sub">Total Member Upgrade</div>
        </div>
    </div>
</div>

<!-- Row 2: 4 Cards -->
<div class="ga-cards">
    <div class="ga-card">
        <div class="ga-icon rose"><i class="fas fa-hand-holding-dollar"></i></div>
        <div class="ga-info">
            <div class="ga-card-label">Total WD Keluar</div>
            <div class="ga-card-value" title="<%= fmtR(total_wd || 0) %>"><%= fmtR(total_wd || 0) %></div>
        </div>
    </div>
    <div class="ga-card">
        <div class="ga-icon amber"><i class="fas fa-hourglass-half"></i></div>
        <div class="ga-info">
            <div class="ga-card-label">Pending Payouts</div>
            <div class="ga-card-value" style="color:#f59e0b;" title="<%= fmtR(pending_payouts || 0) %>"><%= fmtR(pending_payouts || 0) %></div>
        </div>
    </div>
    <div class="ga-card">
        <div class="ga-icon sky"><i class="fas fa-users"></i></div>
        <div class="ga-info">
            <div class="ga-card-label">Total Members</div>
            <div class="ga-card-value" style="color:#3b82f6;"><%= customer_count %></div>
        </div>
    </div>
    <div class="ga-card">
        <div class="ga-icon red"><i class="fas fa-triangle-exclamation"></i></div>
        <div class="ga-info">
            <div class="ga-card-label">Stock Alerts</div>
            <div class="ga-card-value" style="color:#ef4444;"><%= stock_alerts || 0 %> Out</div>
        </div>
    </div>
</div>

<!-- Bottom: Chart + Actions -->
<div class="ga-bottom">
    <div class="ga-chart-card">
        <div class="ga-chart-title">7-Day Growth Analysis</div>
        <canvas id="growthChart" height="220"></canvas>
    </div>
    <div class="ga-actions-card">
        <div class="ga-action-title">Admin Quick Actions</div>
        <a href="/admin/withdrawal-queue" class="ga-action-btn primary">Proses Penarikan Dana</a>
        <a href="/admin/users" class="ga-action-btn outline">Manajemen Seluruh User</a>
        <div class="ga-stats">
            <div class="ga-stat-row"><span class="label">Platform Stats:</span></div>
            <div class="ga-stat-row"><span class="label">Total Produk:</span><span class="val"><%= total_products %></span></div>
        </div>
    </div>
</div>

<script>
const chartData = <%- JSON.stringify(chartData || []) %>;
const labels = chartData.map(d => { const dt = new Date(d.date); return dt.toLocaleDateString('id-ID', {day:'numeric',month:'short'}); });
const values = chartData.map(d => d.orders || d.revenue || 0);

if (labels.length === 0) {
    for (let i = 6; i >= 0; i--) {
        const dt = new Date(); dt.setDate(dt.getDate() - i);
        labels.push(dt.toLocaleDateString('id-ID', {day:'numeric',month:'short'}));
        values.push(0);
    }
}

new Chart(document.getElementById('growthChart').getContext('2d'), {
    type: 'line',
    data: {
        labels,
        datasets: [{
            data: values,
            borderColor: '#3b82f6',
            backgroundColor: 'rgba(59,130,246,0.08)',
            borderWidth: 2.5,
            pointRadius: 4,
            pointBackgroundColor: '#3b82f6',
            tension: 0.4,
            fill: true
        }]
    },
    options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, grid: { color: '#f1f5f9' } }, x: { grid: { display: false } } }
    }
});
</script>
