<style>
.wdq-table-wrap { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; overflow: hidden; }
.wdq-table { width: 100%; border-collapse: collapse; }
.wdq-table thead th { background: #f9fafb; padding: 14px 18px; text-align: left; font-size: 11px; font-weight: 800; color: #64748b; letter-spacing: 0.5px; border-bottom: 1px solid #e5e7eb; }
.wdq-table tbody td { padding: 14px 18px; font-size: 13px; color: #374151; border-bottom: 1px solid #f3f4f6; font-weight: 500; }
.wdq-table tbody tr:hover { background: #f9fafb; }
.wdq-badge { padding: 4px 12px; border-radius: 100px; font-size: 10px; font-weight: 800; }
.wdq-badge.pending { background: #fffbeb; color: #d97706; }
.wdq-badge.completed { background: #f0fdf4; color: #059669; }
.wdq-badge.rejected { background: #fef2f2; color: #dc2626; }
.wdq-btn { padding: 6px 14px; border-radius: 8px; font-size: 11px; font-weight: 800; border: none; cursor: pointer; margin-right: 6px; transition: 0.15s; }
.wdq-btn.approve { background: #10b981; color: #fff; }
.wdq-btn.approve:hover { background: #059669; }
.wdq-btn.reject { background: #ef4444; color: #fff; }
.wdq-btn.reject:hover { background: #dc2626; }
.wdq-empty { text-align: center; padding: 50px; color: #94a3b8; font-size: 13px; }
.wdq-summary { display: grid; grid-template-columns: repeat(3,1fr); gap: 14px; margin-bottom: 20px; }
.wdq-sum { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 18px; text-align: center; }
.wdq-sum-label { font-size: 10px; font-weight: 800; color: #94a3b8; letter-spacing: 1px; margin-bottom: 6px; }
.wdq-sum-val { font-size: 22px; font-weight: 900; }
</style>

<%
const pendingList = withdrawals.filter(w => w.status === 'pending');
const completedList = withdrawals.filter(w => w.status === 'completed');
const rejectedList = withdrawals.filter(w => w.status === 'rejected');
%>

<div class="wdq-summary">
    <div class="wdq-sum"><div class="wdq-sum-label">PENDING</div><div class="wdq-sum-val" style="color:#d97706;"><%= pendingList.length %></div></div>
    <div class="wdq-sum"><div class="wdq-sum-label">DISETUJUI</div><div class="wdq-sum-val" style="color:#059669;"><%= completedList.length %></div></div>
    <div class="wdq-sum"><div class="wdq-sum-label">DITOLAK</div><div class="wdq-sum-val" style="color:#ef4444;"><%= rejectedList.length %></div></div>
</div>

<div class="wdq-table-wrap">
    <% if (withdrawals.length > 0) { %>
        <table class="wdq-table">
            <thead>
                <tr><th>#</th><th>User</th><th>Jumlah</th><th>Bank</th><th>Rekening</th><th>Status</th><th>Tanggal</th><th>Aksi</th></tr>
            </thead>
            <tbody>
                <% withdrawals.forEach(w => { %>
                    <tr>
                        <td><strong>#<%= w.id %></strong></td>
                        <td>
                            <strong><%= w.user_name || w.account_name || '-' %></strong>
                            <div style="font-size:11px;color:#94a3b8;"><%= w.user_email || '' %></div>
                        </td>
                        <td><strong>Rp <%= parseFloat(w.amount || 0).toLocaleString('id-ID') %></strong></td>
                        <td><%= w.bank_name || '-' %></td>
                        <td><%= w.account_number || '-' %><br><span style="font-size:11px;color:#94a3b8;">a.n. <%= w.account_name || '-' %></span></td>
                        <td><span class="wdq-badge <%= w.status %>"><%= (w.status || '').toUpperCase() %></span></td>
                        <td><%= w.created_at ? new Date(w.created_at).toLocaleDateString('id-ID', {day:'numeric',month:'short',year:'numeric'}) : '-' %></td>
                        <td>
                            <% if (w.status === 'pending') { %>
                                <form action="/admin/withdrawal-queue/<%= w.id %>/approve" method="POST" style="display:inline;">
                                    <button class="wdq-btn approve" type="submit">✓ Setuju</button>
                                </form>
                                <form action="/admin/withdrawal-queue/<%= w.id %>/reject" method="POST" style="display:inline;">
                                    <button class="wdq-btn reject" type="submit">✕ Tolak</button>
                                </form>
                            <% } else { %>
                                <span style="font-size:11px;color:#94a3b8;">—</span>
                            <% } %>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    <% } else { %>
        <div class="wdq-empty"><i class="fas fa-inbox" style="font-size:28px;display:block;margin-bottom:8px;"></i>Belum ada permintaan penarikan.</div>
    <% } %>
</div>
