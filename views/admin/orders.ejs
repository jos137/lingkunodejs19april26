<style>
/* ===== ORDERS LAYOUT ===== */
.orders-wrap { display: grid; grid-template-columns: 495px 1fr; gap: 30px; align-items: start; }
.orders-header { display: flex; align-items: center; gap: 14px; margin-bottom: 22px; }
.orders-search {
    flex: 1; padding: 12px 18px; border: 1.5px solid #e5e7eb; border-radius: 12px;
    font-family: inherit; font-size: 13.5px; color: #374151; background: #fff; outline: none;
    box-shadow: 0 2px 5px rgba(0,0,0,0.02);
}
.orders-search:focus { border-color: #3b82f6; box-shadow: 0 0 0 4px rgba(59,130,246,0.1); }

/* Filter */
.filter-wrap { position: relative; display: inline-block; }
.filter-btn {
    padding: 12px 20px; border: 1.5px solid #e5e7eb; border-radius: 12px;
    background: #fff; font-size: 13.5px; font-weight: 700; color: #374151;
    cursor: pointer; display: flex; align-items: center; gap: 8px; transition: 0.2s;
}
.filter-btn:hover { background: #f9fafb; border-color: #d1d5db; }

.filter-dropdown {
    display: none; position: absolute; top: 50px; right: 0; z-index: 50;
    background: #fff; border: 1px solid #e5e7eb; border-radius: 14px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.15); min-width: 200px; padding: 10px;
}
.filter-dropdown.show { display: block; animation: fadeIn 0.2s ease-out; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }

.filter-item {
    padding: 10px 14px; border-radius: 8px; font-size: 13px; font-weight: 600;
    color: #374151; cursor: pointer; display: flex; align-items: center; gap: 8px;
    transition: 0.1s;
}
.filter-item:hover { background: #f3f4f6; }
.filter-item.active { background: #f59e0b; color: #fff; border-radius: 8px; }

/* Order Cards */
.order-list { display: flex; flex-direction: column; gap: 12px; }
.order-card {
    display: flex; align-items: flex-start; gap: 24px;
    padding: 28px 32px; background: #fff; border: 1.5px solid #e5e7eb;
    border-radius: 16px !important; cursor: pointer; transition: 0.15s; position: relative;
}
.order-card:first-child, .order-card:last-child { border-radius: 16px !important; }
.order-card:only-child { border-radius: 16px; border-bottom: 1.5px solid #e5e7eb; }
.order-card:hover { background: #f8fafc; }
.order-card.active { border-color: #10b981; background: #f0fdf4; z-index: 1; border-bottom: 1.5px solid #10b981; box-shadow: 0 4px 15px rgba(16,185,129,0.06); }

.order-info { flex: 1; min-width: 0; padding-right: 90px; }
.order-date { font-size: 11px; color: #94a3b8; font-weight: 700; margin-bottom: 6px; }
.order-buyer { font-size: 15px; font-weight: 900; color: #111827; display: flex; align-items: center; gap: 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.order-product { font-size: 12px; font-weight: 800; color: #f59e0b; margin-top: 5px; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.order-price { font-size: 16px; font-weight: 1000; color: #111827; margin-top: 10px; }

.order-status {
    position: absolute; top: 24px; right: 32px;
    font-size: 9.5px; font-weight: 1000; letter-spacing: 1px;
    padding: 4px 10px; border-radius: 8px; background: rgba(0,0,0,0.05);
}
.order-status.completed { color: #059669; background: rgba(16,185,129,0.1); }
.order-status.pending { color: #d97706; background: rgba(245,158,11,0.1); }
.order-status.expired { color: #dc2626; background: rgba(220,38,38,0.1); }

.order-thumb-wrap {
    width: 60px; height: 60px; border-radius: 14px; background: #f1f5f9;
    border: 1.5px solid #e2e8f0; flex-shrink: 0; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
    margin-top: 25px;
}
.order-thumb-wrap img { width: 100%; height: 100%; object-fit: cover; }
.order-thumb-wrap i { color: #cbd5e1; font-size: 24px; }

/* PREMIUM PAGINATION */
.pagination-container {
    display: flex; justify-content: center; align-items: center; gap: 24px;
    margin-top: 40px; padding: 20px 0;
}
.pg-btn {
    font-size: 20px; color: #64748b; cursor: pointer; text-decoration: none;
    transition: 0.2s; display: flex; align-items: center; justify-content: center;
}
.pg-btn:hover { color: #111827; }
.pg-btn.disabled { color: #e2e8f0; cursor: not-allowed; pointer-events: none; }

.pg-num-wrap { display: flex; align-items: center; gap: 18px; }
.pg-num {
    font-size: 18px; font-weight: 600; color: #64748b; text-decoration: none;
    transition: 0.2s; min-width: 24px; text-align: center;
}
.pg-num:hover { color: #111827; }
.pg-num.active { color: #111827; font-weight: 800; cursor: default; }
.pg-dots { font-size: 18px; color: #94a3b8; font-weight: 600; cursor: default; }

/* ===== DETAIL PANEL ===== */
.detail-panel {
    background: #fff; border: 1.5px solid #e5e7eb; border-radius: 20px;
    padding: 35px; position: sticky; top: 25px; box-shadow: 0 10px 40px rgba(0,0,0,0.04);
}
.detail-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px; }
.detail-ref-label { font-size: 11px; font-weight: 900; color: #94a3b8; letter-spacing: 1.5px; margin-bottom: 8px; }
.detail-ref-id { font-size: 14px; font-weight: 500; color: #111827; letter-spacing: -0.2px; }
.detail-status { padding: 8px 20px; border-radius: 12px; font-size: 12px; font-weight: 1000; letter-spacing: 0.8px; }
.detail-status.completed { background: #f0fdf4; color: #059669; border: 1.5px solid rgba(5,150,105,0.1); }
.detail-status.pending { background: #fffbeb; color: #d97706; border: 1.5px solid rgba(217,119,6,0.1); }
.detail-status.expired { background: #fef2f2; color: #dc2626; border: 1.5px solid rgba(220,38,38,0.1); }

.detail-sections { display: grid; grid-template-columns: 3fr 2fr; gap: 20px; margin-bottom: 30px; }
.detail-section { background: #f8fafc; border: 1px solid #f1f5f9; border-radius: 14px; padding: 25px; position: relative; }
.detail-section-title { font-size: 11px; font-weight: 1000; color: #94a3b8; letter-spacing: 1.8px; margin-bottom: 15px; text-transform: uppercase; }
.detail-row { font-size: 15px; color: #475569; margin-bottom: 10px; line-height: 1.6; }
.detail-row strong { color: #111827; font-weight: 800; }
.detail-total { font-size: 24px; font-weight: 1000; color: #10b981; margin-top: 6px; }

.mini-followup {
    display: inline-flex; align-items: center; gap: 8px; padding: 10px 22px;
    background: #3b82f6; color: white; border-radius: 10px; font-size: 12px;
    font-weight: 900; text-decoration: none; margin-top: 15px; transition: 0.2s;
}
.mini-followup:hover { background: #2563eb; transform: translateY(-2px); box-shadow: 0 5px 15px rgba(59,130,246,0.3); }

/* Timeline */
.detail-email-status { border-top: 2px solid #f8fafc; padding-top: 30px; margin-top: 10px; }
.detail-email-title { font-size: 11px; font-weight: 1000; color: #94a3b8; letter-spacing: 1.5px; margin-bottom: 35px; text-transform: uppercase; }
.email-steps { display: flex; justify-content: space-between; position: relative; margin: 0 40px; }
.email-steps::before {
    content: ''; position: absolute; top: 24px; left: 0; right: 0;
    height: 3px; background: #f1f5f9; z-index: 1;
}
.email-step { position: relative; z-index: 2; width: 90px; text-align: center; }
.email-step-icon {
    width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
    margin: 0 auto 12px; font-size: 18px; background: #fff; border: 2.5px solid #f1f5f9; color: #cbd5e1;
}
.email-step-icon.done { background: #f0fdf4; color: #10b981; border-color: #10b981; box-shadow: 0 0 15px rgba(16,185,129,0.15); }
.email-step-label { font-size: 12px; font-weight: 1000; color: #1e293b; }
.email-step-time { font-size: 10px; color: #64748b; margin-top: 6px; font-weight: 700; white-space: nowrap; }

.orders-empty { text-align: center; padding: 100px 20px; color: #cbd5e1; }

/* MOBILE ACCORDION - ONLY FOR PHONE */
.order-detail-mobile { display: none; width: 100%; border-top: 1.5px solid #f1f5f9; margin-top: 20px; padding-top: 25px; }

@media (max-width: 1100px) { 
    .orders-wrap { grid-template-columns: 1fr; } 
    .detail-panel { display: none; }
    .order-card { display: flex; flex-wrap: wrap; align-items: flex-start; padding: 22px 20px 27px 20px; min-height: auto; width: 100%; box-sizing: border-box; overflow: hidden; }
    .order-info { flex: 1; padding-right: 65px; min-width: 0; }
    .order-buyer { white-space: normal; word-break: break-word; line-height: 1.3; font-size: 14px; }
    .order-product { white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; line-height: 1.4; margin-top: 4px; word-break: break-word; }
    .order-price { display: none; } /* Hapus harga di kiri sesuai request */
    .order-date { white-space: normal; font-size: 10px; margin-bottom: 6px; display: flex; flex-wrap: wrap; gap: 4px; align-items: center; }
    
    .order-status { 
        position: absolute; top: 22px; right: 20px; 
        font-size: 8px; font-weight: 900; padding: 2px 8px; border-radius: 4px;
        width: auto; min-width: 60px; text-align: center;
    }
    .order-thumb-wrap { 
        position: absolute; top: 48px; right: 20px;
        width: 48px; height: 48px; margin-top: 0;
    }

    /* DETIL ACCORDION REFINEMENT: FULL WIDTH */
    .order-detail-mobile { display: none; width: 100% !important; margin: 15px 0 0 0 !important; padding: 15px 0 0 0 !important; border-top: 1px solid #f1f5f9; }
    .order-detail-mobile .detail-status { display: none; } /* Hapus status di detail sesuai request */
    .order-detail-mobile .detail-ref-id { font-size: 13px; font-weight: 500; }
    .order-detail-mobile .detail-sections { display: block; width: 100%; margin: 0; box-sizing: border-box; }
    .order-detail-mobile .detail-section { width: 100%; padding: 15px; margin-bottom: 15px; border-radius: 12px; box-sizing: border-box; }
    
    .order-detail-mobile .detail-row { 
        display: flex; justify-content: space-between; align-items: flex-start; gap: 10px;
        font-size: 13px; line-height: 1.4; color: #64748b; margin-bottom: 8px;
    }
    .order-detail-mobile .detail-row strong, .order-detail-mobile .detail-row .detail-total { text-align: right; word-break: break-word; }
    .order-detail-mobile .detail-total { font-size: 16px; font-weight: 700; color: #10b981; margin-top: 0; }
    .order-detail-mobile .mini-followup { width: 100%; border-radius: 10px; padding: 12px; }
    
    .order-card.active .order-detail-mobile { display: block; }
}
</style>

<div class="orders-wrap">
    <!-- LEFT: ORDER LIST -->
    <div>
        <div class="orders-header">
            <input type="text" class="orders-search" id="searchInput" placeholder="Cari pembeli..." oninput="filterOrders()">
            <div class="filter-wrap">
                <button class="filter-btn" onclick="toggleFilter()">
                    <i class="fas fa-filter"></i> Filter
                </button>
                <div class="filter-dropdown" id="filterDropdown">
                    <div class="filter-item active" data-filter="all" onclick="setFilter('all', this)">✓ Semua</div>
                    <div class="filter-item" data-filter="completed" onclick="setFilter('completed', this)" style="color:#059669;">Lunas</div>
                    <div class="filter-item" data-filter="pending" onclick="setFilter('pending', this)" style="color:#f59e0b;">Pending</div>
                    <div class="filter-item" data-filter="expired" onclick="setFilter('expired', this)" style="color:#dc2626;">Expired</div>
                </div>
            </div>
        </div>

        <div class="order-list" id="orderList">
            <% if (locals.orders && orders.length > 0) { %>
                <% orders.forEach(function(order, idx) { %>
                    <div class="order-card <%= (locals.currentPage == 1 && idx === 0) ? 'active' : '' %>"
                         data-status="<%= order.status || 'pending' %>"
                         data-buyer="<%= (order.customer_name || order.buyer_name || '').toLowerCase() %>"
                         onclick="selectOrder(this, <%= idx %>)">
                        <div class="order-info">
                            <div class="order-date" style="display:flex; align-items:center;">
                                <span>
                                    <%= order.created_at ? new Date(order.created_at).toLocaleDateString('id-ID', { day:'numeric', month:'short', timeZone: 'Asia/Jakarta' }) : '' %>,
                                    <%= order.created_at ? new Date(order.created_at).toLocaleTimeString('id-ID', { hour:'2-digit', minute:'2-digit', timeZone: 'Asia/Jakarta' }) : '' %>
                                </span>
                                <% 
                                   let s = (order.status || 'pending').toLowerCase();
                                   if (s === 'pending') { 
                                       let nowTime = new Date().getTime();
                                       let createTime = new Date(order.created_at).getTime();
                                       let expMins = locals.expiryMins || 60;
                                       let expireTime = createTime + (expMins * 60000);
                                       let timeLeft = Math.floor((expireTime - nowTime) / 1000);
                                       if (timeLeft > 0) {
                                %>
                                    <span class="countdown-timer" data-timeleft="<%= timeLeft %>" style="margin-left: 8px; padding: 2px 8px; border: 1px solid #10b981; border-radius: 20px; font-size: 10px; color: #10b981; font-weight: 800;">
                                        --:--
                                    </span>
                                <%  } 
                                   } %>
                            </div>
                            <div class="order-buyer"><%= order.customer_name || order.buyer_name || 'Pembeli' %></div>
                            <div class="order-product"><%= order.product_name %></div>
                            <div class="order-price">Rp <%= parseFloat(order.total_price || order.amount || 0).toLocaleString('id-ID') %></div>
                        </div>
                        <div class="order-thumb-wrap">
                            <% 
                                let rawThumb = order.product_thumbnail || '';
                                let finalThumb = (rawThumb && (rawThumb.startsWith('http') || rawThumb.startsWith('/'))) ? rawThumb : (rawThumb ? '/uploads/products/' + rawThumb : '');
                            %>
                            <% if (finalThumb) { %>
                                <img src="<%= finalThumb %>" alt="TH" onerror="this.style.display='none';this.nextElementSibling.style.display='block'">
                                <i class="fas fa-shopping-bag" style="display:none"></i>
                            <% } else { %>
                                <i class="fas fa-shopping-bag"></i>
                            <% } %>
                        </div>
                        <div class="order-status <%= order.status || 'pending' %>">
                            <%= (order.status || 'pending').toUpperCase() %>
                        </div>
                        <div class="order-detail-mobile"></div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="orders-empty"><i class="fas fa-receipt"></i><div style="font-size:15px;font-weight:700;">Belum ada pesanan</div></div>
            <% } %>
        </div>

        <!-- PREMIUM PAGINATION -->
        <% if (locals.totalPages > 1) { %>
            <div class="pagination-container">
                <a href="?page=<%= currentPage - 1 %>" class="pg-btn <%= currentPage === 1 ? 'disabled' : '' %>">
                    <i class="fas fa-arrow-left"></i>
                </a>
                
                <div class="pg-num-wrap">
                    <% 
                        let start = Math.max(1, currentPage - 1);
                        let end = Math.min(totalPages, start + 2);
                        if (end === totalPages) start = Math.max(1, end - 2);
                    %>

                    <% if (start > 1) { %>
                        <a href="?page=1" class="pg-num">1</a>
                        <% if (start > 2) { %><span class="pg-dots">...</span><% } %>
                    <% } %>

                    <% for(let i = start; i <= end; i++) { %>
                        <a href="?page=<%= i %>" class="pg-num <%= currentPage === i ? 'active' : '' %>"><%= i %></a>
                    <% } %>

                    <% if (end < totalPages) { %>
                        <% if (end < totalPages - 1) { %><span class="pg-dots">...</span><% } %>
                        <a href="?page=<%= totalPages %>" class="pg-num"><%= totalPages %></a>
                    <% } %>
                </div>

                <a href="?page=<%= currentPage + 1 %>" class="pg-btn <%= currentPage === totalPages ? 'disabled' : '' %>">
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        <% } %>
    </div>

    <!-- RIGHT: DETAIL PANEL -->
    <div class="detail-panel" id="detailPanel"></div>
</div>

<script>
const ordersData = <%- JSON.stringify(orders || []) %>;
let currentFilter = 'all';

function toggleFilter() { document.getElementById('filterDropdown').classList.toggle('show'); }
document.addEventListener('click', e => { if (!e.target.closest('.filter-wrap')) document.getElementById('filterDropdown').classList.remove('show'); });

function setFilter(filter, el) {
    currentFilter = filter;
    document.querySelectorAll('.filter-item').forEach(i => i.classList.remove('active'));
    el.classList.add('active');
    document.getElementById('filterDropdown').classList.remove('show');
    filterOrders();
}

function filterOrders() {
    const search = document.getElementById('searchInput').value.toLowerCase();
    const cards = document.querySelectorAll('.order-card');
    cards.forEach(card => {
        const matchFilter = currentFilter === 'all' || card.dataset.status === currentFilter;
        const matchSearch = card.dataset.buyer.includes(search);
        card.style.display = (matchFilter && matchSearch) ? '' : 'none';
    });
}

function selectOrder(el, idx) {
    if(!el) return;
    const isMobile = window.innerWidth <= 1100;
    const o = ordersData[idx];
    if (!o) return;

    const date = o.created_at ? new Date(o.created_at) : null;
    const dateStr = date ? date.toLocaleDateString('id-ID', { day:'numeric', month:'short', timeZone: 'Asia/Jakarta' }) + ', ' + date.toLocaleTimeString('id-ID', { hour:'2-digit', minute:'2-digit', timeZone: 'Asia/Jakarta' }) : '-';
    const price = parseFloat(o.total_price || o.amount || 0).toLocaleString('id-ID');
    
    // Conditional Button Logic
    let btnLabel = 'Follow Up';
    let btnColor = '#f59e0b';
    let merchantUsername = '<%= merchantUsername %>';
    let merchantLink = window.location.origin + '/' + merchantUsername;

    if (o.status === 'completed') {
        btnLabel = 'Kirim Akses';
        btnColor = '#3b82f6';
    }

    const detailHtml = `
        <div class="detail-header">
            <div><div class="detail-ref-label">INVOICE REFERENCE</div><div class="detail-ref-id">#${o.reference_id || o.trx_id || ('INV' + o.id)}</div></div>
            <span class="detail-status ${o.status || 'pending'}">${(o.status || 'pending').toUpperCase()}</span>
        </div>
        <div class="detail-sections" style="${isMobile ? 'display:block;' : ''}">
            <div class="detail-section">
                <div class="detail-section-title">DETAIL TRANSAKSI</div>
                <div class="detail-row">Produk: <strong>${o.product_name}</strong></div>
                <div class="detail-row">Metode: <strong style="color:#3b82f6;">${(o.payment_channel || 'N/A').toUpperCase()}</strong></div>
                <div class="detail-row">Total: <div class="detail-total">Rp ${price}</div></div>
            </div>
            <div class="detail-section" style="${isMobile ? 'margin-top:20px;' : ''}">
                <div class="detail-section-title">INFORMASI PEMBELI</div>
                <div class="detail-row"><strong>${o.customer_name || o.buyer_name || 'N/A'}</strong></div>
                <div class="detail-row" style="font-size:12px; word-break: break-all;">${o.customer_email || o.buyer_email || ''}</div>
                <div class="detail-row" style="font-size:12px; margin-top:4px;"><i class="fas fa-phone"></i> ${o.customer_whatsapp || o.customer_phone || o.buyer_phone || '-'}</div>
                
                <div onclick="sendOrderEmail(${o.id}, '${o.status}')" class="mini-followup" style="background:${btnColor}; min-width: 140px; justify-content: center; cursor: pointer;">
                    <i class="fas fa-paper-plane"></i> ${btnLabel}
                </div>
            </div>
        </div>
        <div class="detail-email-status">
            <div class="detail-email-title">STATUS PENGIRIMAN EMAIL</div>
            <div class="email-steps">
                <div class="email-step">
                    <div class="email-step-icon done"><i class="fas fa-check"></i></div>
                    <div class="email-step-label">Sistem</div><div class="email-step-time">${dateStr}</div>
                </div>
                <div class="email-step">
                    <div class="email-step-icon ${o.status === 'completed' ? 'done' : ''}"><i class="fas fa-check-double"></i></div>
                    <div class="email-step-label">Terkirim</div><div class="email-step-time">${o.status === 'completed' ? dateStr : '—'}</div>
                </div>
                <div class="email-step">
                    <div class="email-step-icon ${o.last_opened_at ? 'done' : ''}"><i class="fas fa-envelope-open"></i></div>
                    <div class="email-step-label">Dibuka</div>
                    <div class="email-step-time">${o.last_opened_at ? (new Date(o.last_opened_at).toLocaleDateString('id-ID', {day:'numeric', month:'short', timeZone: 'Asia/Jakarta'}) + ', ' + new Date(o.last_opened_at).toLocaleTimeString('id-ID', {hour:'2-digit', minute:'2-digit', timeZone: 'Asia/Jakarta'})) : '—'}</div>
                </div>
            </div>
        </div>
    `;

    if (isMobile) {
        const mDetail = el.querySelector('.order-detail-mobile');
        const wasActive = el.classList.contains('active');
        
        document.querySelectorAll('.order-card').forEach(c => {
            c.classList.remove('active');
            const inner = c.querySelector('.order-detail-mobile');
            if(inner) inner.innerHTML = '';
        });

        if (!wasActive) {
            el.classList.add('active');
            mDetail.innerHTML = detailHtml;
            setTimeout(() => el.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 100);
        }
    } else {
        document.querySelectorAll('.order-card').forEach(c => c.classList.remove('active'));
        el.classList.add('active');
        const p = document.getElementById('detailPanel');
        if (p) p.innerHTML = detailHtml;
    }
}

async function sendOrderEmail(id, status) {
    const type = status === 'completed' ? 'send-access' : 'send-followup';
    const btn = event.currentTarget;
    const oldHtml = btn.innerHTML;
    
    btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Mengirim...';
    btn.style.pointerEvents = 'none';
    btn.style.opacity = '0.7';

    try {
        const res = await fetch(`/admin/orders/${type}/${id}`, { method: 'POST' });
        const data = await res.json();
        
        if (data.success) {
            alert('Sukses: ' + data.message);
        } else {
            alert('Gagal: ' + data.message);
        }
    } catch (err) {
        alert('Terjadi kesalahan network');
    } finally {
        btn.innerHTML = oldHtml;
        btn.style.pointerEvents = 'auto';
        btn.style.opacity = '1';
    }
}
if (ordersData.length > 0) selectOrder(document.querySelector('.order-card.active') || document.querySelector('.order-card'), 0);

function startCountdowns() {
    const timers = document.querySelectorAll('.countdown-timer');
    if (timers.length === 0) return;
    
    setInterval(() => {
        timers.forEach(timer => {
            let timeLeft = parseInt(timer.getAttribute('data-timeleft'));
            if (timeLeft <= 0) {
                timer.innerHTML = "EXPIRED";
                timer.style.color = "#dc2626";
                timer.style.borderColor = "#dc2626";
                if(timer.getAttribute('data-expired') !== 'true') {
                    timer.setAttribute('data-expired', 'true');
                    setTimeout(() => location.reload(), 2000);
                }
            } else {
                const m = Math.floor(timeLeft / 60);
                const s = timeLeft % 60;
                timer.innerHTML = `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
                timer.setAttribute('data-timeleft', timeLeft - 1);
            }
        });
    }, 1000);
}
startCountdowns();
</script>
