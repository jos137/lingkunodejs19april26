<style>
/* ===== ORDERS LAYOUT ===== */
.orders-wrap { display: grid; grid-template-columns: 495px 1fr; gap: 30px; align-items: start; }
.orders-header { display: flex; align-items: center; gap: 14px; margin-bottom: 22px; }
.orders-search {
    flex: 1; padding: 12px 18px; border: 1.5px solid #e5e7eb; border-radius: 12px;
    font-family: inherit; font-size: 13.5px; color: #374151; background: #fff; outline: none;
    box-shadow: 0 2px 5px rgba(0,0,0,0.02);
}
.orders-search:focus { border-color: #3b82f6; box-shadow: 0 0 0 4px rgba(59,130,246,0.1); }

/* Filter */
.filter-wrap { position: relative; display: inline-block; }
.filter-btn {
    padding: 12px 20px; border: 1.5px solid #e5e7eb; border-radius: 12px;
    background: #fff; font-size: 13.5px; font-weight: 700; color: #374151;
    cursor: pointer; display: flex; align-items: center; gap: 8px; transition: 0.2s;
}
.filter-btn:hover { background: #f9fafb; border-color: #d1d5db; }

.filter-dropdown {
    display: none; position: absolute; top: 50px; right: 0; z-index: 50;
    background: #fff; border: 1px solid #e5e7eb; border-radius: 14px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.15); min-width: 200px; padding: 10px;
}
.filter-dropdown.show { display: block; animation: fadeIn 0.2s ease-out; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }

.filter-item {
    padding: 10px 14px; border-radius: 8px; font-size: 13px; font-weight: 600;
    color: #374151; cursor: pointer; display: flex; align-items: center; gap: 8px;
    transition: 0.1s;
}
.filter-item:hover { background: #f3f4f6; }
.filter-item.active { background: #f59e0b; color: #fff; border-radius: 8px; }

/* Order Cards */
.order-list { display: flex; flex-direction: column; gap: 12px; }
.order-card {
    display: flex; align-items: flex-start; gap: 24px;
    padding: 28px 32px; background: #fff; border: 1.5px solid #e5e7eb;
    border-radius: 16px !important; cursor: pointer; transition: 0.15s; position: relative;
}
.order-card:hover { background: #f8fafc; }
.order-card.active { border-color: #10b981; background: #f0fdf4; z-index: 1; box-shadow: 0 4px 15px rgba(16,185,129,0.06); }

.order-info { flex: 1; min-width: 0; padding-right: 90px; }
.order-date { font-size: 11px; color: #94a3b8; font-weight: 700; margin-bottom: 6px; }
.order-buyer { font-size: 15px; font-weight: 900; color: #111827; margin-bottom: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.order-product { font-size: 11px; font-weight: 800; color: #f59e0b; margin-top: 2px; text-transform: uppercase; display: flex; align-items: center; gap: 8px; }
.order-price { font-size: 16px; font-weight: 600; color: #111827; margin-top: 8px; }

.order-status {
    position: absolute; top: 24px; right: 32px;
    font-size: 9.5px; font-weight: 1000; letter-spacing: 1px;
    padding: 4px 10px; border-radius: 8px; background: rgba(0,0,0,0.05);
}
.order-status.completed { color: #059669; background: rgba(16,185,129,0.1); }
.order-status.pending { color: #d97706; background: rgba(245,158,11,0.1); }
.order-status.expired { color: #dc2626; background: rgba(220,38,38,0.1); }

.order-thumb-wrap {
    width: 60px; height: 60px; border-radius: 14px; background: #f1f5f9;
    border: 1.5px solid #e2e8f0; flex-shrink: 0; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
    margin-top: 25px;
}
.order-thumb-wrap img { width: 100%; height: 100%; object-fit: cover; }
.order-thumb-wrap i { color: #cbd5e1; font-size: 24px; }

/* PREMIUM PAGINATION */
.pagination-container {
    display: flex; justify-content: center; align-items: center; gap: 24px;
    margin-top: 40px; padding: 20px 0;
}
.pg-btn {
    font-size: 20px; color: #64748b; cursor: pointer; text-decoration: none;
    transition: 0.2s; display: flex; align-items: center; justify-content: center;
}
.pg-btn:hover { color: #111827; }
.pg-btn.disabled { color: #e2e8f0; cursor: not-allowed; pointer-events: none; }

.pg-num-wrap { display: flex; align-items: center; gap: 18px; }
.pg-num {
    font-size: 18px; font-weight: 600; color: #64748b; text-decoration: none;
    transition: 0.2s; min-width: 24px; text-align: center;
}
.pg-num:hover { color: #111827; }
.pg-num.active { color: #111827; font-weight: 800; cursor: default; }
.pg-dots { font-size: 18px; color: #94a3b8; font-weight: 600; cursor: default; }

/* ===== DETAIL PANEL ===== */
.detail-panel {
    background: #fff; border: 1.5px solid #e5e7eb; border-radius: 20px;
    padding: 35px; position: sticky; top: 25px; box-shadow: 0 10px 40px rgba(0,0,0,0.04);
}

/* Mobile */
.order-detail-mobile { display: none; width: 100%; border-top: 1.5px solid #f1f5f9; margin-top: 20px; padding-top: 25px; }

/* Mobile Fixes */
.mobile-timer-wrap { display: none; }
@media (max-width: 1100px) { 
    .orders-wrap { grid-template-columns: 1fr; } 
    .detail-panel { display: none; }
    .order-card { flex-direction: column; align-items: flex-start; padding: 25px 20px; }
    .order-card.active .order-detail-mobile { display: block; }
    
    /* Hide desktop timer on mobile */
    .desktop-timer { display: none !important; }
    
    /* Position image to the right of buyer info */
    .order-thumb-wrap { 
        position: absolute; top: 62px; right: 20px; 
        width: 50px; height: 50px; margin-top: 0;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }
    
    /* Show mobile timer next to status */
    .mobile-timer-wrap { 
        display: flex; align-items: center; gap: 8px;
        position: absolute; top: 24px; right: 98px;
    }
    
    /* Align Status badge nicely on mobile */
    .order-status { top: 24px; right: 20px; }

    /* Hide status in detail panel on mobile */
    .detail-status-badge { display: none !important; }
    .mobile-timer-val {
        font-size: 11px; font-weight: 850; color: #10b981; 
        background: #f0fdf4; padding: 2px 8px; border-radius: 6px; border: 1px solid #10b98133;
    }
    
    /* NEW: Detail Grid Responsive Fix */
    .detail-grid { grid-template-columns: 1.2fr 1fr; }
    @media (max-width: 768px) {
        .detail-grid { grid-template-columns: 1fr !important; gap: 15px !important; }
        .detail-total-price { font-size: 16px !important; }
        .detail-total-price span { font-size: 11px !important; }
    }

    /* Remove timer from detail panel on mobile */
    .detail-timer-wrap { display: none !important; }
}
</style>

<div class="orders-wrap">
    <!-- LEFT: ORDER LIST -->
    <div>
        <div class="orders-header">
            <form action="/admin/orders" method="GET" style="flex: 1; display: flex; gap: 8px; margin: 0; padding: 0;">
                <select name="searchType" style="border: 1.5px solid #e5e7eb; border-radius: 12px; font-weight: 700; padding: 0 14px; outline: none; background: #fff; font-size: 13px; color: #374151; font-family: inherit; cursor: pointer; box-shadow: 0 2px 5px rgba(0,0,0,0.02); transition: 0.2s;">
                    <option value="all" <%= locals.searchType === 'all' ? 'selected' : '' %>>Semua</option>
                    <option value="name" <%= locals.searchType === 'name' ? 'selected' : '' %>>Nama</option>
                    <option value="email" <%= locals.searchType === 'email' ? 'selected' : '' %>>Email</option>
                    <option value="phone" <%= locals.searchType === 'phone' ? 'selected' : '' %>>No. WA</option>
                </select>
                <div style="position: relative; flex: 1; display: flex; align-items: center;">
                    <input type="text" name="search" class="orders-search" id="searchInput" placeholder="Cari pembeli... (Tekan Enter / Klik Tombol Cari)" value="<%= locals.searchQuery || '' %>" oninput="filterOrders()" onkeydown="if(event.key === 'Enter') { event.preventDefault(); this.form.submit(); }" style="width: 100%; padding-right: 40px; box-shadow: 0 2px 5px rgba(0,0,0,0.02);">
                    <button type="button" onclick="this.form.submit()" style="position: absolute; right: 12px; background: none; border: none; color: #9ca3af; cursor: pointer; padding: 4px; display: flex; align-items: center; justify-content: center; font-size: 15px; transition: color 0.2s;" onmouseover="this.style.color='#3b82f6'" onmouseout="this.style.color='#9ca3af'">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </form>
            <div class="filter-wrap">
                <button class="filter-btn" onclick="toggleFilter()">
                    <i class="fas fa-filter"></i> Filter
                </button>
                <div class="filter-dropdown" id="filterDropdown">
                    <div class="filter-item active" data-filter="all" onclick="setFilter('all', this)">✓ Semua</div>
                    <div class="filter-item" data-filter="completed" onclick="setFilter('completed', this)" style="color:#059669;">Lunas</div>
                    <div class="filter-item" data-filter="pending" onclick="setFilter('pending', this)" style="color:#f59e0b;">Pending</div>
                    <div class="filter-item" data-filter="expired" onclick="setFilter('expired', this)" style="color:#dc2626;">Expired</div>
                </div>
            </div>
        </div>

        <div class="order-list" id="orderList">
            <% if (orders.length > 0) { %>
                <% orders.forEach(function(o, idx) { %>
                    <div class="order-card" data-status="<%= o.status %>" data-buyer="<%= o.customer_name.toLowerCase() %>" onclick="selectOrder(this, <%= idx %>)">
                        <div class="order-info">
                            <div class="order-date"><%= o.formatted_date %></div>
                            <div class="order-buyer">
                                <%= o.customer_name %>
                            </div>
                            <div class="order-product">
                                <%= o.product_name %>
                                <% if (o.status === 'pending') { %>
                                    <span class="countdown-timer desktop-timer" style="font-size: 11px; font-weight: 850; color: #10b981; background: #f0fdf4; padding: 2px 8px; border-radius: 6px; margin-left: 10px; border: 1px solid #10b98133;" data-timeleft="<%= o.time_left %>" data-idx="<%= idx %>">00:00</span>
                                <% } %>
                            </div>
                            <div class="order-price">Rp <%= parseFloat(o.total_price || 0).toLocaleString('id-ID') %></div>
                        </div>
                        <div class="order-thumb-wrap">
                            <% if (o.product_thumbnail) { %>
                                <img src="<%= img(o.product_thumbnail, 'products') %>" alt="Product" onerror="this.onerror=null; this.src='/images/placeholder.png'">
                            <% } else { %>
                                <i class="fas fa-shopping-bag"></i>
                            <% } %>
                        </div>
                        
                        <!-- Mobile Timer -->
                        <% if (o.status === 'pending') { %>
                            <div class="mobile-timer-wrap">
                                <span class="countdown-timer mobile-timer-val" data-timeleft="<%= o.time_left %>" data-idx="<%= idx %>">00:00</span>
                            </div>
                        <% } %>

                        <div class="order-status <%= (o.status || 'pending') %>"><%= (o.status || 'pending').toUpperCase() %></div>

                        <!-- For Mobile -->
                        <div class="order-detail-mobile"></div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="orders-empty">
                    <i class="fas fa-receipt" style="font-size:40px; margin-bottom:10px;"></i>
                    <p>Belum ada pesanan yang masuk.</p>
                </div>
            <% } %>
        </div>

        <% if (totalPages > 1) { %>
            <div class="pagination-container">
                <a href="?page=<%= currentPage - 1 %><%= locals.searchQuery ? '&search=' + encodeURIComponent(searchQuery) + '&searchType=' + locals.searchType : '' %>" class="pg-btn <%= currentPage === 1 ? 'disabled' : '' %>">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div class="pg-num-wrap">
                    <% 
                        let start = Math.max(1, currentPage - 1);
                        let end = Math.min(totalPages, start + 2);
                        if (end - start < 2) start = Math.max(1, end - 2);
                    %>
                    <% if (start > 1) { %>
                        <a href="?page=1<%= locals.searchQuery ? '&search=' + encodeURIComponent(searchQuery) + '&searchType=' + locals.searchType : '' %>" class="pg-num">1</a>
                        <% if (start > 2) { %><span class="pg-dots">...</span><% } %>
                    <% } %>
                    <% for(let i = start; i <= end; i++) { %>
                        <a href="?page=<%= i %><%= locals.searchQuery ? '&search=' + encodeURIComponent(searchQuery) + '&searchType=' + locals.searchType : '' %>" class="pg-num <%= i === currentPage ? 'active' : '' %>"><%= i %></a>
                    <% } %>
                    <% if (end < totalPages) { %>
                        <% if (end < totalPages - 1) { %><span class="pg-dots">...</span><% } %>
                        <a href="?page=<%= totalPages %><%= locals.searchQuery ? '&search=' + encodeURIComponent(searchQuery) + '&searchType=' + locals.searchType : '' %>" class="pg-num"><%= totalPages %></a>
                    <% } %>
                </div>
                <a href="?page=<%= currentPage + 1 %><%= locals.searchQuery ? '&search=' + encodeURIComponent(searchQuery) + '&searchType=' + locals.searchType : '' %>" class="pg-btn <%= currentPage === totalPages ? 'disabled' : '' %>">
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        <% } %>
    </div>

    <!-- RIGHT: DETAIL PANEL -->
    <div class="detail-panel" id="detailPanel"></div>
</div>

<script>
const ordersData = <%- JSON.stringify(orders || []) %>;
let currentFilter = 'all';

function toggleFilter() { document.getElementById('filterDropdown').classList.toggle('show'); }
document.addEventListener('click', e => { if (!e.target.closest('.filter-wrap')) document.getElementById('filterDropdown').classList.remove('show'); });

function setFilter(filter, el) {
    currentFilter = filter;
    document.querySelectorAll('.filter-item').forEach(i => i.classList.remove('active'));
    el.classList.add('active');
    document.getElementById('filterDropdown').classList.remove('show');
    filterOrders();
}

function filterOrders() {
    const search = document.getElementById('searchInput').value.toLowerCase();
    const cards = document.querySelectorAll('.order-card');
    cards.forEach(card => {
        const matchFilter = currentFilter === 'all' || card.dataset.status === currentFilter;
        const matchSearch = card.dataset.buyer.includes(search);
        card.style.display = (matchFilter && matchSearch) ? '' : 'none';
    });
}

function renderOrderDetail(o, idx) {
    const isCompleted = o.status === 'completed';
    const statusColor = isCompleted ? '#10b981' : '#f59e0b';
    const btnColor = isCompleted ? '#3b82f6' : '#10b981';
    const btnLabel = isCompleted ? 'Kirim Akses' : 'Follow Up';
    
    return `
        <!-- Header -->
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px; padding-bottom:12px; border-bottom:1px solid #f1f5f9;">
            <div>
                <div style="font-size:9px; color:#94a3b8; font-weight:800; text-transform:uppercase; letter-spacing:1px; margin-bottom:2px;">Invoice Reference</div>
                <div style="font-size:14px; font-weight:900; color:#111827;">#${o.reference_id}</div>
            </div>
            <div style="display:flex; align-items:center; gap:12px;">
                ${o.status === 'pending' ? `
                    <div style="font-size:11px; color:#ef4444; font-weight:700; display:flex; align-items:center; gap:4px;">
                        <i class="fas fa-history"></i>
                        <span class="countdown-timer" data-timeleft="${o.time_left}" data-idx="${idx}">--:--</span>
                    </div>
                ` : ''}
                <div class="detail-status-badge" style="background:${statusColor}15; color:${statusColor}; padding:4px 12px; border-radius:100px; font-size:10px; font-weight:900; letter-spacing:0.5px; border:1px solid ${statusColor}33;">
                    ${(o.status || 'PENDING').toUpperCase()}
                </div>
            </div>
        </div>

        <div class="detail-grid" style="display:grid; gap:12px;">
            <!-- Transaction Detail -->
            <div style="background:#f8fafc; border:1px solid #f1f5f9; border-radius:14px; padding:15px;">
                <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10px;">
                    <div style="font-size:10px; color:#94a3b8; font-weight:800; text-transform:uppercase;">Detail Transaksi</div>
                    <div style="font-size:11px; font-weight:800; color:#3b82f6; text-transform:uppercase;">${o.payment_channel || 'N/A'}</div>
                </div>
                <div style="font-size:13px; font-weight:800; color:#1e293b; margin-bottom:12px; line-height:1.4;">${o.product_name}</div>
                
                <div class="detail-total-wrap" style="padding-top:10px; border-top:1px dashed #e2e8f0; display:flex; justify-content:space-between; align-items:center;">
                    <div style="font-size:11px; color:#64748b;">Total Bayar</div>
                    <div class="detail-total-price" style="font-size:20px; font-weight:800; color:#059669; letter-spacing:-0.5px;">
                        <span style="font-size:13px; font-weight:700; margin-right:2px;">Rp</span>${parseFloat(o.total_price || 0).toLocaleString('id-ID')}
                    </div>
                </div>
            </div>

            <!-- Buyer Info (Compact Row) -->
            <div style="background:#fff; border:1px solid #f1f5f9; border-radius:14px; padding:15px; box-shadow:0 4px 15px rgba(0,0,0,0.02);">
                <div style="font-size:10px; color:#94a3b8; font-weight:800; text-transform:uppercase; margin-bottom:12px;">Informasi Pembeli</div>
                
                <div style="display:flex; justify-content:space-between; align-items:center; gap:15px; flex-wrap:wrap;">
                    <div style="flex:1; min-width:200px;">
                        <div style="font-size:14px; font-weight:850; color:#111827; margin-bottom:2px;">${o.customer_name || 'N/A'}</div>
                        <div style="display:flex; gap:12px; font-size:11px; color:#64748b;">
                            <span><i class="far fa-envelope" style="margin-right:3px;"></i> ${o.customer_email || ''}</span>
                            <span><i class="fab fa-whatsapp" style="color:#10b981; margin-right:3px;"></i> ${o.customer_whatsapp || '-'}</span>
                        </div>
                    </div>
                    
                    <div onclick="sendOrderEmail(${o.id}, '${o.status}')" style="padding:10px 20px; background:${btnColor}; color:#fff; border-radius:10px; text-align:center; font-size:12px; font-weight:800; cursor:pointer; box-shadow:0 4px 12px ${btnColor}33; transition:0.2s; white-space:nowrap;">
                        <i class="fas fa-paper-plane" style="margin-right:6px;"></i> ${btnLabel}
                    </div>
                </div>
            </div>
        </div>

        <!-- Email Status Timeline (Ultra Compact) -->
        <div style="margin-top:15px; padding-top:12px; border-top:1px solid #f1f5f9;">
            <div style="display:flex; justify-content:space-between; position:relative; max-width:350px; margin:0 auto; padding-bottom:5px;">
                <div style="position:absolute; top:12px; left:0; right:0; height:2px; background:#f1f5f9; z-index:1;"></div>
                <div style="position:absolute; top:12px; left:0; width:${o.is_opened ? '100%' : (o.is_sent ? '50%' : '0%')}; height:2px; background:#10b981; z-index:1; transition:0.5s;"></div>

                <div style="position:relative; z-index:2; text-align:center;">
                    <div style="width:24px; height:24px; border-radius:50%; background:${o.status === 'pending' ? '#f59e0b' : '#10b981'}; color:#fff; display:flex; align-items:center; justify-content:center; margin:0 auto 4px; box-shadow:0 0 0 3px #fff;">
                        <i class="fas fa-${o.status === 'pending' ? 'clock' : 'check'}" style="font-size:10px;"></i>
                    </div>
                    <div style="font-size:9px; font-weight:800; color:#111827;">Sistem</div>
                </div>

                <div style="position:relative; z-index:2; text-align:center;">
                    <div style="width:24px; height:24px; border-radius:50%; background:${o.is_sent ? '#10b981' : '#fff'}; color:${o.is_sent ? '#fff' : '#cbd5e1'}; border:${o.is_sent ? 'none' : '2px solid #f1f5f9'}; display:flex; align-items:center; justify-content:center; margin:0 auto 4px; box-shadow:0 0 0 3px #fff;">
                        <i class="fas fa-paper-plane" style="font-size:10px;"></i>
                    </div>
                    <div style="font-size:9px; font-weight:800; color:${o.is_sent ? '#111827' : '#cbd5e1'};">Terkirim</div>
                </div>

                <div style="position:relative; z-index:2; text-align:center;">
                    <div style="width:24px; height:24px; border-radius:50%; background:${o.is_opened ? '#10b981' : '#fff'}; color:${o.is_opened ? '#fff' : '#cbd5e1'}; border:${o.is_opened ? 'none' : '2px solid #f1f5f9'}; display:flex; align-items:center; justify-content:center; margin:0 auto 4px; box-shadow:0 0 0 3px #fff;">
                        <i class="fas fa-envelope-open" style="font-size:10px;"></i>
                    </div>
                    <div style="font-size:9px; font-weight:800; color:${o.is_opened ? '#111827' : '#cbd5e1'};">Dibuka</div>
                </div>
            </div>
        </div>
    `;
}

function selectOrder(el, idx) {
    if(!el) return;
    const isMobile = window.innerWidth <= 1100;
    const o = ordersData[idx];
    if (!o) return;

    // Check if it's already active
    const wasActive = el.classList.contains('active');

    // Close all first
    document.querySelectorAll('.order-card').forEach(c => c.classList.remove('active'));
    document.querySelectorAll('.order-detail-mobile').forEach(inner => inner.innerHTML = '');

    // If it wasn't active before, open it
    if (!wasActive) {
        el.classList.add('active');
        const html = renderOrderDetail(o, idx);

        if (isMobile) {
            const mDetail = el.querySelector('.order-detail-mobile');
            mDetail.innerHTML = html;
            setTimeout(() => el.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 100);
        } else {
            const p = document.getElementById('detailPanel');
            if (p) p.innerHTML = html;
        }
    } else {
        // If it was active and we're on desktop, maybe clear the detail panel or leave it empty
        if (!isMobile) {
            const p = document.getElementById('detailPanel');
            if (p) p.innerHTML = '<div style="text-align:center; color:#94a3b8; padding-top:100px;"><i class="fas fa-receipt" style="font-size:40px; margin-bottom:10px;"></i><p>Pilih pesanan untuk melihat detail</p></div>';
        }
    }
}

async function sendOrderEmail(id, status) {
    const type = status === 'completed' ? 'send-access' : 'send-followup';
    const btn = event.currentTarget;
    const oldHtml = btn.innerHTML;
    
    btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Mengirim...';
    btn.style.pointerEvents = 'none';
    btn.style.opacity = '0.7';

    try {
        const res = await fetch(`/admin/orders/${type}/${id}`, { method: 'POST' });
        const data = await res.json();
        alert(data.message);
    } catch (err) {
        alert('Terjadi kesalahan network');
    } finally {
        btn.innerHTML = oldHtml;
        btn.style.pointerEvents = 'auto';
        btn.style.opacity = '1';
    }
}

if (ordersData.length > 0) selectOrder(document.querySelector('.order-card'), 0);

function startCountdowns() {
    setInterval(() => {
        const timers = document.querySelectorAll('.countdown-timer');
        timers.forEach(timer => {
            let timeLeft = parseInt(timer.getAttribute('data-timeleft'));
            const orderIdx = parseInt(timer.getAttribute('data-idx'));
            
            if (timeLeft <= 0) {
                timer.innerHTML = "00:00";
                
                // Dynamic state transition to EXPIRED in client UI
                if (!isNaN(orderIdx) && ordersData[orderIdx] && ordersData[orderIdx].status === 'pending') {
                    ordersData[orderIdx].status = 'expired';
                    
                    // Find card DOM element
                    const card = timer.closest('.order-card') || document.querySelector(`.order-card[onclick*="selectOrder(this, ${orderIdx})"]`);
                    if (card) {
                        card.dataset.status = 'expired';
                        
                        // Update status badge on card
                        const statusBadge = card.querySelector('.order-status');
                        if (statusBadge) {
                            statusBadge.className = 'order-status expired';
                            statusBadge.innerHTML = 'EXPIRED';
                        }
                        
                        // Hide the countdown badge on the card
                        const cardTimer = card.querySelector('.countdown-badge');
                        if (cardTimer) {
                            cardTimer.style.display = 'none';
                        }
                        
                        // If this card is active, also update the detail panel
                        if (card.classList.contains('active')) {
                            const detailStatus = document.querySelector('.detail-status-badge');
                            if (detailStatus) {
                                detailStatus.style.background = '#dc262615';
                                detailStatus.style.color = '#dc2626';
                                detailStatus.style.borderColor = '#dc262633';
                                detailStatus.innerHTML = 'EXPIRED';
                            }
                            const detailTimerWrap = document.querySelector('.countdown-timer')?.closest('div');
                            if (detailTimerWrap) {
                                detailTimerWrap.style.display = 'none';
                            }
                        }
                    }
                }
            } else {
                const m = Math.floor(timeLeft / 60);
                const s = timeLeft % 60;
                timer.innerHTML = `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
                const nextTime = timeLeft - 1;
                timer.setAttribute('data-timeleft', nextTime);
                
                // Keep the global data synchronized so detail panel stays accurate
                if (!isNaN(orderIdx) && ordersData[orderIdx]) {
                    ordersData[orderIdx].time_left = nextTime;
                }
            }
        });
    }, 1000);
}
startCountdowns();
</script>
