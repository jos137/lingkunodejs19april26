<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lupa Password — Lingku.xyz</title>
    <link rel="icon" type="image/x-icon" href="/images/fav.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 20px;
            background:
                radial-gradient(800px 420px at 85% -60px, rgba(16, 185, 129, 0.16), transparent 60%),
                radial-gradient(700px 400px at 5% 110%, rgba(59, 130, 246, 0.12), transparent 60%),
                linear-gradient(180deg, #f2faf6 0%, #eef4fb 100%);
            position: relative;
            -webkit-font-smoothing: antialiased;
        }
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background-image:
                linear-gradient(rgba(15, 23, 42, 0.05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(15, 23, 42, 0.05) 1px, transparent 1px);
            background-size: 44px 44px;
            mask-image: radial-gradient(720px 480px at 50% 30%, #000 25%, transparent 75%);
            -webkit-mask-image: radial-gradient(720px 480px at 50% 30%, #000 25%, transparent 75%);
            pointer-events: none;
        }
        .blob {
            position: fixed;
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.45;
            pointer-events: none;
            animation: drift 16s ease-in-out infinite alternate;
        }
        .blob.b1 { width: 380px; height: 380px; background: #a7f3d0; top: -120px; right: -90px; }
        .blob.b2 { width: 300px; height: 300px; background: #bfdbfe; bottom: -110px; left: -90px; animation-delay: -7s; }
        @keyframes drift {
            from { transform: translate(0, 0) scale(1); }
            to { transform: translate(-46px, 36px) scale(1.1); }
        }

        .fp-wrap {
            position: relative;
            z-index: 2;
            width: 420px;
            max-width: 100%;
            animation: rise 0.7s cubic-bezier(0.16, 1, 0.3, 1);
        }
        @keyframes rise {
            from { opacity: 0; transform: translateY(26px); }
            to { opacity: 1; transform: none; }
        }

        .fp-logo { text-align: center; margin-bottom: 22px; }
        .fp-logo a { display: inline-block; transition: transform 0.25s; }
        .fp-logo a:hover { transform: translateY(-2px); }
        .fp-logo img { height: 52px; filter: drop-shadow(0 8px 18px rgba(2, 32, 24, 0.15)); }

        .fp-card {
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(20px) saturate(1.3);
            -webkit-backdrop-filter: blur(20px) saturate(1.3);
            border: 1px solid rgba(255, 255, 255, 0.9);
            border-radius: 28px;
            padding: 38px 36px 32px;
            box-shadow: 0 30px 70px rgba(2, 32, 24, 0.12);
            text-align: center;
        }
        .fp-ico {
            width: 64px;
            height: 64px;
            border-radius: 20px;
            background: linear-gradient(135deg, #3b82f6, #1d4ed8);
            color: #fff;
            font-size: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            box-shadow: 0 12px 26px rgba(59, 130, 246, 0.4);
        }
        .fp-card h1 { font-size: 22px; font-weight: 800; letter-spacing: -0.5px; color: #0f172a; }
        .fp-card > p { font-size: 13px; color: #64748b; margin: 8px 0 24px; line-height: 1.65; }
        .fp-card form { text-align: left; }

        .form-group { margin-bottom: 18px; }
        .form-label { display: block; font-size: 12px; font-weight: 700; color: #334155; margin-bottom: 7px; }
        .input-wrap { position: relative; }
        .input-wrap > i {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 14px;
            pointer-events: none;
        }
        .form-input {
            width: 100%;
            padding: 13px 16px 13px 44px;
            border: 1.5px solid #e2e8f0;
            border-radius: 14px;
            font-size: 14px;
            font-weight: 600;
            font-family: inherit;
            color: #0f172a;
            background: #f8fafc;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
        }
        .form-input::placeholder { color: #b6c2d1; font-weight: 500; }
        .form-input:focus {
            border-color: #10b981;
            background: #fff;
            box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.12);
        }

        .fp-btn {
            width: 100%;
            padding: 15px;
            background: linear-gradient(135deg, #10b981, #059669);
            color: #fff;
            border: none;
            border-radius: 100px;
            font-size: 15px;
            font-weight: 800;
            font-family: inherit;
            cursor: pointer;
            transition: transform 0.25s, box-shadow 0.25s;
            box-shadow: 0 10px 26px rgba(16, 185, 129, 0.4);
            position: relative;
            overflow: hidden;
        }
        .fp-btn::after {
            content: '';
            position: absolute;
            top: 0;
            left: -80%;
            width: 55%;
            height: 100%;
            background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.45), transparent);
            transform: skewX(-20deg);
        }
        .fp-btn:hover { transform: translateY(-2px); box-shadow: 0 14px 34px rgba(16, 185, 129, 0.5); }
        .fp-btn:hover::after { animation: shine 0.8s ease; }
        @keyframes shine { to { left: 130%; } }

        .fp-alert {
            display: flex;
            gap: 10px;
            align-items: flex-start;
            padding: 13px 15px;
            margin-bottom: 18px;
            font-size: 13px;
            font-weight: 600;
            line-height: 1.5;
            border-radius: 14px;
            text-align: left;
        }
        .fp-error { background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; }
        .fp-success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; }

        .fp-back { text-align: center; margin-top: 20px; font-size: 13px; color: #94a3b8; font-weight: 500; }
        .fp-back a { color: #059669; text-decoration: none; font-weight: 800; }
        .fp-back a:hover { text-decoration: underline; }
        .fp-footer { text-align: center; margin-top: 26px; font-size: 11px; color: #b6c2d1; font-weight: 500; }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
        }
    </style>
</head>
<body>
    <div class="blob b1"></div>
    <div class="blob b2"></div>

    <div class="fp-wrap">
        <div class="fp-logo">
            <a href="/">
                <img src="/images/logo.png" alt="Lingku">
            </a>
        </div>

        <div class="fp-card">
            <div class="fp-ico"><i class="fas fa-key"></i></div>
            <h1>Lupa password?</h1>
            <p>Masukkan email yang terdaftar.</p>

            <% if (locals.error) { %>
                <div class="fp-alert fp-error"><i class="fas fa-circle-exclamation" style="margin-top:2px;"></i><span><%= error %></span></div>
            <% } %>
            <% if (locals.success) { %>
                <div class="fp-alert fp-success"><i class="fas fa-circle-check" style="margin-top:2px;"></i><span><%= success %></span></div>
            <% } %>

            <form action="/auth/forgot-password" method="POST">
                <div class="form-group">
                    <label class="form-label" for="email">Email</label>
                    <div class="input-wrap">
                        <i class="far fa-envelope"></i>
                        <input type="email" id="email" name="email" class="form-input" placeholder="nama@email.com" required autofocus autocomplete="email">
                    </div>
                </div>

                <button type="submit" class="fp-btn">Kirim Tautan Reset <i class="fas fa-paper-plane" style="margin-left:6px; font-size:13px;"></i></button>
            </form>

            <div class="fp-back">
                Ingat passwordnya? <a href="/auth/login">Masuk</a>
            </div>
        </div>

        <div class="fp-footer">
            &copy; 2026 Lingku.xyz
        </div>
    </div>

</body>
</html>
