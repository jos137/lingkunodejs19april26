<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - Lingku.xyz</title>
    <link rel="icon" type="image/x-icon" href="/images/fav.ico">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background: #f3f4f6; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
        .auth-card { background: white; padding: 40px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); width: 350px; }
        h2 { text-align: center; color: #111827; margin-bottom: 30px; font-weight: 700; }
        .form-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; font-size: 14px; font-weight: 500; color: #374151; }
        input, select { width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box; }
        .btn { width: 100%; padding: 10px; background: #e83a6b; color: white; border: none; border-radius: 4px; font-weight: 600; cursor: pointer; }
        .btn:hover { background: #d11e51; }
        .link { display: block; text-align: center; margin-top: 15px; font-size: 14px; color: #3b82f6; text-decoration: none; }
    </style>
</head>
<body>
    <div class="auth-card">
        <div style="text-align: center; margin-bottom: 25px;">
            <img src="/images/logo.png" alt="Logo" style="height: 50px;">
        </div>
        <% if (error) { %>
            <div style="background: #fee2e2; color: #ef4444; padding: 10px; border-radius: 4px; font-size: 13px; margin-bottom: 15px; text-align: center;">
                <%= error %>
            </div>
        <% } %>
        <form action="/auth/register" method="POST">
            <div class="form-group">
                <label>Full Name</label>
                <input type="text" name="fullname" required>
            </div>
            <div class="form-group">
                <label>Email Address</label>
                <input type="email" name="email" required>
            </div>
            <div class="form-group">
                <label>WhatsApp Number</label>
                <input type="text" name="whatsapp" required placeholder="628...">
            </div>
            <div class="form-group">
                <label>Password</label>
                <input type="password" name="password" required>
            </div>
            <% if (locals.captchaEnabled !== false) { %>
            <div class="form-group">
                <label>Security Code</label>
                <div style="display: flex; gap: 8px; align-items: center;">
                    <input type="text" id="captcha" name="captcha" placeholder="input code" required autocomplete="off" style="text-transform: lowercase; font-weight: 500; border-color: #cbd5e1; background: #f8fafc; color: #334155;">
                    <div style="display: flex; align-items: center; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 4px; padding: 1px 4px; opacity: 0.9;">
                        <img id="captchaImgReg" src="/auth/captcha" alt="CAPTCHA" style="height: 34px; cursor: pointer; border-radius: 3px;" title="Klik untuk ganti gambar" onclick="refreshCaptchaReg()">
                        <button type="button" onclick="refreshCaptchaReg()" style="background: none; border: none; cursor: pointer; padding: 2px 4px; color: #94a3b8; font-size: 13px; transition: color 0.15s;" onmouseover="this.style.color='#64748b'" onmouseout="this.style.color='#94a3b8'" title="Refresh CAPTCHA">🔄</button>
                    </div>
                </div>
            </div>
            <% } %>
            <button type="submit" class="btn">Register</button>
        </form>
        <script>
            function refreshCaptchaReg() {
                document.getElementById('captchaImgReg').src = '/auth/captcha?' + Date.now();
            }
        </script>
        <a href="/auth/login" class="link">Already have an account? Login</a>
    </div>
</body>
</html>
