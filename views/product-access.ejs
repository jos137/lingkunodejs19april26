<!doctype html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="referrer" content="no-referrer">
    <title><%= product.name || product.title || 'Akses Produk' %> — Lingku</title>
    <style>
        :root { --ink:#1e3047; --muted:#6b7582; --paper:#f8f9fb; }
        * { box-sizing:border-box; }
        body { margin:0; color:var(--ink); background:var(--paper); font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; -webkit-font-smoothing:antialiased; }
        .page { max-width:620px; margin:auto; padding:40px 24px 24px; }
        .masthead { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:22px; }
        .brand { font-size:20px; font-weight:750; letter-spacing:-.8px; }
        .brand span { color:#8d7957; }
        .masthead-note { display:flex; align-items:center; gap:6px; font-size:11px; color:var(--muted); }
        svg { flex-shrink:0; }
        main { background:#fff; border:1px solid #e3e7ed; border-radius:16px; box-shadow:0 6px 24px #1e304704; overflow:hidden; }
        .hero { padding:25px 26px 22px; background:#ecfdf3; border-bottom:1px solid #d5efdf; }
        .status { display:inline-flex; align-items:center; gap:6px; color:#327458; font-size:11px; font-weight:500; }
        h1 { margin:13px 0 0; font-size:23px; line-height:1.4; font-weight:650; letter-spacing:-.6px; overflow-wrap:anywhere; }
        .intro { margin:10px 0 0; color:var(--muted); font-size:13px; line-height:1.7; }
        .content { padding:22px 26px 24px; }
        .section-heading { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:15px; }
        h2 { font-size:13px; margin:0; font-weight:600; }
        .count { font-size:11px; color:var(--muted); white-space:nowrap; }
        .access-list { list-style:none; padding:0; margin:0; display:grid; gap:8px; }
        .access-card { display:flex; align-items:center; gap:11px; min-height:58px; padding:11px 13px; background:#fff; color:var(--ink); text-decoration:none; border:1px solid #e5e9ee; border-radius:10px; transition:background .15s,border-color .15s; }
        .access-card:hover { border-color:#b6c6d9; background:#f8fafc; }
        .access-card:focus-visible { outline:2px solid #4975a9; outline-offset:3px; }
        .link-icon { display:grid; place-items:center; width:32px; height:32px; border-radius:8px; color:#58718b; background:#f1f4f8; flex-shrink:0; }
        .link-icon svg { width:17px; height:17px; }
        .link-copy { flex:1; min-width:0; }
        .link-name { display:block; font-size:13px; font-weight:550; line-height:1.5; overflow-wrap:anywhere; }
        .open-link { display:flex; align-items:center; gap:7px; color:#657b94; font-size:11px; flex-shrink:0; }
        .note { display:flex; align-items:flex-start; gap:7px; padding-top:16px; color:var(--muted); font-size:11px; line-height:1.7; }
        .note svg { margin-top:2px; color:#8693a1; width:13px; height:13px; }
        .note p { margin:0; }
        .empty-state { padding:22px 16px; text-align:center; border:1px dashed #d5dce5; background:#fafbfd; border-radius:10px; }
        .empty-state h3 { font-size:14px; margin:0 0 8px; }
        .empty-state p { font-size:12px; color:var(--muted); line-height:1.7; margin:0; }
        footer { text-align:center; padding-top:20px; font-size:11px; color:#7c8794; line-height:1.7; }
        footer strong { color:#53647a; font-weight:600; }
        @media(max-width:480px) {
            .page { padding:24px 16px; }
            .masthead { margin-bottom:18px; }
            .hero { padding:22px 20px 20px; }
            h1 { font-size:20px; }
            .content { padding:20px; }
            .access-card { padding:10px; gap:9px; }
            .open-link span { display:none; }
        }
        @media(prefers-reduced-motion:reduce) { .access-card { transition:none; } }
    </style>
</head>
<body>
    <div class="page">
        <header class="masthead">
            <div class="brand" aria-label="Lingku">Lingku<span>.</span></div>
            <div class="masthead-note">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"/></svg>
                Akses pembelian
            </div>
        </header>
        <main>
            <section class="hero" aria-labelledby="product-title">
                <div class="status"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg> Pembayaran berhasil</div>
                <h1 id="product-title"><%= product.name || product.title || 'Akses Produk' %></h1>
                <p class="intro">Terima kasih atas pembelian Anda. Silakan buka akses produk di bawah.</p>
            </section>
            <section class="content" aria-labelledby="access-title">
                <div class="section-heading"><h2 id="access-title">Akses produk Anda</h2><span class="count"><%= links.length %> link akses</span></div>
                <% if (links.length) { %>
                <ul class="access-list">
                    <% links.forEach(link => { %>
                    <li><a class="access-card" href="<%= link.url %>" target="_blank" rel="noopener noreferrer">
                        <span class="link-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m10 13 4-4M8 16l-1 1a3.54 3.54 0 0 1-5-5l4-4a3.54 3.54 0 0 1 5 0M16 8l1-1a3.54 3.54 0 0 1 5 5l-4 4a3.54 3.54 0 0 1-5 0" transform="translate(0 -1)"/></svg></span>
                        <span class="link-copy"><span class="link-name"><%= link.name || 'Akses Produk' %></span></span>
                        <span class="open-link"><span>Buka</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></span>
                    </a></li>
                    <% }); %>
                </ul>
                <div class="note"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7v1"/></svg><p>Tautan terbuka di tab baru. Simpan email pembelian untuk mengaksesnya kembali.</p></div>
                <% } else { %>
                <div class="empty-state"><h3>Akses sedang disiapkan</h3><p>Link akses belum tersedia. Silakan hubungi penjual untuk mendapatkan informasi selanjutnya.</p></div>
                <% } %>
            </section>
        </main>
        <footer>Powered by <strong>Lingku</strong></footer>
    </div>
</body>
</html>
