            font-size: 13px;
            color: #64748b;
            margin-bottom: 10px;
            transition: 0.2s;
        }

        .footer-col a:hover {
            color: #10b981;
        }

        .footer-bottom {
            text-align: center;
            padding-top: 30px;
            border-top: 1px solid #1e293b;
            font-size: 12px;
            color: #475569;
            max-width: 1100px;
            margin: 0 auto;
