        .pricing-btn.outline {
            background: #fff;
            color: #374151;
            border: 2px solid #e5e7eb;
        }

        /* ===== CTA ===== */
        .cta {
            padding: 80px 40px;
            text-align: center;
            background: linear-gradient(135deg, #0f172a, #1e293b);
            color: #fff;
        }

        .cta h2 {
            font-size: 36px;
            font-weight: 900;
            margin-bottom: 16px;
            letter-spacing: -1px;
        }

        .cta p {
            font-size: 16px;
            color: #94a3b8;
            margin-bottom: 32px;
        }

        .cta .btn-primary {
            font-size: 16px;
            padding: 16px 40px;
        }

        /* ===== FOOTER ===== */
        .footer {
            background: #0f172a;
            color: #94a3b8;
            padding: 60px 40px 30px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
