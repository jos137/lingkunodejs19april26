            font-size: 13px;
            line-height: 1.7;
            color: #64748b;
        }

        .footer-col h4 {
            font-size: 12px;
            font-weight: 800;
            color: #e2e8f0;
            letter-spacing: 1px;
            margin-bottom: 16px;
        }

        .footer-col a {
