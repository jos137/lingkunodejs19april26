        /* ===== RESPONSIVE ===== */
        @media (max-width: 900px) {
            .hero {
                grid-template-columns: 1fr;
                text-align: center;
                padding: 120px 20px 60px;
            }

            .hero p {
                max-width: 100%;
            }

            .hero-btns {
                justify-content: center;
            }

            .hero-visual {
                margin-top: 40px;
            }

            .phone-mockup {
                transform: none;
            }

            .features-grid {
                grid-template-columns: 1fr;
            }

            .pricing-grid {
                grid-template-columns: 1fr;
            }

            .footer-grid {
                grid-template-columns: 1fr 1fr;
            }

            .hero h1 {
                font-size: 34px;
            }

            .navbar-links a:not(.btn-login):not(.btn-register) {
                display: none;
            }
        }
    </style>
</head>

