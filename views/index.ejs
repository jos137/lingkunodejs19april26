<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lingku.xyz – Satu Link untuk Semua Produk Digital Anda</title>
    <link rel="icon" type="image/x-icon" href="/images/fav.ico">
    <meta name="description"
        content="Platform jualan produk digital secara otomatis dengan fee rendah. Fokuskan kreativitasmu, biar sistem yang urus sisanya.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --ink: #0b1220;
            --muted: #64748b;
            --line: #e8eef5;
            --emerald: #2563eb;
            --emerald-deep: #1d4ed8;
            --gold: #f59e0b;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 84px;
        }

        body {
            font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
            color: var(--ink);
            background: #fff;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* ===== NAVBAR (glass on scroll) ===== */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            padding: 0 40px;
            height: 72px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(16px) saturate(1.4);
            -webkit-backdrop-filter: blur(16px) saturate(1.4);
            border-bottom: 1px solid transparent;
            transition: border-color 0.3s, box-shadow 0.3s, background 0.3s;
        }

        .navbar.scrolled {
            background: rgba(255, 255, 255, 0.85);
            border-bottom-color: var(--line);
            box-shadow: 0 8px 30px rgba(13, 25, 60, 0.06);
        }

        .navbar-links {
            display: flex;
            align-items: center;
            gap: 28px;
        }

        .navbar-links a {
            font-size: 13px;
            font-weight: 600;
            color: var(--muted);
            transition: color 0.2s;
            position: relative;
        }

        .navbar-links a:not(.btn-login):not(.btn-register):hover {
            color: var(--ink);
        }

        .navbar-links a:not(.btn-login):not(.btn-register)::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: -4px;
            width: 0;
            height: 2px;
            border-radius: 2px;
            background: linear-gradient(90deg, #2563eb, #f59e0b);
            transition: width 0.25s ease;
        }

        .navbar-links a:not(.btn-login):not(.btn-register):hover::after {
            width: 100%;
        }

        .navbar-links .btn-login {
            padding: 9px 22px;
            border-radius: 100px;
            border: 1.5px solid #dbe4ee;
            color: var(--ink);
            font-weight: 700;
            transition: 0.25s;
            background: #fff;
        }

        .navbar-links .btn-login:hover {
            border-color: var(--emerald);
            color: var(--emerald-deep);
            transform: translateY(-1px);
        }

        .navbar-links .btn-register {
            padding: 9px 22px;
            border-radius: 100px;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: #fff;
            font-weight: 700;
            box-shadow: 0 6px 18px rgba(37, 99, 235, 0.35);
            transition: 0.25s;
            overflow: hidden;
            position: relative;
        }

        .navbar-links .btn-register:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 26px rgba(37, 99, 235, 0.45);
        }

        /* ===== HERO ===== */
        .hero {
            position: relative;
            padding: 160px 40px 100px;
            overflow: hidden;
            background:
                radial-gradient(900px 480px at 85% -80px, rgba(37, 99, 235, 0.14), transparent 60%),
                radial-gradient(760px 420px at 8% 20%, rgba(59, 130, 246, 0.10), transparent 60%),
                linear-gradient(180deg, #f2f7fe 0%, #ffffff 70%);
        }

        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(15, 23, 42, 0.045) 1px, transparent 1px),
                linear-gradient(90deg, rgba(15, 23, 42, 0.045) 1px, transparent 1px);
            background-size: 44px 44px;
            mask-image: radial-gradient(760px 460px at 50% 0%, #000 30%, transparent 75%);
            -webkit-mask-image: radial-gradient(760px 460px at 50% 0%, #000 30%, transparent 75%);
            pointer-events: none;
        }

        .blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(90px);
            opacity: 0.5;
            pointer-events: none;
            animation: drift 16s ease-in-out infinite alternate;
        }

        .blob.b1 {
            width: 420px;
            height: 420px;
            background: #fde68a;
            top: -140px;
            right: -80px;
            opacity: 0.4;
        }

        .blob.b2 {
            width: 340px;
            height: 340px;
            background: #bfdbfe;
            bottom: -120px;
            left: -100px;
            animation-delay: -6s;
        }

        @keyframes drift {
            from {
                transform: translate(0, 0) scale(1);
            }

            to {
                transform: translate(-50px, 40px) scale(1.12);
            }
        }

        .hero-inner {
            position: relative;
            z-index: 2;
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1.05fr 0.95fr;
            gap: 60px;
            align-items: center;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            background: linear-gradient(135deg, #fbbf24, #f59e0b);
            border: none;
            border-radius: 100px;
            padding: 8px 20px 8px 10px;
            font-size: 12px;
            font-weight: 800;
            color: #451a03;
            margin-bottom: 22px;
            box-shadow: 0 8px 22px rgba(245, 158, 11, 0.45);
        }

        .hero-badge .dot {
            width: 8px;
            height: 8px;
            background: #451a03;
            border-radius: 50%;
            box-shadow: 0 0 0 0 rgba(69, 26, 3, 0.4);
            animation: pulse 2.2s infinite;
        }

        @keyframes pulse {
            0% {
                box-shadow: 0 0 0 0 rgba(69, 26, 3, 0.4);
            }

            70% {
                box-shadow: 0 0 0 9px rgba(69, 26, 3, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(69, 26, 3, 0);
            }
        }

        .hero h1 {
            font-size: clamp(36px, 4.6vw, 58px);
            font-weight: 800;
            line-height: 1.12;
            letter-spacing: -2px;
            color: #0f172a;
            margin-bottom: 20px;
        }

        .hero h1 .grad {
            background: linear-gradient(100deg, #1d4ed8 5%, #2563eb 45%, #d97706 95%);
            background-size: 180% 100%;
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            animation: gradShift 7s ease-in-out infinite alternate;
        }

        @keyframes gradShift {
            from {
                background-position: 0% 0;
            }

            to {
                background-position: 100% 0;
            }
        }

        .hero p {
            font-size: 17px;
            color: #64748b;
            line-height: 1.75;
            margin-bottom: 34px;
            max-width: 480px;
        }

        .hero-btns {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
        }

        .btn-primary {
            padding: 15px 34px;
            border-radius: 100px;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: #fff;
            font-size: 15px;
            font-weight: 800;
            box-shadow: 0 10px 26px rgba(37, 99, 235, 0.4);
            transition: transform 0.25s, box-shadow 0.25s;
            border: none;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }

        .btn-primary::after {
            content: '';
            position: absolute;
            top: 0;
            left: -80%;
            width: 55%;
            height: 100%;
            background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.45), transparent);
            transform: skewX(-20deg);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 34px rgba(37, 99, 235, 0.5);
        }

        .btn-primary:hover::after {
            animation: shine 0.8s ease;
        }

        @keyframes shine {
            to {
                left: 130%;
            }
        }

        .btn-secondary {
            padding: 15px 34px;
            border-radius: 100px;
            background: rgba(255, 255, 255, 0.8);
            color: #0f172a;
            font-size: 15px;
            font-weight: 800;
            border: 1.5px solid #e2e8f0;
            transition: 0.25s;
            cursor: pointer;
            backdrop-filter: blur(6px);
        }

        .btn-secondary:hover {
            border-color: #2563eb;
            color: #1d4ed8;
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(13, 25, 60, 0.08);
        }

        .hero-proof {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-top: 30px;
            font-size: 13px;
            color: #94a3b8;
            font-weight: 600;
        }

        .hero-proof .avatars {
            display: flex;
        }

        .hero-proof .avatars span {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            border: 2.5px solid #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 800;
            color: #fff;
            margin-left: -9px;
            box-shadow: 0 3px 8px rgba(0, 0, 0, 0.12);
        }

        .hero-proof .avatars span:first-child {
            margin-left: 0;
        }

        /* Hero visual — phone + floating cards */
        .hero-visual {
            display: flex;
            justify-content: center;
            position: relative;
            perspective: 1200px;
        }

        .hero-glow {
            position: absolute;
            width: 340px;
            height: 340px;
            background: radial-gradient(circle, rgba(37, 99, 235, 0.35), transparent 65%);
            filter: blur(30px);
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            pointer-events: none;
        }

        .phone-mockup {
            width: 280px;
            background: #0b1220;
            border-radius: 40px;
            padding: 12px;
            box-shadow: 0 40px 90px rgba(13, 25, 60, 0.28), inset 0 0 0 2px rgba(255, 255, 255, 0.08);
            transform: perspective(1000px) rotateY(-9deg) rotateX(2deg);
            transition: transform 0.35s ease;
            position: relative;
            z-index: 2;
        }

        .phone-screen {
            background: linear-gradient(160deg, #2563eb, #1e40af 70%, #1e3a8a);
            border-radius: 30px;
            min-height: 480px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
            color: white;
            text-align: center;
            padding: 42px 20px 30px;
            position: relative;
        }

        .phone-screen::before {
            content: '';
            position: absolute;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.12);
            top: -70px;
            right: -70px;
        }

        .phone-screen .ps-logo {
            margin-bottom: 10px;
            position: relative;
            z-index: 1;
        }

        .phone-screen .ps-tagline {
            font-size: 12px;
            font-weight: 600;
            opacity: 0.85;
            margin-bottom: 28px;
            letter-spacing: 0.4px;
            position: relative;
            z-index: 1;
        }

        .phone-screen .ps-card {
            background: rgba(255, 255, 255, 0.16);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 16px;
            padding: 14px 16px;
            width: 100%;
            text-align: left;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 12px;
            position: relative;
            z-index: 1;
        }

        .phone-screen .ps-ico {
            width: 36px;
            height: 36px;
            border-radius: 11px;
            background: rgba(255, 255, 255, 0.22);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            flex-shrink: 0;
        }

        .phone-screen .ps-card-title {
            font-size: 13px;
            font-weight: 700;
        }

        .phone-screen .ps-card-price {
            font-size: 11px;
            opacity: 0.75;
            margin-top: 3px;
            font-weight: 600;
        }

        .float-card {
            position: absolute;
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(14px);
            border: 1px solid rgba(255, 255, 255, 0.9);
            border-radius: 16px;
            padding: 12px 16px;
            box-shadow: 0 18px 44px rgba(13, 25, 60, 0.18);
            display: flex;
            align-items: center;
            gap: 11px;
            z-index: 3;
            animation: floaty 5s ease-in-out infinite;
        }

        .float-card.fc1 {
            top: 12%;
            left: -8%;
        }

        .float-card.fc2 {
            bottom: 14%;
            right: -9%;
            animation-delay: -2.5s;
        }

        .float-card .fc-ico {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            color: #fff;
            flex-shrink: 0;
        }

        .float-card .fc-t {
            font-size: 10px;
            font-weight: 700;
            color: #94a3b8;
        }

        .float-card .fc-v {
            font-size: 14px;
            font-weight: 800;
            color: #0f172a;
        }

        @keyframes floaty {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-13px);
            }
        }

        /* Payment marquee */
        .pay-strip {
            border-top: 1px solid var(--line);
            border-bottom: 1px solid var(--line);
            background: #fff;
            overflow: hidden;
            padding: 18px 0;
            position: relative;
        }

        .pay-track {
            display: flex;
            gap: 56px;
            width: max-content;
            animation: marquee 26s linear infinite;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: 1.5px;
            color: #94a3b8;
        }

        .pay-track i {
            color: #2563eb;
            margin-right: 9px;
        }

        @keyframes marquee {
            to {
                transform: translateX(-50%);
            }
        }

        /* ===== FEATURES ===== */
        .features {
            padding: 110px 40px;
            background: #f8fafc;
            position: relative;
        }

        .section-center {
            text-align: center;
            max-width: 620px;
            margin: 0 auto 56px;
        }

        .section-eyebrow {
            display: inline-block;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 2px;
            color: #1d4ed8;
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            padding: 6px 16px;
            border-radius: 100px;
            margin-bottom: 16px;
        }

        .section-center h2 {
            font-size: clamp(28px, 3.4vw, 40px);
            font-weight: 800;
            letter-spacing: -1.2px;
            color: #0f172a;
            margin-bottom: 14px;
        }

        .section-center p {
            font-size: 16px;
            color: #64748b;
            line-height: 1.7;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 22px;
            max-width: 1120px;
            margin: 0 auto;
        }

        .feature-card {
            background: #fff;
            border-radius: 20px;
            padding: 34px 30px;
            border: 1px solid #eef3f8;
            transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
            box-shadow: 0 1px 4px rgba(13, 25, 60, 0.04);
            position: relative;
            overflow: hidden;
        }

        .feature-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #2563eb, #f59e0b);
            opacity: 0;
            transition: opacity 0.3s;
        }

        .feature-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 22px 48px rgba(13, 25, 60, 0.10);
            border-color: #d3e5db;
        }

        .feature-card:hover::before {
            opacity: 1;
        }

        .feature-icon {
            width: 54px;
            height: 54px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            margin-bottom: 20px;
            box-shadow: 0 8px 18px rgba(13, 25, 60, 0.08);
        }

        .feature-card h3 {
            font-size: 16px;
            font-weight: 800;
            margin-bottom: 10px;
            color: #0f172a;
        }

        .feature-card p {
            font-size: 14px;
            color: #64748b;
            line-height: 1.7;
        }

        /* ===== PRICING ===== */
        .pricing {
            padding: 110px 40px;
            background:
                radial-gradient(700px 340px at 50% 0%, rgba(37, 99, 235, 0.08), transparent 65%),
                #fff;
        }

        .pricing-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 28px;
            max-width: 820px;
            margin: 0 auto;
            align-items: stretch;
        }

        .pricing-card {
            background: #fff;
            border-radius: 24px;
            padding: 40px 36px;
            border: 1.5px solid #e5e7eb;
            transition: transform 0.3s, box-shadow 0.3s;
            position: relative;
        }

        .pricing-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 24px 50px rgba(13, 25, 60, 0.10);
        }

        .pricing-card.popular {
            background: linear-gradient(165deg, #0f172a 0%, #16295e 60%, #0f1f4d 100%);
            border: 1px solid rgba(37, 99, 235, 0.4);
            color: #fff;
            box-shadow: 0 30px 70px rgba(30, 64, 175, 0.35);
            overflow: hidden;
        }

        .pricing-card.popular::before {
            content: '';
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(37, 99, 235, 0.35), transparent 65%);
            top: -120px;
            right: -100px;
            pointer-events: none;
        }

        .pricing-badge {
            position: absolute;
            top: 22px;
            right: 22px;
            background: linear-gradient(135deg, #fbbf24, #f59e0b);
            color: #451a03;
            font-size: 11px;
            font-weight: 800;
            padding: 5px 15px;
            border-radius: 100px;
            box-shadow: 0 6px 16px rgba(245, 158, 11, 0.4);
        }

        .pricing-plan {
            font-size: 13px;
            font-weight: 800;
            color: #2563eb;
            letter-spacing: 1.5px;
            margin-bottom: 10px;
        }

        .pricing-price {
            font-size: 44px;
            font-weight: 800;
            color: #0f172a;
            margin-bottom: 6px;
            letter-spacing: -1.5px;
        }

        .pricing-price .per {
            font-size: 18px;
            font-weight: 700;
            letter-spacing: -0.3px;
            color: #94a3b8;
        }

        .pricing-card.popular .pricing-price .per {
            color: rgba(255, 255, 255, 0.6);
        }

        .pricing-card.popular .pricing-price {
            color: #fff;
        }

        .pricing-period {
            font-size: 13px;
            color: #94a3b8;
            margin-bottom: 26px;
        }

        .pricing-features {
            list-style: none;
            margin-bottom: 30px;
        }

        .pricing-features li {
            padding: 9px 0;
            font-size: 14px;
            font-weight: 500;
            color: #475569;
            display: flex;
            align-items: center;
            gap: 11px;
            border-bottom: 1px dashed #eef2f7;
        }

        .pricing-features li:last-child {
            border-bottom: none;
        }

        .pricing-features li i {
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: #ecfdf5;
            color: #059669;
            font-size: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .pricing-card.popular .pricing-features li {
            color: #cbd5e1;
            border-bottom-color: rgba(255, 255, 255, 0.1);
        }

        .pricing-btn {
            display: block;
            text-align: center;
            padding: 15px;
            border-radius: 100px;
            font-size: 14px;
            font-weight: 800;
            transition: 0.25s;
            border: none;
            cursor: pointer;
            width: 100%;
        }

        .pricing-btn.primary {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: #fff;
            box-shadow: 0 8px 22px rgba(37, 99, 235, 0.4);
        }

        .pricing-btn.primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(37, 99, 235, 0.5);
        }

        .pricing-btn.outline {
            background: #fff;
            color: #0f172a;
            border: 1.5px solid #e2e8f0;
        }

        .pricing-btn.outline:hover {
            border-color: #2563eb;
            color: #1d4ed8;
            transform: translateY(-2px);
        }

        /* ===== CTA ===== */
        .cta-wrap {
            padding: 0 40px 110px;
            background: #fff;
        }

        .cta {
            max-width: 1120px;
            margin: 0 auto;
            padding: 90px 40px;
            text-align: center;
            background: linear-gradient(140deg, #172e6e 0%, #1e3a8a 45%, #1e40af 100%);
            color: #fff;
            border-radius: 32px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 40px 90px rgba(30, 64, 175, 0.35);
        }

        .cta::before,
        .cta::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            border: 1.5px solid rgba(255, 255, 255, 0.14);
            pointer-events: none;
        }

        .cta::before {
            width: 420px;
            height: 420px;
            top: -200px;
            left: -140px;
        }

        .cta::after {
            width: 520px;
            height: 520px;
            bottom: -300px;
            right: -160px;
        }

