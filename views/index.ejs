            color: #64748b;
            line-height: 1.7;
            margin-bottom: 32px;
            max-width: 480px;
        }

        .hero-btns {
            display: flex;
            gap: 14px;
        }

        .btn-primary {
            padding: 14px 32px;
            border-radius: 12px;
            background: linear-gradient(135deg, #10b981, #059669);
            color: #fff;
            font-size: 15px;
            font-weight: 800;
            box-shadow: 0 6px 20px rgba(16, 185, 129, 0.35);
            transition: 0.2s;
            border: none;
            cursor: pointer;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(16, 185, 129, 0.45);
        }

        .btn-secondary {
