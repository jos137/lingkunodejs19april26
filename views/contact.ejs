<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hubungi Kami - Lingku.xyz</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="icon" type="image/x-icon" href="/images/fav.ico">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; }
        body { background: #f8fafc; color: #1e293b; line-height: 1.7; }
        .header { background: #0f172a; padding: 20px 40px; text-align: center; }
        .header img { height: 32px; width: auto; }
        .container { max-width: 600px; margin: 60px auto; background: #fff; padding: 40px; border-radius: 16px; box-shadow: 0 4px 30px rgba(0,0,0,0.05); text-align: center; }
        .icon-top { width: 64px; height: 64px; background: #ecfdf5; color: #10b981; font-size: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; }
        h1 { font-size: 28px; font-weight: 900; margin-bottom: 10px; color: #0f172a; }
        p.subtitle { font-size: 15px; color: #64748b; margin-bottom: 30px; }
        
        .contact-card { display: flex; align-items: flex-start; gap: 16px; text-align: left; background: #f8fafc; padding: 20px; border-radius: 12px; margin-bottom: 16px; border: 1px solid #e2e8f0; }
        .contact-card i { color: #10b981; font-size: 20px; margin-top: 4px; width: 24px; text-align: center; }
        .contact-info h4 { font-size: 15px; font-weight: 800; color: #0f172a; margin-bottom: 4px; }
        .contact-info p { font-size: 14px; color: #475569; margin: 0; line-height: 1.6; }
        .contact-info a { color: #10b981; font-weight: 600; text-decoration: none; }
        .contact-info a:hover { text-decoration: underline; }
        
        .footer { text-align: center; padding: 30px; color: #94a3b8; font-size: 13px; }
        .back-btn { display: inline-block; margin-bottom: 30px; color: #10b981; font-weight: 700; text-decoration: none; }
        @media (max-width: 768px) {
            .container { margin: 20px; padding: 30px 20px; }
        }
    </style>
</head>
<body>
    <div class="header">
        <a href="/"><img src="/images/logo.png" alt="Lingku"></a>
    </div>
    <div class="container">
        <a href="/" class="back-btn">&larr; Kembali ke Beranda</a>
        <div class="icon-top"><i class="fas fa-headset"></i></div>
        <h1>Hubungi Kami</h1>
        <p class="subtitle">Punya pertanyaan atau butuh bantuan? Tim support Lingku.xyz siap membantu Anda.</p>

        <div class="contact-card">
            <i class="fas fa-envelope"></i>
            <div class="contact-info">
                <h4>Email Support</h4>
                <p><a href="mailto:support@lingku.xyz">support@lingku.xyz</a></p>
            </div>
        </div>

        <div class="contact-card">
            <i class="fab fa-whatsapp"></i>
            <div class="contact-info">
                <h4>Telepon / WhatsApp</h4>
                <p><a href="https://wa.me/6281316083605" target="_blank">0813 1608 3605</a></p>
            </div>
        </div>

        <div class="contact-card">
            <i class="fas fa-map-marker-alt"></i>
            <div class="contact-info">
                <h4>Alamat Kantor</h4>
                <p><strong>Lingku.xyz</strong><br>Jalan Harapan Jaya VIII<br>Jakarta Pusat, 10640</p>
            </div>
        </div>
    </div>
    <div class="footer">&copy; 2026 Lingku.xyz</div>
</body>
</html>
