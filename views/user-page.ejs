<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="icon" type="image/x-icon" href="/images/fav.ico">
    <style>
        :root { --primary: #2271b1; --bg: #f1f5f9; --text-dark: #1e293b; --text-muted: #64748b; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); color: var(--text-dark); margin: 0; padding: 0; display: flex; justify-content: center; min-height: 100vh; }
        .container { 
            width: 100%; max-width: 480px; padding: 30px 25px 60px 25px; 
            display: flex; flex-direction: column; align-items: center; 
            background: #ffffff; box-shadow: 0 0 40px rgba(0,0,0,0.03);
            min-height: 100vh;
            box-sizing: border-box;
        }

        @media (max-width: 500px) {
            body { padding: 12px 12px; }
            .container { 
                border-radius: 24px; 
                min-height: calc(100vh - 24px);
                padding: 25px 20px 50px 20px;
            }
        }
        .profile { 
            width: 100%; background: <%= user.profile_box_color || '#ffffff' %>; 
            padding: 20px;
            display: <%= user.show_header == 0 ? 'none' : 'flex' %>; 
            align-items: center; gap: 20px;
            box-shadow: 0 10px 30px -10px rgba(0,0,0,0.05);
            margin-bottom: 24px; border: 1.5px solid #f1f5f9;
            box-sizing: border-box; text-align: left;
            
            /* Dynamic Shapes */
            <% if (user.header_type === 'box') { %>
                border-radius: 0;
            <% } else if (user.header_type === 'sketch') { %>
                border-radius: 255px 15px 225px 15px/15px 225px 15px 255px;
                border: 2px solid #111827;
                box-shadow: 5px 5px 0px rgba(0,0,0,0.1);
            <% } else { %>
                border-radius: 20px;
            <% } %>
        }
        .avatar { 
            width: 70px; height: 70px; 
            border: 2px solid white; box-shadow: 0 8px 15px rgba(0,0,0,0.08); 
            object-fit: cover; flex-shrink: 0;
            
            /* Dynamic Avatar Shape */
            <% if (user.header_type === 'sketch') { %>
                border-radius: 20px 5px 18px 7px/7px 18px 5px 20px;
                border: 2px solid #111827;
                transform: rotate(-2deg);
            <% } else { %>
                border-radius: 16px;
            <% } %>
        }
        .profile-info { flex: 1; }
        .name { font-size: <%= user.name_font_size || 18 %>px; font-weight: 850; margin: 0; color: <%= user.profile_text_color || '#111827' %>; letter-spacing: -0.3px; }
        .handle { color: var(--primary); font-size: 13px; font-weight: 700; margin-top: 2px; display: block; opacity: 0.8; }
        .bio-text { font-size: <%= user.bio_font_size || 12 %>px; color: <%= user.profile_text_color || '#64748b' %>; margin-top: 6px; line-height: 1.4; opacity: 0.7; }
        .blocks-container { width: 100%; display: flex; flex-direction: column; gap: 16px; }

        /* Block Styles (Sesuai Struktur Baru PHP) */
        .block-text { font-size: 15px; color: #475569; line-height: 1.6; text-align: left; }
        .block-text p { margin-bottom: 10px; }
        
        .block-button { 
            display: block; width: 100%; padding: 16px; background: var(--primary); color: white; border-radius: 30px; text-decoration: none; 
            text-align: center; font-weight: 700; font-size: 15px; box-shadow: 0 6px 15px -3px rgba(34, 113, 177, 0.3); transition: transform 0.2s; 
            box-sizing: border-box;
        }
        .block-button:hover { transform: translateY(-2px); }

        .block-image { width: 100%; border-radius: 12px; box-shadow: 0 10px 20px rgba(0,0,0,0.05); margin-bottom: 10px; }

        .block-product {
            display: flex; align-items: center; gap: 16px; background: white; border-radius: 15px; padding: 16px; 
            border: 1.5px solid #f1f5f9;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02); text-decoration: none; color: inherit; transition: 0.2s;
            width: 100%; box-sizing: border-box;
        }
        .block-product:hover { transform: scale(1.01); border-color: #10b981; }
        .product-thumb { width: 55px; height: 55px; background: #f8fafc; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--primary); font-size: 20px; overflow: hidden; border: 1px solid #f1f5f9; flex-shrink: 0; }
        .product-thumb img { width: 100%; height: 100%; object-fit: cover; }
        .product-info { flex: 1; min-width: 0; }
        .product-name { font-size: 14px; font-weight: 800; margin-bottom: 2px; color: #1e293b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .product-price { font-size: 13px; color: #10b981; font-weight: 800; }

        /* PREVIEW STYLE SPECIFIC */
        .block-product-preview { flex-direction: column; align-items: center; gap: 16px; padding: 20px; }
        .product-header { display: flex; gap: 16px; width: 100%; align-items: center; text-align: left; }
        .product-subtitle { font-size: 11px; color: #64748b; font-weight: 500; line-height: 1.4; margin-top: 4px; }
        .product-btn-full { 
            width: 90%; padding: 14px; background: #10b981; color: white; border-radius: 14px; 
            text-align: center; font-weight: 800; font-size: 14px; margin: 0 auto;
            box-shadow: 0 4px 15px rgba(16, 185, 129, 0.2);
        }
        .product-ready { display: flex; align-items: center; gap: 8px; font-size: 11px; font-weight: 700; color: #374151; margin-bottom: -4px; }
        .ready-icon { width: 18px; height: 18px; background: #10b981; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 9px; }
        .learn-more { width: 100%; text-align: center; font-size: 12px; font-weight: 700; color: #10b981; margin-top: -4px; }

        /* THEMES */
        .theme-dark { background: #0f172a !important; color: #f8fafc !important; }
        .theme-dark .block-product { background: #1e293b !important; border-color: #334155 !important; }
        .theme-dark .product-name { color: #f8fafc !important; }
        .theme-dark .product-ready { color: #cbd5e1 !important; }
        
        .theme-sky { background: #eff6ff !important; color: #1e3a8a !important; }
        .theme-sky .block-product { background: #ffffff !important; border-color: #dbeafe !important; box-shadow: 0 4px 12px rgba(30, 58, 138, 0.05) !important; }
        .theme-sky .product-name { color: #1e3a8a !important; }

        .video-container { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 12px; width: 100%; }
        .video-container iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }

        .watermark { margin-top: 40px; font-size: 12px; color: var(--text-muted); font-weight: 600; opacity: 0.5; }
        .watermark strong { color: var(--primary); }

        /* Floating Watermark for Free Users */
        .fixed-watermark {
            position: fixed; bottom: 15px; left: 50%; transform: translateX(-50%);
            background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);
            padding: 10px 20px; border-radius: 100px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
            display: flex; align-items: center; gap: 10px; z-index: 9999;
            text-decoration: none; border: 1px solid rgba(255,255,255,0.8);
            white-space: nowrap; transition: 0.3s;
        }
        .fixed-watermark:hover { transform: translateX(-50%) translateY(-2px); box-shadow: 0 10px 30px rgba(0,0,0,0.15); }
        .fixed-watermark img { height: 16px; }
        .fixed-watermark span { font-size: 11px; color: #64748b; font-weight: 600; }
        .fixed-watermark strong { color: #2271b1; font-weight: 800; }
    </style>
</head>
<body>
    <div class="container">
        <div class="profile">
            <img src="<%= img(user.profile_photo, 'profiles') %>" class="avatar" alt="Avatar" onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.fullname || 'U') %>&background=2271b1&color=fff'">
            <div class="profile-info">
                <h1 class="name"><%= user.fullname || 'User' %></h1>
                <span class="handle">@<%= user.slug || user.username %></span>
                <% if (user.bio) { %>
                    <div class="bio-text"><%= user.bio %></div>
                <% } %>
            </div>
        </div>

        <div class="blocks-container">
            <% blocks.forEach(block => { %>
                <% if (block.hidden) return; %>
                
                <% if (block.type === 'text') { %>
                    <div class="block-text"><%- block.text %></div>
                
                <% } else if (block.type === 'image' && block.url) { %>
                    <img src="<%= img(block.url, 'builder') %>" class="block-image" alt="Image">
                
                <% } else if (block.type === 'video' && block.url) { %>
                    <% 
                        function getEmbed(url) {
                            const reg = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
                            const match = url.match(reg);
                            return (match && match[2].length === 11) ? `https://www.youtube.com/embed/${match[2]}` : null;
                        }
                        const embedUrl = getEmbed(block.url);
                    %>
                    <% if (embedUrl) { %>
                        <div class="video-container">
                            <iframe src="<%= embedUrl %>" allowfullscreen></iframe>
                        </div>
                    <% } %>
                
                
                <% } else if (block.type === 'divider') { %>
                    <% 
                        let thickness = block.size === 'thick' ? '4px' : (block.size === 'medium' ? '2px' : '1px');
                        let border = `${thickness} ${block.style || 'solid'} #e2e8f0`;
                        let styleAttr = `width:100%; margin:20px 0; border-top:${border};`;
                        if (block.style === 'gradient') {
                            styleAttr = `width:100%; margin:20px 0; height:${thickness}; background:linear-gradient(90deg, transparent, #cbd5e1, transparent); border:none;`;
                        }
                    %>
                    <div style="<%= styleAttr %>"></div>
                <% } else if (block.type === 'button') { %>
                    <% 
                        const colorMap = {
                            red: '#ef4444', yellow: '#eab308', blue: '#3b82f6', 
                            green: '#10b981', purple: '#8b5cf6', pink: '#ec4899',
                            default: '#2271b1'
                        };
                        const bgColor = colorMap[block.color] || colorMap.default;
                    %>
                    <a href="<%= block.link %>" class="block-button" target="_blank" style="background: <%= bgColor %>; box-shadow: 0 6px 15px -3px <%= bgColor %>44;"><%= block.label %></a>
                <% } else if ((block.type === 'product' || block.type === 'affiliate') && block.pid) { %>
                    <% 
                        const prod = products.find(p => p.id == block.pid); 
                        const isAff = block.type === 'affiliate';
                    %>
                    <% if (prod) { %>
                        <div class="<%= prod.theme_style || '' %>">
                        <% if (prod.thumbnail_style === 'button') { %>
                            <!-- STYLE: BUTTON -->
                            <a href="/p/<%= prod.id %><%= isAff ? '?aff=' + user.slug : '' %>" class="block-product" style="padding: 10px 15px;">
                                <div class="product-thumb" style="width: 36px; height: 36px; border-radius: 8px;">
                                    <img src="<%= img(prod.processed_thumb, 'products') %>" alt="P" onerror="this.onerror=null; this.src='/images/placeholder.png'">
                                </div>
                                <div class="product-name" style="flex: 1;"><%= prod.name %></div>
                                <div class="product-price" style="color: #6366f1;">Rp <%= parseFloat(prod.price || 0).toLocaleString('id-ID') %></div>
                                <i class="fas fa-chevron-right" style="color: #cbd5e1; font-size: 10px; margin-left: 5px;"></i>
                            </a>

                        <% } else if (prod.thumbnail_style === 'preview') { %>
                            <!-- STYLE: PREVIEW -->
                            <a href="/p/<%= prod.id %><%= isAff ? '?aff=' + user.slug : '' %>" class="block-product block-product-preview">
                                <div class="product-header">
                                    <div class="product-thumb">
                                        <img src="<%= img(prod.processed_thumb, 'products') %>" alt="P" onerror="this.onerror=null; this.src='/images/placeholder.png'">
                                    </div>
                                    <div class="product-info">
                                        <div class="product-name" style="white-space: normal;"><%= prod.name %></div>
                                        <% if (prod.subtitle) { %>
                                            <div class="product-subtitle"><%= prod.subtitle %></div>
                                        <% } %>
                                        <div class="product-price">Rp <%= parseFloat(prod.price || 0).toLocaleString('id-ID') %></div>
                                    </div>
                                </div>
                                <div class="product-ready">
                                    <div class="ready-icon" style="background: <%= prod.button_color || '#10b981' %>;"><i class="fas fa-arrow-down"></i></div>
                                    Ready To Download
                                </div>
                                <div class="product-btn-full" style="background: <%= prod.button_color || '#10b981' %>; box-shadow: 0 4px 15px <%= (prod.button_color || '#10b981') %>44;"><%= prod.button_text || 'Beli Sekarang' %></div>
                                <div class="learn-more" style="color: <%= prod.button_color || '#10b981' %>;">Learn More</div>
                            </a>

                        <% } else { %>
                            <!-- STYLE: CALLOUT (Default) -->
                            <a href="/p/<%= prod.id %><%= isAff ? '?aff=' + user.slug : '' %>" class="block-product block-product-preview">
                                <div class="product-header">
                                    <div class="product-thumb">
                                        <img src="<%= img(prod.processed_thumb, 'products') %>" alt="P" onerror="this.onerror=null; this.src='/images/placeholder.png'">
                                    </div>
                                    <div class="product-info">
                                        <div class="product-name" style="white-space: normal;"><%= prod.name %></div>
                                        <% if (prod.subtitle) { %>
                                            <div class="product-subtitle"><%= prod.subtitle %></div>
                                        <% } %>
                                        <div class="product-price" style="color: <%= prod.button_color || '#10b981' %>;">Rp <%= parseFloat(prod.price || 0).toLocaleString('id-ID') %></div>
                                    </div>
                                </div>
                                <div class="product-btn-full" style="background: <%= prod.button_color || '#10b981' %>; box-shadow: 0 4px 15px <%= (prod.button_color || '#10b981') %>44;"><%= prod.button_text || 'Beli Sekarang' %></div>
                            </a>
                        <% } %>
                        </div>
                    <% } %>
                <% } %>
            <% }) %>
        </div>

        <!-- Footnote Watermark -->
        <% if (user.plan !== 'pro') { %>
            <div class="watermark">
                Powered by <strong>Lingku.xyz</strong>
            </div>

            <!-- Floating Watermark -->
            <a href="https://lingku.xyz/" class="fixed-watermark">
                <img src="/images/logo.png" alt="Logo">
                <span>Powered by <strong>Lingku.xyz</strong></span>
            </a>
        <% } %>
    </div>

    <% if (locals.recentOrders && recentOrders.length > 0) { %>
        <style>
            .social-proof-notify {
                position: fixed; bottom: 20px; left: 20px; background: white; 
                border-radius: 14px; padding: 12px 18px; display: flex; align-items: center; 
                gap: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.15); 
                z-index: 10000; transform: translateY(120%); opacity: 0; transition: 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                border: 1px solid #f1f5f9; min-width: 250px; max-width: calc(100vw - 40px);
            }
            .social-proof-notify.show { transform: translateY(0); opacity: 1; }
            .sp-icon { width: 40px; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; }
            .sp-content { line-height: 1.3; }
            .sp-user { font-size: 13px; color: #1e293b; font-weight: 700; }
            .sp-text { font-size: 12px; font-weight: 850; margin: 1px 0; text-transform: uppercase; letter-spacing: 0.3px; }
            .sp-product { font-size: 10.5px; color: #94a3b8; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 180px; }
        </style>

        <script>
            const socialOrders = <%- JSON.stringify(recentOrders) %>;
            let orderIdx = 0;
            
            function showSocialProof() {
                if (socialOrders.length === 0) return;
                
                // Remove old notification if exists
                const old = document.querySelector('.social-proof-notify');
                if (old) {
                    old.classList.remove('show');
                    setTimeout(() => old.remove(), 600);
                }

                const o = socialOrders[orderIdx];
                const name = o.customer_name || 'Seseorang';
                const statusText = o.status === 'completed' ? 'sudah membayar' : 'sudah membeli produk';
                const statusColor = o.status === 'completed' ? '#10b981' : '#f59e0b';
                
                const proof = document.createElement('div');
                proof.className = 'social-proof-notify';
                proof.innerHTML = `
                    <div class="sp-icon" style="background: ${statusColor}15; color: ${statusColor};">
                        <i class="fas ${o.status === 'completed' ? 'fa-check-circle' : 'fa-shopping-cart'}"></i>
                    </div>
                    <div class="sp-content">
                        <div class="sp-user">${name}</div>
                        <div class="sp-text" style="color: ${statusColor}">${statusText}</div>
                        <div class="sp-product">${o.product_name}</div>
                    </div>
                `;
                document.body.appendChild(proof);
                
                // Show
                setTimeout(() => proof.classList.add('show'), 100);
                
                // Hide after 6 seconds
                setTimeout(() => {
                    proof.classList.remove('show');
                    setTimeout(() => proof.remove(), 700);
                }, 6000);
                
                orderIdx = (orderIdx + 1) % socialOrders.length;
            }
            
            // Initial delay (5s) then repeat every 30s
            if (socialOrders.length > 0) {
                setTimeout(() => {
                    showSocialProof();
                    setInterval(showSocialProof, 30000);
                }, 5000);
            }
        </script>
    <% } %>
</body>
</html>
