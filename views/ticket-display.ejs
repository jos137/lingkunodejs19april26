<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tiket: <%= ticket.product_name %></title>
    <script src="https://kit.fontawesome.com/9ad4dcd770.js" crossorigin="anonymous"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #f0fdf4; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }
        
        .ticket-card { background: #fff; border-radius: 24px; overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,0.08); max-width: 420px; width: 100%; }
        
        .ticket-header { background: linear-gradient(135deg, #10b981, #059669); padding: 32px 24px; text-align: center; color: #fff; }
        .ticket-header .icon { font-size: 40px; margin-bottom: 8px; }
        .ticket-header h2 { font-size: 20px; font-weight: 800; letter-spacing: -0.3px; }
        .ticket-header p { font-size: 13px; opacity: 0.85; margin-top: 4px; }
        
        .ticket-body { padding: 32px 24px; text-align: center; }
        
        .qr-wrap { background: #fff; display: inline-block; padding: 16px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.04); border: 2px solid #f1f5f9; margin-bottom: 20px; }
        .qr-wrap img { width: 220px; height: 220px; display: block; }
        
        .ticket-code { display: inline-block; background: #f8fafc; border: 2px dashed #e2e8f0; border-radius: 12px; padding: 12px 24px; font-size: 18px; font-weight: 900; color: #1e293b; letter-spacing: 2px; font-family: 'Courier New', monospace; margin-bottom: 20px; }
        
        .ticket-info { background: #f8fafc; border-radius: 16px; padding: 20px; text-align: left; margin-bottom: 16px; }
        .ticket-info .row { display: flex; justify-content: space-between; padding: 8px 0; font-size: 13px; border-bottom: 1px solid #f1f5f9; }
        .ticket-info .row:last-child { border-bottom: none; }
        .ticket-info .label { color: #94a3b8; font-weight: 600; }
        .ticket-info .value { color: #1e293b; font-weight: 700; text-align: right; }
        
        .status-badge { display: inline-flex; align-items: center; gap: 6px; padding: 8px 20px; border-radius: 100px; font-size: 13px; font-weight: 800; }
        .status-active { background: #f0fdf4; color: #059669; }
        .status-used { background: #fef2f2; color: #dc2626; }
        
        .footer-note { font-size: 11px; color: #94a3b8; text-align: center; padding: 20px 24px; border-top: 1px solid #f1f5f9; }
    </style>
</head>
<body>
    <div class="ticket-card">
        <div class="ticket-header">
            <div class="icon"><%= ticket.status === 'used' ? '🚫' : '🎟️' %></div>
            <h2><%= ticket.product_name %></h2>
            <p>dari <%= ticket.seller_name %></p>
        </div>
        <div class="ticket-body">
            <% if (ticket.status === 'used') { %>
                <div style="text-align:center; padding:20px;">
                    <div style="font-size:48px; margin-bottom:12px;">❌</div>
                    <h3 style="color:#dc2626; margin-bottom:8px;">Tiket Sudah Dipakai</h3>
                    <p style="color:#64748b; font-size:13px;">Tiket ini telah discan pada<br><strong><%= new Date(ticket.scanned_at).toLocaleDateString('id-ID', { day:'numeric', month:'long', year:'numeric', hour:'2-digit', minute:'2-digit' }) %></strong></p>
                </div>
            <% } else { %>
                <div class="qr-wrap">
                    <img src="<%= ticket.qr_url %>" alt="QR Code Tiket">
                </div>
                <div class="ticket-code"><%= ticket.code %></div>
                <div style="margin-bottom: 20px;">
                    <span class="status-badge status-active"><i class="fas fa-check-circle"></i> Tiket Aktif</span>
                </div>
            <% } %>
            
            <div class="ticket-info">
                <div class="row">
                    <span class="label">Pemesan</span>
                    <span class="value"><%= ticket.customer_name %></span>
                </div>
                <div class="row">
                    <span class="label">Produk</span>
                    <span class="value"><%= ticket.product_name %></span>
                </div>
                <% if (ticket.event_date) { %>
                <div class="row">
                    <span class="label">Tanggal</span>
                    <span class="value"><%= new Date(ticket.event_date).toLocaleDateString('id-ID', { weekday:'long', day:'numeric', month:'long', year:'numeric' }) %></span>
                </div>
                <% } %>
                <% if (ticket.event_time) { %>
                <div class="row">
                    <span class="label">Jam</span>
                    <span class="value"><%= ticket.event_time %></span>
                </div>
                <% } %>
                <% if (ticket.event_location) { %>
                <div class="row">
                    <span class="label">Lokasi</span>
                    <span class="value"><%= ticket.event_location %></span>
                </div>
                <% } %>
                <div class="row">
                    <span class="label">Penyelenggara</span>
                    <span class="value"><%= ticket.seller_name %></span>
                </div>
                <div class="row">
                    <span class="label">Dibuat</span>
                    <span class="value"><%= new Date(ticket.created_at).toLocaleDateString('id-ID', { day:'numeric', month:'long', year:'numeric' }) %></span>
                </div>
            </div>
        </div>
        <div class="footer-note">
            <% if (ticket.status === 'active') { %>
                Tunjukkan QR ini ke petugas saat hadir di acara
            <% } else { %>
                Lingku.xyz — Tiket Online
            <% } %>
        </div>
    </div>
</body>
</html>
